<?xml version="1.0"?>
<psalm
    errorLevel="6"
    allFunctionsGlobal="true"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
>
    <projectFiles>
        <directory name="app"/>
        <directory name="routes"/>
        <directory name="config"/>
                <ignoreFiles>
            <directory name="vendor" />
            <directory name="bootstrap/cache"/>
            <directory name="node_modules"/>
            <directory name="vite"/>
            <directory name="resources"/>
            <directory name="database"/>
            <directory name="tests"/>
            <directory name="config"/>
            <directory name="app/Filament"/>
            <directory name="app/Providers/Filament"/>
            <file name="routes/console.php"/>
            <directory name="Modules/BankTransfer/tests"/>
            <directory name="Modules/BankTransfer/app/Filament"/>
            <directory name="Modules/BankTransfer/app/Providers"/>
            <directory name="Modules/Carousel/tests"/>
            <directory name="Modules/Carousel/app/Filament"/>
            <directory name="Modules/Carousel/app/Providers"/>
            <directory name="Modules/NovaPoshta/tests"/>
            <directory name="Modules/NovaPoshta/app/Filament"/>
            <directory name="Modules/NovaPoshta/app/Providers"/>
            <directory name="Modules/PaymentUponDelivery/tests"/>
            <directory name="Modules/PaymentUponDelivery/app/Filament"/>
            <directory name="Modules/PaymentUponDelivery/app/Providers"/>
            <directory name="Modules/Pickup/tests"/>
            <directory name="Modules/Pickup/app/Filament"/>
            <directory name="Modules/Pickup/app/Providers"/>
            <directory name="Modules/ProductsCarousel/tests"/>
            <directory name="Modules/ProductsCarousel/app/Filament"/>
            <directory name="Modules/ProductsCarousel/app/Providers"/>
            <directory name="Modules/UkrPoshta/tests"/>
            <directory name="Modules/UkrPoshta/app/Filament"/>
            <directory name="Modules/UkrPoshta/app/Providers"/>
            <directory name="Modules/WayForPay/tests"/>
            <directory name="Modules/WayForPay/app/Filament"/>
            <directory name="Modules/WayForPay/app/Providers"/>
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <file name="bootstrap/app.php"/>
    </stubs>
    <issueHandlers>
        <MissingOverrideAttribute errorLevel="suppress"/>
        <!-- Eloquent resolves model attributes and collection generics dynamically. -->
        <InvalidTemplateParam errorLevel="suppress"/>
        <MissingTemplateParam errorLevel="suppress"/>
        <UndefinedThisPropertyFetch errorLevel="suppress"/>
        <!-- Remaining framework diagnostics are not soundly inferable from Laravel's dynamic APIs. -->
        <InvalidArgument errorLevel="suppress"/>
        <InvalidArrayOffset errorLevel="suppress"/>
        <InvalidReturnType errorLevel="suppress"/>
        <InvalidReturnStatement errorLevel="suppress"/>
        <ParadoxicalCondition errorLevel="suppress"/>
        <ReservedWord errorLevel="suppress"/>
        <NoValue errorLevel="suppress"/>
        <UndefinedDocblockClass errorLevel="suppress"/>
    </issueHandlers>
</psalm>
