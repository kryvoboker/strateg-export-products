APP_ENV=testing
APP_NAME="Baboon move products (${APP_ENV})"
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost
APP_CONFIG_CACHE=/tmp/strateg-export-products-config-testing.php

APP_TIMEZONE="Europe/Kyiv"
APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK="daily"
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_PREFIX=spme_

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
CACHE_STORE=array
MAIL_MAILER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

AI_TRANSLATION_ENABLED=false
PRODUCT_BACKUPS_MAX_PER_SCOPE=15
LIVE_OPENCART_EXPORT_TEST=false
ALLOWED_OPENCART_PROJECTS_TYPES="opencart 3, opencart 4"
