ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT COALESCE(json_agg(json_build_object('\\''id'\\'',c.id,'\\''hash'\\'',c.content_hash,'\\''content'\\'',c.content) ORDER BY c.id),'\\''[]'\\''::json) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' AND e.source_content_hash=c.content_hash WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL;\"' > /tmp/aic_missing_embeddings.json && /home/kamaz/.venv/bin/python -c 'import json; d=json.load(open(\"/tmp/aic_missing_embeddings.json\")); print(len(d), sum(len(x[\"content\"]) for x in d))'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT COALESCE(json_agg(json_build_object('\\''id'\\'',c.id,'\\''hash'\\'',c.content_hash,'\\''content'\\'',c.content) ORDER BY c.sequence_number),'\\''[]'\\''::json) FROM aic_chunks c JOIN aic_documents d ON d.project_id=c.project_id AND d.id=c.document_id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' AND e.source_content_hash=c.content_hash WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND d.path='\\''docs/ai-code-intelligence.md'\\'' AND e.id IS NULL;\"' > /tmp/aic_doc_missing.json && /home/kamaz/.venv/bin/python -c 'import json; print(len(json.load(open(\"/tmp/aic_doc_missing.json\"))))'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' AND e.source_content_hash=c.content_hash WHERE c.project