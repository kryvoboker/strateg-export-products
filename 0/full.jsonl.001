' GROUP BY s.kind ORDER BY s.kind;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.size_bytes, f.indexed_at, COUNT(c.id) AS chunks, COUNT(e.id) AS embeddings FROM aic_projects p JOIN aic_files f ON f.project_id=p.id LEFT JOIN aic_chunks c ON c.project_id=p.id AND c.file_id=f.id AND c.source_type='\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id=p.id AND e.chunk_id=c.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''\\.docker/dev/docker-compose.yml'\\'','\\''\\.docker/dev/nginx/nginx.conf'\\'') GROUP BY f.path,f.content_hash,f.size_bytes,f.indexed_at ORDER BY f.path;\" -c \"SELECT s.kind, COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT d.path, d.title FROM aic_projects p JOIN aic_documents d ON d.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' ORDER BY d.path;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_7f2841b6c020_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.size_bytes, f.indexed_at, c.id AS chunk_id, c.sequence_number, c.start_line, c.end_line, c.content_hash AS chunk_hash, length(c.content) AS chars, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.chunk_id=c.id) AS vector_count FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_chunks c ON c.project_id=p.id AND c.file_id=f.id AND c.source_type='\\''code'\\'' WHERE p.slug='\\''office-easyfit'\\'' AND f.path LIKE '\\''\\.docker/dev/%'\\'' ORDER BY f.path,c.sequence_number;\" -c \"SELECT COUNT(*) AS pote