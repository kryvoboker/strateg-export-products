{"timestamp":"2026-10-07T07:57:01.732Z","ordinal":10815,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1155d-a7a4-7062-879b-37c923b2ee2e","call_id":"call_55988f2731c640c49eb8179c66ada038","output":[{"type":"input_text","text":"Script completed\nWall time 0.6 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 10030)\nTotal output lines: 715\n\nWarning: truncated output (original token count: 619834)\n... 1430758 bytes omitted ...\n\nFailed to create stream fd: Operation not permitted\nFailed to create stream fd: Operation not permitted\nFailed to create stream fd: Operation not permitted\nBEGIN;\n\nCREATE TABLE aic_projects (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    name TEXT NOT NULL,\n    slug TEXT NOT NULL,\n    root_path TEXT NOT NULL,\n    repository_url TEXT,\n    default_branch TEXT NOT NULL DEFAULT 'main',\n    active BOOLEAN NOT NULL DEFAULT TRUE,\n    metadata JSONB NOT NULL DEFAULT '{}'::jsonb,\n    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n\n    CONSTRAINT projects_slug_not_blank CHECK (BTRIM(slug) <> ''),\n    CONSTRAINT projects_name_not_blank CHECK (BTRIM(name) <> ''),\n    CONSTRAINT projects_root_path_not_blank CHECK (BTRIM(root_path) <> ''),\n    CONSTRAINT projects_slug_unique UNIQUE (slug)\n);\n\nCREATE TABLE aic_files (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    project_id UUID NOT NULL REFERENCES aic_projects(id) ON DELETE CASCADE,\n    path TEXT NOT NULL,\n    language TEXT,\n    file_type TEXT NOT NULL DEFAULT 'code',\n    content_hash CHAR(64),\n    size_bytes BIGINT,\n    git_blob_sha TEXT,\n    last_indexed_commit TEXT,\n    is_generated BOOLEAN NOT NULL DEFAULT FALSE,\n    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,\n    metadata JSONB NOT NULL DEFAULT '{}'::jsonb,\n    indexed_at TIMESTAMPTZ,\n    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n\n    CONSTRAINT files_path_not_blank CHECK (BTRIM(path) <> ''),\n    CONSTRAINT files_size_non_negative CHECK (size_bytes IS NULL OR size_bytes >= 0),\n    CONSTRAINT files_type_valid CHECK (\n        file_type IN ('code', 'template', 'config', 'data', 'migration', 'test', 'generated', 'other')\n    ),\n    CONSTRAINT files_project_path_unique UNIQUE (project_id, path),\n    CONSTRAINT files_project_id_id_unique UNIQUE (project_id, id)\n);\n\nCREATE TABLE aic_symbols (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    project_id UUID NOT NULL,\n    file_id UUID NOT NULL,\n    parent_symbol_id UUID,\n    kind TEXT NOT NULL,\n    name TEXT NOT NULL,\n    qualified_name TEXT,\n    signature TEXT,\n    visibility TEXT,\n    start_line INTEGER NOT NULL,\n    start_column INTEGER NOT NULL DEFAULT 0,\n    end_line INTEGER NOT NULL,\n    end_column INTEGER NOT NULL DEFAULT 0,\n    is_exported BOOLEAN,\n    is_deprecated BOOLEAN NOT NULL DEFAULT FALSE,\n    content_hash CHAR(64),\n    metadata JSONB NOT NULL DEFAULT '{}'::jsonb,\n    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n\n    CONSTRAINT symbols_project_fk\n        FOREIGN KEY (project_id)\n        REFERENCES aic_projects(id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT symbols_file_project_fk\n        FOREIGN KEY (project_id, file_id)\n        REFERENCES aic_files(project_id, id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT symbols_parent_project_fk\n        FOREIGN KEY (project_id, parent_symbol_id)\n        REFERENCES aic_symbols(project_id, id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT symbols_name_not_blank CHECK (BTRIM(name) <> ''),\n    CONSTRAINT symbols_kind_not_blank CHECK (BTRIM(kind) <> ''),\n    CONSTRAINT symbols_line_range_valid CHECK (\n        start_line >= 1\n        AND end_line >= start_line\n        AND start_column >= 0\n        AND end_column >= 0\n    ),\n    CONSTRAINT symbols_file_location_unique UNIQUE (\n        file_id, kind, start_line, start_column\n    ),\n    CONSTRAINT symbols_project_id_id_unique UNIQUE (project_id, id),\n    CONSTRAINT symbols_project_file_id_id_unique UNIQUE (project_id, file_id, id)\n);\n\nCREATE TABLE aic_symbol_relations (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    project_id UUID NOT NULL,\n    source_symbol_id UUID NOT NULL,\n    target_symbol_id UUID,\n    target_qualified_name TEXT,\n    relation_type TEXT NOT NULL,\n    source_line INTEGER,\n    confidence REAL NOT NULL DEFAULT 1.0,\n    evidence JSONB NOT NULL DEFAULT '{}'::jsonb,\n    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n\n    CONSTRAINT symbol_relations_project_fk\n        FOREIGN KEY (project_id)\n        REFERENCES aic_projects(id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT symbol_relations_source_project_fk\n        FOREIGN KEY (project_id, source_symbol_id)\n        REFERENCES aic_symbols(project_id, id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT symbol_relations_target_project_fk\n        FOREIGN KEY (project_id, target_symbol_id)\n        REFERENCES aic_symbols(project_id, id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT symbol_relations_target_present CHECK (\n        target_symbol_id IS NOT NULL\n        OR COALESCE(BTRIM(target_qualified_name), '') <> ''\n    ),\n    CONSTRAINT symbol_relations_type_not_blank CHECK (BTRIM(relation_type) <> ''),\n    CONSTRAINT symbol_relations_confidence_valid CHECK (\n        confidence >= 0.0 AND confidence <= 1.0\n    ),\n    CONSTRAINT symbol_relations_source_line_valid CHECK (\n        source_line IS NULL OR source_line >= 1\n    )\n);\n\nCREATE TABLE aic_documents (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    project_id UUID NOT NULL REFERENCES aic_projects(id) ON DELETE CASCADE,\n    document_type TEXT NOT NULL DEFAULT 'documentation',\n    title TEXT NOT NULL,\n    path TEXT,\n    source_uri TEXT,\n    content_hash CHAR(64),\n    metadata JSONB NOT NULL DEFAULT '{}'::jsonb,\n    indexed_at TIMESTAMPTZ,\n    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n\n    CONSTRAINT documents_title_not_blank CHECK (BTRIM(title) <> ''),\n    CONSTRAINT documents_type_not_blank CHECK (BTRIM(document_type) <> ''),\n    CONSTRAINT documents_source_present CHECK (\n        COALESCE(BTRIM(path), '') <> ''\n        OR COALESCE(BTRIM(source_uri), '') <> ''\n    ),\n    CONSTRAINT documents_project_id_id_unique UNIQUE (project_id, id)\n);\n\nCREATE TABLE aic_knowledge_items (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    project_id UUID NOT NULL REFERENCES aic_projects(id) ON DELETE CASCADE,\n    kind TEXT NOT NULL,\n    title TEXT NOT NULL,\n    content TEXT NOT NULL,\n    source_reference TEXT,\n    status TEXT NOT NULL DEFAULT 'active',\n    confidence REAL NOT NULL DEFAULT 1.0,\n    valid_from TIMESTAMPTZ,\n    valid_until TIMESTAMPTZ,\n    metadata JSONB NOT NULL DEFAULT '{}'::jsonb,\n    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n\n    CONSTRAINT knowledge_items_kind_not_blank CHECK (BTRIM(kind) <> ''),\n    CONSTRAINT knowledge_items_title_not_blank CHECK (BTRIM(title) <> ''),\n    CONSTRAINT knowledge_items_content_not_blank CHECK (BTRIM(content) <> ''),\n    CONSTRAINT knowledge_items_status_valid CHECK (\n        status IN ('draft', 'active', 'superseded', 'archived')\n    ),\n    CONSTRAINT knowledge_items_confidence_valid CHECK (\n        confidence >= 0.0 AND confidence <= 1.0\n    ),\n    CONSTRAINT knowledge_items_validity_valid CHECK (\n        valid_until IS NULL OR valid_from IS NULL OR valid_until > valid_from\n    ),\n    CONSTRAINT knowledge_items_project_id_id_unique UNIQUE (project_id, id)\n);\n\nCREATE TABLE aic_chunks (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    project_id UUID NOT NULL,\n    source_type TEXT NOT NULL,\n    file_id UUID,\n    symbol_id UUID,\n    document_id UUID,\n    knowledge_item_id UUID,\n    chunk_type TEXT NOT NULL,\n    sequence_number INTEGER NOT NULL DEFAULT 0,\n    start_line INTEGER,\n    end_line INTEGER,\n    content TEXT NOT NULL,\n    content_hash CHAR(64) NOT NULL,\n    token_count INTEGER,\n    metadata JSONB NOT NULL DEFAULT '{}'::jsonb,\n    search_vector TSVECTOR GENERATED ALWAYS AS (\n        to_tsvector('simple', COALESCE(content, ''))\n    ) STORED,\n    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n\n    CONSTRAINT chunks_project_fk\n        FOREIGN KEY (project_id)\n        REFERENCES aic_projects(id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT chunks_file_project_fk\n        FOREIGN KEY (project_id, file_id)\n        REFERENCES aic_files(project_id, id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT chunks_symbol_file_project_fk\n        FOREIGN KEY (project_id, file_id, symbol_id)\n        REFERENCES aic_symbols(project_id, file_id, id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT chunks_document_project_fk\n        FOREIGN KEY (project_id, document_id)\n        REFERENCES aic_documents(project_id, id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT chunks_knowledge_project_fk\n        FOREIGN KEY (project_id, knowledge_item_id)\n        REFERENCES aic_knowledge_items(project_id, id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT chunks_source_type_valid CHECK (\n        source_type IN ('code', 'document', 'knowledge')\n    ),\n    CONSTRAINT chunks_source_reference_valid CHECK (\n        (\n            source_type = 'code'\n            AND file_id IS NOT NULL\n            AND document_id IS NULL\n            AND knowledge_item_id IS NULL\n        )\n        OR\n        (\n            source_type = 'document'\n            AND file_id IS NULL\n            AND symbol_id IS NULL\n            AND document_id IS NOT NULL\n            AND knowledge_item_id IS NULL\n        )\n        OR\n        (\n            source_type = 'knowledge'\n            AND file_id IS NULL\n            AND symbol_id IS NULL\n            AND document_id IS NULL\n            AND knowledge_item_id IS NOT NULL\n        )\n    ),\n    CONSTRAINT chunks_symbol_requires_file CHECK (\n        symbol_id IS NULL OR file_id IS NOT NULL\n    ),\n    CONSTRAINT chunks_sequence_non_negative CHECK (sequence_number >= 0),\n    CONSTRAINT chunks_token_count_non_negative CHECK (\n        token_count IS NULL OR token_count >= 0\n    ),\n    CONSTRAINT chunks_line_range_valid CHECK (\n        (start_line IS NULL AND end_line IS NULL)\n        OR (\n            start_line IS NOT NULL\n            AND end_line IS NOT NULL\n            AND start_line >= 1\n            AND end_line >= start_line\n        )\n    ),\n    CONSTRAINT chunks_content_not_blank CHECK (BTRIM(content) <> ''),\n    CONSTRAINT chunks_project_id_id_unique UNIQUE (project_id, id),\n    CONSTRAINT chunks_source_sequence_unique UNIQUE NULLS NOT DISTINCT (\n        project_id,\n        source_type,\n        file_id,\n        document_id,\n        knowledge_item_id,\n        chunk_type,\n        sequence_number\n    )\n);\n\nCREATE TABLE aic_embedding_models (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    provider TEXT NOT NULL,\n    model TEXT NOT NULL,\n    dimensions INTEGER NOT NULL,\n    distance_metric TEXT NOT NULL DEFAULT 'cosine',\n    enabled BOOLEAN NOT NULL DEFAULT TRUE,\n    metadata JSONB NOT NULL DEFAULT '{}'::jsonb,\n    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n\n    CONSTRAINT embedding_models_provider_not_blank CHECK (BTRIM(provider) <> ''),\n    CONSTRAINT embedding_models_model_not_blank CHECK (BTRIM(model) <> ''),\n    CONSTRAINT embedding_models_dimensions_valid CHECK (\n        dimensions > 0 AND dimensions <= 16000\n    ),\n    CONSTRAINT embedding_models_distance_metric_valid CHECK (\n        distance_metric IN ('cosine', 'l2', 'inner_product')\n    ),\n    CONSTRAINT embedding_models_provider_model_unique UNIQUE (provider, model)\n);\n\nCREATE TABLE aic_embeddings (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    project_id UUID NOT NULL,\n    chunk_id UUID NOT NULL,\n    embedding_model_id UUID NOT NULL REFERENCES aic_embedding_models(id) ON DELETE RESTRICT,\n    dimensions INTEGER NOT NULL,\n    embedding VECTOR NOT NULL,\n    source_content_hash CHAR(64) NOT NULL,\n    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n\n    CONSTRAINT embeddings_project_fk\n        FOREIGN KEY (project_id)\n        REFERENCES aic_projects(id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT embeddings_chunk_project_fk\n        FOREIGN KEY (project_id, chunk_id)\n        REFERENCES aic_chunks(project_id, id)\n        ON DELETE CASCADE,\n\n    CONSTRAINT embeddings_dimensions_valid CHECK (\n        dimensions > 0\n        AND dimensions <= 16000\n        AND vector_dims(embedding) = dimensions\n    ),\n    CONSTRAINT embeddings_chunk_model_unique UNIQUE (\n        chunk_id, embedding_model_id\n    )\n);\n\nCREATE TABLE aic_indexing_runs (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    project_id UUID NOT NULL REFERENCES aic_projects(id) ON DELETE CASCADE,\n    run_type TEXT NOT NULL,\n    status TEXT NOT NULL DEFAULT 'running',\n    git_commit TEXT,\n    started_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n    finished_at TIMESTAMPTZ,\n    stats JSONB NOT NULL DEFAULT '{}'::jsonb,\n    error_message TEXT,\n    metadata JSONB NOT NULL DEFAULT '{}'::jsonb,\n\n    CONSTRAINT indexing_runs_type_valid CHECK (\n        run_type IN (\n            'full',\n            'incremental',\n            'structure',\n            'documents',\n            'knowledge',\n            'embeddings',\n            'repair'\n        )\n    ),\n    CONSTRAINT indexing_runs_status_valid CHECK (\n        status IN ('running', 'completed', 'failed', 'cancelled')\n    ),\n    CONSTRAINT indexing_runs_time_valid CHECK (\n        finished_at IS NULL OR finished_at >= started_at\n    )\n);\n\nCREATE OR REPLACE FUNCTION set_updated_at()\nRETURNS TRIGGER\nLANGUAGE plpgsql\nAS $$\nBEGIN\n    NEW.updated_at = NOW();\n    RETURN NEW;\nEND;\n$$;\n\nCREATE TRIGGER projects_set_updated_at\nBEFORE UPDATE ON aic_projects\nFOR EACH ROW\nEXECUTE FUNCTION set_updated_at();\nBEGIN;\n\nCREATE OR REPLACE FUNCTION aic_create_project_embedding_hnsw_index(\n    p_project_id UUID,\n    p_embedding_model_id UUID,\n    p_m INTEGER DEFAULT 16,\n    p_ef_construction INTEGER DEFAULT 64\n)\nRETURNS TEXT\nLANGUAGE plpgsql\nAS $$\nDECLARE\n    v_dimensions INTEGER;\n    v_distance_metric TEXT;\n    v_operator_class TEXT;\n    v_cast_type TEXT;\n    v_index_name TEXT;\nBEGIN\n    IF NOT EXISTS (\n        SELECT 1\n        FROM aic_projects\n        WHERE id = p_project_id\n          AND active = TRUE\n    ) THEN\n        RAISE EXCEPTION 'Active project % was not found', p_project_id;\n    END IF;\n\n    SELECT dimensions, distance_metric\n    INTO v_dimensions, v_distance_metric\n    FROM aic_embedding_models\n    WHERE id = p_embedding_model_id\n      AND enabled = TRUE;\n\n    IF NOT FOUND THEN\n        RAISE EXCEPTION 'Enabled embedding model % was not found', p_embedding_model_id;\n    END IF;\n\n    IF p_m < 2 OR p_m > 100 THEN\n        RAISE EXCEPTION 'p_m must be between 2 and 100';\n    END IF;\n\n    IF p_ef_construction < 4 OR p_ef_construction > 1000 THEN\n        RAISE EXCEPTION 'p_ef_construction must be between 4 and 1000';\n    END IF;\n\n    IF v_dimensions <= 2000 THEN\n        v_cast_type := format('vector(%s)', v_dimensions);\n\n        v_operator_class := CASE v_distance_metric\n            WHEN 'cosine' THEN 'vector_cosine_ops'\n            WHEN 'l2' THEN 'vector_l2_ops'\n            WHEN 'inner_product' THEN 'vector_ip_ops'\n        END;\n    ELSIF v_dimensions <= 4000 THEN\n        v_cast_type := format('halfvec(%s)', v_dimensions);\n\n        v_operator_class := CASE v_distance_metric\n            WHEN 'cosine' THEN 'halfvec_cosine_ops'\n            WHEN 'l2' THEN 'halfvec_l2_ops'\n            WHEN 'inner_product' THEN 'halfvec_ip_ops'\n        END;\n    ELSE\n        RAISE EXCEPTION\n            'HNSW helper supports up to 4000 dimensions. Model has % dimensions.',\n            v_dimensions;\n    END IF;\n\n    v_index_name :=\n        'aic_emb_hnsw_p_' ||\n        REPLACE(LEFT(p_project_id::TEXT, 13), '-', '') ||\n        '_m_' ||\n        REPLACE(LEFT(p_embedding_model_id::TEXT, 13), '-', '');\n\n    EXECUTE format(\n        'CREATE INDEX IF NOT EXISTS %I\n         ON aic_embeddings\n         USING hnsw ((embedding::%s) %s)\n         WITH (m = %s, ef_construction = %s)\n         WHERE project_id = %L::uuid\n           AND embedding_model_id = %L::uuid',\n        v_index_name,\n        v_cast_type,\n        v_operator_class,\n        p_m,\n        p_ef_construction,\n        p_project_id::TEXT,\n        p_embedding_model_id::TEXT\n    );\n\n    RETURN v_index_name;\nEND;\n$$;\n\nCREATE OR REPLACE FUNCTION aic_drop_project_embedding_hnsw_index(\n    p_project_id UUID,\n    p_embedding_model_id UUID\n)\nRETURNS VOID\nLANGUAGE plpgsql\nAS $$\nDECLARE\n    v_index_name TEXT;\nBEGIN\n    v_index_name :=\n        'aic_emb_hnsw_p_' ||\n        REPLACE(LEFT(p_project_id::TEXT, 13), '-', '') ||\n        '_m_' ||\n        REPLACE(LEFT(p_embedding_model_id::TEXT, 13), '-', '');\n\n    EXECUTE format('DROP INDEX IF EXISTS %I', v_index_name);\nEND;\n$$;\n\nCREATE OR REPLACE FUNCTION aic_search_chunks_vector_hnsw(\n    p_project_id UUID,\n    p_embedding_model_id UUID,\n    p_query_embedding VECTOR,\n    p_limit INTEGER DEFAULT 20\n)\nRETURNS TABLE (\n    chunk_id UUID,\n    source_type TEXT,\n    source_reference TEXT,\n    title TEXT,\n    distance DOUBLE PRECISION,\n    content TEXT\n)\nLANGUAGE plpgsql\nSTABLE\nAS $$\nDECLARE\n    v_dimensions INTEGER;\n    v_distance_metric TEXT;\n    v_operator TEXT;\n    v_cast_type TEXT;\n    v_limit INTEGER;\nBEGIN\n    SELECT dimensions, distance_metric\n    INTO v_dimensions, v_distance_metric\n    FROM aic_embedding_models\n    WHERE id = p_embedding_model_id\n      AND enabled = TRUE;\n\n    IF NOT FOUND THEN\n        RAISE EXCEPTION 'Enabled embedding model % was not found', p_embedding_model_id;\n    END IF;\n\n    IF vector_dims(p_query_embedding) <> v_dimensions THEN\n        RAISE EXCEPTION\n            'Query vector has % dimensions, model requires %',\n            vector_dims(p_query_embedding),\n            v_dimensions;\n    END IF;\n\n    IF v_dimensions <= 2000 THEN\n        v_cast_type := format('vector(%s)', v_dimensions);\n    ELSIF v_dimensions <= 4000 THEN\n        v_cast_type := format('halfvec(%s)', v_dimensions);\n    ELSE\n        RAISE EXCEPTION\n            'HNSW helper supports up to 4000 dimensions. Model has % dimensions.',\n            v_dimensions;\n    END IF;\n\n    v_operator := CASE v_distance_metric\n        WHEN 'cosine' THEN '<=>'\n        WHEN 'l2' THEN '<->'\n        WHEN 'inner_product' THEN '<#>'\n    END;\n\n    v_limit := GREATEST(1, LEAST(p_limit, 200));\n\n    -- Dynamic SQL embeds project/model UUID literals so PostgreSQL can prove\n    -- the query predicate matches the partial HNSW index predicate at plan time.\n    RETURN QUERY EXECUTE format(\n        'SELECT\n            v.chunk_id,\n            v.source_type,\n            v.source_reference,\n            v.title,\n            ((e.embedding::%s) %s ($1::%s))::double precision AS distance,\n            v.content\n         FROM aic_embeddings e\n         JOIN v_retrieval_chunks v\n           ON v.project_id = e.project_id\n          AND v.chunk_id = e.chunk_id\n         WHERE e.project_id = %L::uuid\n           AND e.embedding_model_id = %L::uuid\n         ORDER BY (e.embedding::%s) %s ($1::%s)\n         LIMIT $2',\n        v_cast_type,\n        v_operator,\n        v_cast_type,\n        p_project_id::TEXT,\n        p_embedding_model_id::TEXT,\n        v_cast_type,\n        v_operator,\n        v_cast_type\n    )\n    USING p_query_embedding, v_limit;\nimport { OpenAiEmbeddingProvider } from './providers/open-ai.js';\n\nconst args = process.argv.slice(2);\n\nconst apiKey = REDACTED;\nconst pathToEmbedFile = args[1];\nconst model = args[2];\nconst texts = args.slice(3);\n\nif (!apiKey || !pathToEmbedFile || !model || texts.length === 0) {\n    console.error(\n        'Usage: node /app/embedding.js <api-key> <embedding-project-name.json> <model> <text> [text...]',\n    );\n\n    process.exit(1);\n}\n\nconst embeddingProvider = new OpenAiEmbeddingProvider(\n    apiKey,\n    model,\n);\n\ntry {\n    const embeddings = await embeddingProvider.createBatch(texts);\n\n    embeddingProvider.saveEmbedding(pathToEmbedFile, embeddings);\n\n    console.log('See the file' + pathToEmbedFile);\n} catch (error) {\n    console.error(error instanceof Error ? error.message : error);\n\n    process.exit(1);\n}app/embedding-results/office-easyfit/office-easyfit-order-index-inprogress-manager-20261003-manifest.json:15:    \"content_hash\": \"73fd62000a2bfc833eed075e652f1c1d112ca9dfadaddb…30 tokens truncated…hashes\":[\"6a95623fb8abc3e1911aa63d9e06a966cb02a25c258033ca1260b3c9f67be923\",\"db825e3526983bd1c6bc78911ed8564cd8699def5afeebec24aa4a8f91043a26\",\"84e2aee268b17b617de5ac851474d735fd5a5b10a221503da1699c91d6e2cd97\",\"b8921259937297913bfda737c44387def67b5cd1f9788981a4ce69035673c13a\",\"68da3145af98c8e6685eb8194666ad28f267335b89bf21db6c2abcfef554866f\",\"afbe367f71634009c6b7411cd05e8bdbe26f6a4c4915dedee27f37246a2132c1\",\"e5c163e67dc253adc8524d50055f245c0ac688cead9d2b5d319abd95a9cd9d15\",\"6624896485457f98c9c33210efbba2983c47cb7d254a6507ca6d4e1951f276e0\",\"1f0444d686416e00cda3f186a66f62a0c0f58a1cb30b061667d69d3e85e4ee86\",\"dcff1b81a5045fc0c6356ba982be262211cd50a1096eabb3227e729a64dbd456\",\"05e873f52fe45bbf5b520c04f525fbc68948127578449e3d7075c68212f4ce8a\",\"5cc1bedb39ef12ba5ebe2438faad4d721ed2a9421198d9485a36d49c8426b40e\",\"1eced2ae1108e6acd8c10b1a12197c74632680a21d1019e5a86894c9aad084b9\",\"9f663f6ffe4