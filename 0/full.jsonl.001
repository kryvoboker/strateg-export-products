xport\\'', 8)\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"BEGIN; DELETE FROM aic_embeddings WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND chunk_id='\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid RETURNING id; DELETE FROM aic_chunks WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid RETURNING id; DELETE FROM aic_knowledge_items WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid RETURNING id; DELETE FROM aic_indexing_runs WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\''::uuid RETURNING id; COMMIT;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"BEGIN; INSERT INTO aic_indexing_runs (id, project_id, run_type, status, stats, metadata) VALUES ('\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''knowledge'\\'', '\\''running'\\'', '\\''{}'\\''::jsonb, jsonb_build_object('\\''source'\\'', '\\''docs/testing.md'\\'')); INSERT INTO aic_knowledge_items (id, project_id, kind, title, content, source_reference, status, confidence, metadata) VALUES ('\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''testing'\\'', '\\''Unresolved contract tests and coverage status'\\'', '\\''Testing contract status: OrderUpdateContractTodoCest, OrderLedgerRouteContractTodoCest, and MonomarketImportContractTodoCest are intentionally incomplete markers, not passing behavioral tests. Replace them with assertions after clarifying the order update HTTP contract (status log, composite products, draft edit); shipped-order ledger route side effects and concurrency; and Monomarket import payload schema, malformed-row handling, rollback, and recovery. The documented full Codeception run reports three incomplete contract TODOs; do not count them as completed coverage.'\\'', '\\''docs/testing.md; httpdocs/tests/functional/*ContractTodoCest.php'\\'', '\\''active'\\'', 0.99, jsonb_build_object('\\''indexing_run_id'\\'', '\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\'')); INSERT INTO aic_chunks (id, project_id, source_type, knowledge_item_id, chunk_type, sequence_number, content, content_hash, token_count, metadata) VALUES ('\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''knowledge'\\'', '\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid, '\\''knowledge'\\'', 0, '\\''Testing contract status: OrderUpdateContractTodoCest, OrderLedgerRouteContractTodoCest, and MonomarketImportContractTodoCest are intentionally incomplete markers, not passing behavioral tests. Replace them with assertions after clarifying the order update HTTP contract (status log, composite products, draft edit); shipped-order ledger route side effects and concurrency; and Monomarket import payload schema, malformed-row handling, rollback, and recovery. The documented full Codeception run reports three incomplete contract TODOs; do not count them as completed coverage.'\\'', '\\''803481f00efa8d544615896ef058245f8fe28276944d582cf00c362429a3ddf3'\\'', 83, jsonb_build_object('\\''indexing_run_id'\\'', '\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\'')); COMMIT;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_E