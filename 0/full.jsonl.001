6cb-a86c-415b-9099-e2edb584df80'\\''::uuid RETURNING id; DELETE FROM aic_knowledge_items WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid RETURNING id; DELETE FROM aic_indexing_runs WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\''::uuid RETURNING id; COMMIT;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"BEGIN; INSERT INTO aic_indexing_runs (id, project_id, run_type, status, stats, metadata) VALUES ('\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''knowledge'\\'', '\\''running'\\'', '\\''{}'\\''::jsonb, jsonb_build_object('\\''source'\\'', '\\''docs/testing.md'\\'')); INSERT INTO aic_knowledge_items (id, project_id, kind, title, content, source_reference, status, confidence, metadata) VALUES ('\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''testing'\\'', '\\''Unresolved contract tests and coverage status'\\'', '\\''Testing contract status: OrderUpdateContractTodoCest, OrderLedgerRouteContractTodoCest, and MonomarketImportContractTodoCest are intentionally incomplete markers, not passing behavioral tests. Replace them with assertions after clarifying the order update HTTP contract (status log, composite products, draft edit); shipped-order ledger route side effects and concurrency; and Monomarket import payload schema, malformed-row handling, rollback, and recovery. The documented full Codeception run reports three incomplete contract TODOs; do not count them as completed coverage.'\\'', '\\''docs/testing.md; httpdocs/tests/functional/*ContractTodoCest.php'\\'', '\\''active'\\'', 0.99, jsonb_build_object('\\''indexing_run_id'\\'', '\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\'')); INSERT INTO aic_chunks (id, project_id, source_type, knowledge_item_id, chunk_type, sequence_number, content, content_hash, token_count, metadata) VALUES ('\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''knowledge'\\'', '\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid, '\\''knowledge'\\'', 0, '\\''Testing contract status: OrderUpdateContractTodoCest, OrderLedgerRouteContractTodoCest, and MonomarketImportContractTodoCest are intentionally incomplete markers, not passing behavioral tests. Replace them with assertions after clarifying the order update HTTP contract (status log, composite products, draft edit); shipped-order ledger route side effects and concurrency; and Monomarket import payload schema, malformed-row handling, rollback, and recovery. The documented full Codeception run reports three incomplete contract TODOs; do not count them as completed coverage.'\\'', '\\''803481f00efa8d544615896ef058245f8fe28276944d582cf00c362429a3ddf3'\\'', 83, jsonb_build_object('\\''indexing_run_id'\\'', '\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\'')); COMMIT;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_indexing_runs (project_id, run_type, status, git_commit, metadata) VALUES ('\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid, '\\''full'\\'', '\\''running'\\'', '\\''445141aceedb750c0deb717878d901e5c5d8c5f5'\\'', jsonb_build_object('\\''chunking'\\'', '\\''line fallback 240 lines/9500 chars'\\'', '\\''symbol_source'\\'', '\\''Serena PHP LSP'\\'', '\\''tree_sitter_fallback'\\'', '\\''batch segfault'\\'')) RETURNING id, project_id, status;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_indexing_runs (project_id,run_type,status,finished_at,stats,metadata) VALUES ('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid,'\\''incremental'\\'','\\''completed'\\'',NOW(),'{\\\"files\\\":7,\\\"chunks\\\":15,\\\"embeddings\\\":15,\\\"knowledge_items_updated\\\":1}', '{\\\"scope\\\":\\\"homepage UI, demo seeder, API test, frontend guidelines\\\",\\\"chunking\\\":\\\"80-line fallback\\\",\\\"structural_symbols_refreshed\\\":false}');\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_projects (name, slug, root_path, repository_url, default_branch, metadata) VALUES ('\\''Strateg Export Products'\\'', '\\''strateg-export-products'\\'', '\\''/home/kamaz/www/strateg-projects/strateg-export-products'\\'', '\\''git@github.com:kryvoboker/strateg-export-products.git'\\'', '\\''main'\\'', jsonb_build_object('\\''indexed_checkout_branch'\\'', '\\''dev/sync-prods'\\'')) RETURNING id, name, slug, root_path, active;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_projects (name, slug, root_path, repository_url, default_branch, metadata) VALUES ('\\''Yii3 Office Easyfit'\\'', '\\''yii3-office-easyfit'\\'', '\\''/home/kamaz/www/easyfit-projects/yii3-office.easyfit.com.ua'\\'', '\\''git@github.com:kryvoboker/yii3-office-easyfit.com.ua.git'\\'', '\\''main'\\'', jsonb_build_object(