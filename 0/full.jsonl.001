WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid) AS symbols, (SELECT count(*) FROM aic_documents WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid) AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid) AS knowledge, (SELECT count(*) FROM aic_chunks WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid) AS chunks; SELECT id,status,error_message FROM aic_indexing_runs WHERE id='\\''eec76587-38a0-4e2a-af2b-68f7c5c5ed9f'\\''::uuid AND project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT * FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''Yii2 Yii3 migration authentication inventory order product routing'\\'', 8);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.sequence_number,s.rank,left(s.content,100) AS match FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, '\\''categories'\\'', 20) s JOIN aic_chunks c ON c.id=s.chunk_id WHERE s.source_reference='\\''httpdocs/frontend/app/pages/index.vue'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT chunk_id,source_type,source_reference,title,left(content,120) AS excerpt FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid,'\\''intentionally incomplete markers'\\'',5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT chunk_id,source_type,source_reference,title,left(content,120) AS excerpt FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid,'\\''unresolved contract tests incomplete'\\'',5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name FROM information_schema.columns WHERE table_name = '\\''aic_chunks'\\'' ORDER BY ordinal_position; SELECT f.path, c.id, c.chunk_index, c.content_hash FROM aic_chunks c JOIN aic_files f ON f.id=c.file_id WHERE c.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/pages/index.vue'\\'', '\\''httpdocs/frontend/app/assets/css/main.css'\\'') ORDER BY f.path, c.chunk_index;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name FROM information_schema.columns WHERE table_name='\\''aic_files'\\'' ORDER BY ordinal_position; SELECT id,path,content_hash,metadata,indexed_at FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''d0f6680a-5956-4efc-a89b-1ea7505d3c97'\\''; SELECT id,sequence_number,start_line,end_line,token_count,metadata FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND file_id='\\''d0f6680a-5956-4efc-a89b-1ea7505d3c97'\\'' ORDER BY sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name, data_type FROM information_schema.columns WHERE table_name IN ('\\''aic_files'\\'', '\\''aic_symbols'\\'', '\\''aic_chunks'\\'', '\\''aic_documents'\\'', '\\''aic_knowledge_items'\\'', '\\''aic_embeddings'\\'') ORDER BY table_name, ordinal_position; SELECT s.id, s.kind, s.name, s.qualified_name, s.signature, s.start_line, s.end_line FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''httpdocs/frontend/app/components/AppHeader.vue'\\'' ORDER BY s.start_line; SELECT c.id, c.sequence_number, c.start_line, c.end_line, c.content_hash, length(c.content) AS chars, c.chunk_type, e.id IS NOT NULL AS has_embedding, c.metadata FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''httpdocs/frontend/app/components/AppHeader.vue'\\'' ORDER BY c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name, data_type FROM information_schema.columns WHERE table_name='\\''aic_indexing_runs'\\'' ORDER BY ordinal_position; SELECT id, status, started_at, stats, metadata FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'') ORDER BY started_at DESC LIMIT 10; SELECT count(*) FILTER (WHERE e.id IS NULL) AS missing_embeddings, count(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT f.id, f.path, f.content_hash, f.is_deleted, count(c.id) AS chunks, count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''httpdocs/frontend/app/components/AppHeader.vue'\\'' GROUP BY f.id;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.content_hash, c.sequence_number, c.content_hash AS chunk_hash, e.source_content_hash, e.dimensions, vector_dims(e.embedding) AS vector_dimensions FROM aic_files f JOIN aic_chunks c ON c.file_id=f.id AND c.project_id=f.project_id JOIN aic_embeddings e ON e.chunk_id=c.id AND e.project_id=c.project_id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path='\\''httpdocs/frontend/app/pages/index.vue'\\'' ORDER BY c.sequence_number; SELECT status,stats,metadata FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, c.id, c.sequence, c.content_hash FROM aic_chunks c JOIN aic_files f ON f.id=c.file_id WHERE c.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/pages/index.vue'\\'', '\\''httpdocs/frontend/app/assets/css/main.css'\\'') ORDER BY f.path, c.sequence;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, c.id, c.sequence_number, c.content_hash FROM aic_chunks c JOIN aic_files f ON f.id=c.file_id WHERE c.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/pages/index.vue'\\'', '\\''httpdocs/frontend/app/assets/css/main.css'\\'') ORDER BY f.path, c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, c.sequence_number, c.start_line, c.end_line, c.content_hash AS chunk_hash, e.dimensions, e.source_content_hash, vector_dims(e.embedding) AS vector_dimensions FROM aic_files f JOIN aic_chunks c ON c.file_id=f.id AND c.project_id=f.project_id JOIN aic_embeddings e ON e.chunk_id=c.id AND e.project_id=c.project_id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path='\\''httpdocs/frontend/app/pages/index.vue'\\'' ORDER BY c.sequence_number; SELECT indexname FROM pg_indexes WHERE tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\''; SELECT status,run_type,stats,metadata FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,f.content_hash,c.sequence_number,c.content_hash AS chunk_hash,e.source_content_hash,e.dimensions,vector_dims(e.embedding) AS vector_dimensions FROM aic_files f JOIN aic_chunks c ON c.file_id=f.id AND c.project_id=f.project_id JOIN aic_embeddings e ON e.chunk_id=c.id AND e.project_id=c.project_id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path='\\''httpdocs/frontend/app/pages/index.vue'\\'' AND c.sequence_number=0; SELECT status,stats FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,f.id,count(c.id) AS chunks,count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path IN ('\\''httpdocs/frontend/app/assets/css/main.css'\\'', '\\''httpdocs/frontend/app/pages/index.vue'\\'') GROUP BY f.path,f.id ORDER BY f.path;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT file_type, language, count(*) FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND NOT is_deleted GROUP BY file_type, language ORDER BY file_type, language; SELECT path, title, content_hash, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=d.project_id AND c.document_id=d.id) AS chunks FROM aic_documents d WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST, title; SELECT path, file_type, language, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=f.project_id AND c.file_id=f.id) AS chunks FROM aic_files f WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND NOT is_deleted AND (path LIKE '\\''%.md'\\'' OR path LIKE '\\''%.jpg'\\'' OR path LIKE '\\''%.png'\\'') ORDER BY path;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''easyfit-ua'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''yii3-office-easyfit'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug ILIKE '\\''%easyfit%'\\'' OR name ILIKE '\\''%easyfit%'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug ILIKE '\\''%pet-complaints%'\\'' OR root_path ILIKE '\\''%pet-complaints-platform%'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug LIKE '\\''%easyfit%'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, path, content_hash FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path IN ('\\''httpdocs/frontend/app/pages/index.vue'\\'', '\\''httpdocs/frontend/app/assets/css/main.css'\\'');\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, provider, model, dimensions, enabled FROM aic_embedding_models ORDER BY model;\" -c \"SELECT id, run_type, status, git_commit, started_at, finished_at, stats, error_message FROM aic_indexing_runs WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid ORDER BY started_at DESC LIMIT 10;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname = current_schema() AND tablename = '\\''aic_embeddings'\\'';\" -c \"SELECT count(*) AS stale_or_missing_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id = c.project_id AND e.chunk_id = c.id AND e.embedding_model_id = (SELECT id FROM aic_embedding_models WHERE model = '\\''text-embedding-3-small'\\'' AND provider = '\\''openai'\\'') WHERE c.project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND (e.id IS NULL OR e.source_content_hash <> c.content_hash);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug FROM aic_projects WHERE slug = '\\''pet-complaints-platform'\\'';\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug FROM aic_projects WHERE slug = '\\''yii3-office-easyfit'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id,slug FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'' AND active=TRUE; SELECT chunk_id,source_reference,title,rank,left(content,420) AS content FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'' AND active=TRUE),'\\''container'\\'',8);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT indexname, indexdef FROM pg_indexes WHERE schemaname=current_schema() AND tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_%'\\'' AND indexdef LIKE '\\''%9cb2ac9e-7047-4353-812c-35ecbb51289f%'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT kind, title, source_reference, left(content, 220) AS content_preview FROM aic_knowledge_items WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND status = '\\''active'\\'' ORDER BY kind, title;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT n.nspname, p.proname, pg_get_function_identity_arguments(p.oid) AS args FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE p.proname ILIKE '\\''%search%chunk%text%'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, p.active, (SELECT count(*) FROM aic_files f WHERE f.project_id=p.id AND NOT f.is_deleted) AS files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS active_knowledge, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id) AS embeddings FROM aic_projects p WHERE p.slug='\\''pet-complaints-platform'\\''; SELECT m.id, m.provider, m.model, m.dimensions, m.enabled FROM aic_embedding_models m WHERE m.provider='\\''openai'\\'' AND m.model='\\''text-embedding-3-small'\\''; SELECT id, status, started_at, completed_at, stats, metadata FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'') ORDER BY started_at DESC LIMIT 10;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.name,p.slug,p.root_path,r.id AS run_id,r.status,r.git_commit,r.stats->> '\\''files'\\'' AS stat_files,r.stats->> '\\''symbols'\\'' AS stat_symbols,r.stats->> '\\''chunks'\\'' AS stat_chunks,(SELECT count(*) FROM aic_files f WHERE f.project_id=p.id) AS files,(SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols,(SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents,(SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS knowledge,(SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks,(SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.embedding_model_id=m.id) AS embeddings,(SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.embedding_model_id=m.id AND (e.dimensions<>1536 OR vector_dims(e.embedding)<>1536 OR e.source_content_hash<> (SELECT c.content_hash FROM aic_chunks c WHERE c.project_id=e.project_id AND c.id=e.chunk_id))) AS invalid_embeddings,(SELECT count(*) FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_9cb2ac9e704b_m_0e87a4a94b79'\\'') AS expected_hnsw_index FROM aic_projects p JOIN aic_indexing_runs r ON r.project_id=p.id JOIN aic_embedding_models m ON m.provider='\\''openai'\\'' AND m.model='\\''text-embedding-3-small'\\'' WHERE p.slug='\\''easyfit-ua'\\'' AND p.id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND r.id='\\''eec76587-38a0-4e2a-af2b-68f7c5c5ed9f'\\''::uuid; SELECT kind,title,source_reference,status,confidence FROM aic_knowledge_items WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid ORDER BY kind,title;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.slug,s.chunk_id,s.source_type,s.source_reference,s.title,s.rank,left(s.content,650) AS content FROM aic_projects p CROSS JOIN LATERAL aic_search_chunks_text(p.id, '\\''homepage desktop container margin spacing layout'\\'', 8) s WHERE p.slug='\\''pet-complaints-platform'\\'' AND p.active=TRUE ORDER BY s.rank;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.slug, (SELECT count(*) FROM aic_files f WHERE f.project_id=p.id AND NOT f.is_deleted) AS files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS knowledge, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id) AS embeddings, (SELECT count(*) FROM aic_indexing_runs r WHERE r.project_id=p.id AND r.status='\\''running'\\'') AS running_runs FROM aic_projects p WHERE p.id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT count(*) FILTER (WHERE e.id IS NULL) AS missing_embeddings, count(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT r.id, r.status, r.stats, r.metadata->>'\\''relations_populated'\\'' AS relations_populated FROM aic_indexing_runs r WHERE r.id='\\''d099058c-e63c-42a5-8082-6c6080b787fd'\\''::uuid;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.slug, (SELECT count(*) FROM aic_files f WHERE f.project_id=p.id AND NOT f.is_deleted) AS files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT count(*) FROM aic_symbol_relations r WHERE r.project_id=p.id) AS symbol_relations, (SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS active_knowledge, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid) AS model_embeddings FROM aic_projects p WHERE p.id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT dimensions, count(*) AS vectors FROM aic_embeddings WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid GROUP BY dimensions; SELECT count(*) FILTER (WHERE e.id IS NULL) AS missing_embeddings, count(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\''; SELECT id, status, stats FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, sequence_number, left(content, 100) AS match FROM search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, '\\''max-w-7xl homepage layout'\\'', 5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path,sequence_number,left(content,100) AS match FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, '\\''max-w-7xl homepage layout'\\'', 5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT pg_get_function_result(p.oid) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='\\''public'\\'' AND p.proname='\\''aic_search_chunks_text'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT run_type,status,stats,metadata FROM a