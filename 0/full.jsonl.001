\''main'\\'', '\\''{\\\"index_scope\\\":\\\"OpenCart source, docs, and front-end source; secrets/vendor/runtime excluded\\\"}'\\''::jsonb) ON CONFLICT (slug) DO UPDATE SET name=EXCLUDED.name, root_path=EXCLUDED.root_path, active=TRUE RETURNING id, name, slug;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.id, c.chunk_type, c.sequence_number, c.start_line, c.end_line, c.metadata, c.content_hash, e.source_content_hash FROM aic_projects p JOIN aic_files f ON f.project_id = p.id JOIN aic_chunks c ON c.project_id = p.id AND c.file_id = f.id LEFT JOIN aic_embeddings e ON e.project_id = p.id AND e.chunk_id = c.id WHERE p.slug = '\\''pet-complaints-platform'\\'' AND f.path = '\\''httpdocs/frontend/app/components/AppFooter.vue'\\'' AND f.is_deleted = FALSE; SELECT indexname FROM pg_indexes WHERE schemaname = '\\''public'\\'' AND tablename = '\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_embeddings_project_%'\\'';\"' && docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'node -e '\\''const fs=require(\"fs\"); for (const f of process.argv.slice(1)){const v=JSON.parse(fs.readFileSync(f)); console.log(JSON.stringify({file:f,count:v.length,dimensions:v[0]?.length}));}'\\'' /app/embedding-results/2026/10/pet-complaints-platform-app-footer-script-c2626174.json /app/embedding-results/2026/10/pet-complaints-platform-app-footer-template-3e1f214e.json'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT chunk_id,source_type,source_reference,title,left(content,180) AS content_preview FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid,'\\''complaint category rel nofollow filter state'\\'',10);\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT count(*) AS matching_knowledge_titles FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\''; SELECT count(*) AS old_code_chunks FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND c.source_type='\\''code'\\'' AND f.path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]);\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.id AS file_id, f.content_hash AS file_hash, c.id AS chunk_id, c.content_hash AS chunk_hash, c.start_line, c.end_line, length(c.content) AS chunk_length, e.id AS embedding_id, e.source_content_hash, e.dimensions FROM aic_projects p JOIN aic_files f ON f.project_id = p.id JOIN aic_chunks c ON c.project_id = p.id AND c.file_id = f.id LEFT JOIN aic_embeddings e ON e.project_id = p.id AND e.chunk_id = c.id WHERE p.slug = '\\''pet-complaints-platform'\\'' AND f.path = '\\''httpdocs/frontend/app/components/AppFooter.vue'\\'' AND f.is_deleted = FALSE ORDER BY c.sequence_number; SELECT run_type, status, started_at, finished_at FROM aic_indexing_runs r JOIN aic_projects p ON p.id = r.project_id WHERE p.slug = '\\''pet-complaints-platform'\\'' ORDER BY started_at DESC LIMIT 3;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.id, count(c.id) AS chunks, count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id = f.project_id AND c.file_id = f.id AND c.source_type = '\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id = c.project_id AND e.chunk_id = c.id WHERE f.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path LIKE '\\''httpdocs/frontend/%Complaint%'\\'' GROUP BY f.path,f.content_hash,f.id ORDER BY f.path;\" -c \"SELECT id, kind, title, source_reference, status FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status = '\\''active'\\'' ORDER BY title;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname = '\\''public'\\'' AND tablename = '\\''aic_embeddings'\\'' AND indexname = '\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,c.id,c.sequence_number,c.start_line,c.end_line,c.content_hash,length(c.content) AS content_length,left(c.content,180) AS content_preview FROM aic_files f JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'') ORDER BY f.path,c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,count(c.id) AS code_chunks,count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id AND c.source_type='\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]) GROUP BY f.path ORDER BY f.path; SELECT count(c.id) AS knowledge_chunks,count(e.id) AS knowledge_embeddings FROM aic_knowledge_items k LEFT JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE k.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND k.title='\\''Complaint list frontend flow and filter state'\\''; SELECT id,status,finished_at FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name,s.signature,s.start_line,s.end_line,s.visibility,s.is_exported FROM aic_files f JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'') ORDER BY f.path,s.start_line;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''pet-complaints-platform'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug, name, root_path, active FROM aic_projects WHERE slug ILIKE '\\''%easyfit%'\\'' OR name ILIKE '\\''%easyfit%'\\'' OR root_path ILIKE '\\''%yii3-office%'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug, name, root_path, active, created_at, updated_at FROM aic_projects WHERE slug = '\\''yii3-office-easyfit'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, status, started_at, finished_at, stats FROM aic_indexing_runs WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 8;\" -c \"SELECT '\\''files'\\'' AS table_name, count(*) FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''symbols'\\'', count(*) FROM aic_symbols WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''chunks'\\'', count(*) FROM aic_chunks WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''embeddings'\\'', count(*) FROM aic_embeddings WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''docs'\\'', count(*) FROM aic_documents WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''knowledge'\\'', count(*) FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT path, content_hash, is_deleted, indexed_at FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'', '\\''httpdocs/frontend/i18n/locales/en.json'\\'', '\\''httpdocs/frontend/i18n/locales/uk.json'\\'') ORDER BY path;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.id,k.kind,k.title,k.status,k.confidence,k.source_reference,count(c.id) AS linked_chunks,count(e.id) AS linked_embeddings FROM aic_knowledge_items k LEFT JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE k.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND k.title='\\''Complaint list frontend flow and filter state'\\'' GROUP BY k.id; SELECT c.source_type,count(*) AS chunks,count(e.id) AS embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (f.path LIKE '\\''httpdocs/frontend/%Complaint%'\\'' OR c.knowledge_item_id IN (SELECT id FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\'')) GROUP BY c.source_type ORDER BY c.source_type;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, m.id AS model_id, m.model, m.dimensions, (SELECT count(*) FROM aic_files f WHERE f.project_id = p.id AND f.is_deleted = FALSE) AS files, (SELECT count(*) FROM aic_chunks c WHERE c.project_id = p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id = p.id AND e.embedding_model_id = m.id) AS embeddings, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id = p.id) AS knowledge FROM aic_projects p LEFT JOIN aic_embedding_models m ON m.provider = '\\''openai'\\'' AND m.model = '\\''text-embedding-3-small'\\'' WHERE p.slug = '\\''pet-complaints-platform'\\'' AND p.active = TRUE;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path,id,content_hash FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]) ORDER BY path; SELECT r.status,r.finished_at,r.stats FROM aic_indexing_runs r WHERE r.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND r.id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\''; SELECT count(*) AS missing FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL; SELECT count(*) AS stale FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (e.source_content_hash <> c.content_hash OR e.dimensions <> 1536); SELECT id,title,status FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\''; SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT r.id, r.status, r.started_at, r.completed_at, r.stats FROM aic_indexing_runs r WHERE r.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY r.started_at DESC LIMIT 8;\" -c \"SELECT '''files''' AS table_name, count(*) FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''symbols''', count(*) FROM aic_symbols WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''chunks''', count(*) FROM aic_chunks WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''embeddings''', count(*) FROM aic_embeddings WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''d