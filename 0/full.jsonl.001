ymbol_relations WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'') AS strateg_ua_relations,(SELECT count(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'') AS strateg_ua_symbols; SELECT p.slug,count(r.id) AS relations FROM aic_projects p LEFT JOIN aic_symbol_relations r ON r.project_id=p.id GROUP BY p.slug HAVING count(r.id)>0 ORDER BY relations DESC LIMIT 10;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.language,s.kind,count(*) FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY f.language,s.kind ORDER BY f.language,s.kind;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND (s.name IN ('\\''BaseService'\\'','\\''HttpException'\\'','\\''ToolInterface'\\'','\\''ProductSearchProviderInterface'\\'') OR s.qualified_name ILIKE '\\''%BaseService'\\'') ORDER BY s.name LIMIT 25;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name,s.start_line,s.start_column,s.end_line,s.end_column FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND s.kind IN ('\\''class'\\'','\\''method'\\'','\\''function'\\'','\\''interface'\\'','\\''trait'\\'') ORDER BY f.path,s.start_line LIMIT 12;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT kind,count(*) AS symbols FROM aic_symbols GROUP BY kind ORDER BY symbols DESC; SELECT p.slug,s.kind,count(*) AS symbols FROM aic_symbols s JOIN aic_projects p ON p.id=s.project_id WHERE s.kind IN ('\\''module'\\'','\\''file'\\'','\\''namespace'\\'') GROUP BY p.slug,s.kind ORDER BY p.slug,s.kind;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT language,COUNT(*) FROM aic_files WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND is_deleted=FALSE GROUP BY language ORDER BY COUNT(*) DESC; SELECT kind,COUNT(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY kind ORDER BY COUNT(*) DESC; SELECT run_type,status,COUNT(*) FROM aic_indexing_runs WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY run_type,status ORDER BY run_type,status;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE conname = '\\''indexing_runs_type_valid'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT relation_type, count(*) AS total, count(target_symbol_id) AS resolved, count(*) FILTER (WHERE target_symbol_id IS NULL) AS unresolved FROM aic_symbol_relations WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY relation_type ORDER BY relation_type; SELECT count(*) AS total_relations, count(*) FILTER (WHERE evidence IS NULL OR evidence = '\\''{}'\\''::jsonb) AS missing_evidence, count(*) FILTER (WHERE source_line < 1) AS invalid_lines, count(*) FILTER (WHERE target_symbol_id IS NOT NULL AND source.project_id <> target.project_id) AS cross_project_targets FROM aic_symbol_relations r JOIN aic_symbols source ON source.id=r.source_symbol_id LEFT JOIN aic_symbols target ON target.id=r.target_symbol_id WHERE r.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\''; SELECT kind,count(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND kind='\\''module'\\'' GROUP BY kind; SELECT id,run_type,status,stats FROM aic_indexing_runs WHERE id='\\''afe788a3-466d-4c16-b81e-4d1c34f4a109'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,data_type FROM information_schema.columns WHERE table_name='\\''aic_indexing_runs'\\'' ORDER BY ordinal_position\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,data_type,udt_name,is_nullable FROM information_schema.columns WHERE table_name = '\\''aic_embeddings'\\'' ORDER BY ordinal_position\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -P pager=off -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,data_type,is_nullable FROM information_schema.columns WHERE table_schema='\\''public'\\'' AND table_name='\\''aic_knowledge_items'\\'' ORDER BY ordinal_position;\" -c \"SELECT id,kind,title,status,confidence,source_reference FROM aic_knowledge_items WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' ORDER BY created_at;\" -c \"SELECT id,provider,model,dimensions FROM aic_embedding_models WHERE enabled=true ORDER BY model;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -P pager=off -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, s.kind AS source_kind, s.name AS source_name, s.parent_symbol_id, r.target_qualified_name, r.source_line, r.evidence FROM aic_symbol_relations r JOIN aic_symbols s ON s.id=r.source_symbol_id JOIN aic_files f ON f.id=s.file_id WHERE r.project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' AND f.path='\\''app-code/app/app/Jobs/ProcessProductImportBatchJob.php'\\'' AND r.relation_type='\\''calls'\\'' AND r.source_line=218 LIMIT 10;\" -c \"SELECT s.id,s.kind,s.name,s.qualified_name,s.parent_symbol_id,s.start_line FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' AND f.path='\\''app-code/app/app/Jobs/ProcessProductImportBatchJob.php'\\'' AND (s.name IN ('\\''handle'\\'','\\''prepareItemsFromExcelBatch'\\'') OR s.qualified_name LIKE '\\''%ProcessProductImportBatchJob'\\'') ORDER BY s.start_line;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -P pager=off -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT relation_type, COUNT(*) AS relations, COUNT(target_symbol_id) AS resolved, COUNT(*) FILTER (WHERE target_symbol_id IS NULL) AS unresolved FROM aic_symbol_relations WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' GROUP BY relation_type ORDER BY relation_type;\" -c \"SELECT COUNT(*) AS relation_total, COUNT(DISTINCT source_symbol_id) AS source_symbols, COUNT(*) FILTER (WHERE target_symbol_id IS NOT NULL) AS resolved, COUNT(*) FILTER (WHERE target_symbol_id IS NULL) AS unresolved FROM aic_symbol_relations WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'';\" -c \"SELECT run_type, status, git_commit, stats FROM aic_indexing_runs WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -P pager=off -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT relation_type,COUNT(*) AS total,COUNT(target_symbol_id) AS resolved,COUNT(*) FILTER (WHERE target_symbol_id IS NULL) AS unresolved FROM aic_symbol_relations WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' GROUP BY relation_type ORDER BY relation_type;\" -c \"SELECT COUNT(*) AS total,COUNT(DISTINCT source_symbol_id) AS sources,COUNT(target_symbol_id) AS resolved,COUNT(*) FILTER (WHERE target_symbol_id IS NULL) AS unresolved FROM aic_symbol_relations WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'';\" -c \"SELECT id,run_type,status,stats->>'\\''symbol_relations'\\'' AS relation_count,stats->>'\\''resolved_targets'\\'' AS resolved_target_count,finished_at FROM aic_indexing_runs WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -P pager=off -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_name,column_name,data_type FROM information_schema.columns WHERE table_schema='\\''public'\\'' AND table_name IN ('\\''aic_documents'\\'', '\\''aic_chunks'\\'', '\\''aic_embeddings'\\'', '\\''aic_embedding_models'\\'') ORDER BY table_name,ordinal_position;\" -c \"SELECT id,run_type,status,git_commit,started_at,finished_at,stats FROM aic_indexing_runs WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' ORDER BY started_at DESC LIMIT 3;\" -c \"SELECT d.id,d.path,d.content_hash,COUNT(c.id) AS chunks,COUNT(e.id) AS embeddings FROM aic_documents d LEFT JOIN aic_chunks c ON c.project_id=d.project_id AND c.document_id=d.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE d.project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' AND d.path='\\''docs/ai-code-intelligence.md'\\'' GROUP BY d.id,d.path,d.content_hash;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -q -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"COPY (SELECT f.path,f.id AS file_id,f.language,f.content_hash,s.id AS symbol_id,s.kind,s.name,s.qualified_name,s.start_line,s.start_column,s.end_line,s.end_column,s.parent_symbol_id FROM aic_files f LEFT JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND f.is_deleted=FALSE ORDER BY f.path,s.start_line) TO STDOUT WITH CSV HEADER\"' > /tmp/strategua_aic_symbols.csv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -q -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"COPY (SELECT f.path,f.id AS file_id,f.language,s.id AS symbol_id,s.kind,s.name,s.qualified_name,s.start_line,s.start_column,s.end_line,s.end_column,s.parent_symbol_id FROM aic_files f LEFT JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND f.is_deleted=FALSE ORDER BY f.path,s.start_line) TO STDOUT WITH CSV HEADER\"' > /tmp/strategua_aic_symbols.csv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -qAt -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT kind, COUNT(*), COUNT(*) FILTER (WHERE qualified_name IS NOT NULL AND qualified_name <> '\\'''\\''') FROM aic_symbols WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' GROUP BY kind ORDER BY kind;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -qAt -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE conrelid='\\''aic_indexing_runs'\\''::regclass AND conname='\\''indexing_runs_type_valid'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"$1\"' sh \"UPDATE aic_indexing_runs SET stats=stats || '{\\\"parser_fallback\\\":\\\"Tree-sitter batch traversal segfaulted; AST call extraction used ast-grep PHP structural queries instead.\\\"}'::jsonb WHERE project_id='9cb2ac9e-7047-4353-812c-35ecbb51289f' AND id='c59a80f2-855e-4c13-88fa-5909b42a4f03' RETURNING id,status,stats->>'parser_fallback' AS parser_fallback;\""],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -F \"$(printf '\\''\\t'\\'')\" -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT s.id, s.file_id, f.path, f.language, s.kind, s.name, COALESCE(s.qualified_name, '\\'' '\\''), s.start_line, s.end_line FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT f.is_deleted ORDER BY f.path, s.start_line, s.end_line;\"' > /tmp/pet-aic-symbols.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -F \"$(printf '\\''\\t'\\'')\" -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT s.id, s.parent_symbol_id, s.file_id, f.path, f.language, s.kind, s.name, COALESCE(s.qualified_name, '\\'' '\\''), s.start_line, s.end_line FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT f.is_deleted ORDER BY f.path, s.start_line, s.end_line;\"' > /tmp/pet-aic-symbols.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -F \"$(printf '\\''\\t'\\'')\" -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT s.kind, s.name, s.qualified_name, parent.name AS parent FROM aic_symbols s LEFT JOIN aic_symbols parent ON parent.project_id=s.project_id AND parent.id=s.parent_symbol_id WHERE s.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND s.name IN ('\\''handle'\\'', '\\''query'\\'', '\\''CreateComplaint'\\'') LIMIT 25;\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COALESCE(path, '\\''\\''), content_hash FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST, title;\"' > /tmp/pet-complaints-indexed-documents.tsv && wc -l /tmp/pet-complaints-indexed-documents.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.sequence_number, c.start_line, c.end_line, length(c.content), c.content_hash FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path IN ('\\''httpdocs/frontend/openapi/openapi.yaml'\\'', '\\''httpdocs/frontend/app/pages/complaints/create.vue'\\'') ORDER BY f.path, c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.start_line, c.end_line, length(c.content), c.content_hash, encode(digest(c.content,'\\''sha256'\\''),'\\''hex'\\''), left(c.content,80), right(c.content,80) FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''.docker/dev/docker-compose.yml'\\'' ORDER BY c.sequence_number LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, path, file_type, COALESCE(language, '\\'''\\''), COALESCE(content_hash, '\\'''\\''), COALESCE(size_bytes::text, '\\'''\\''), COALESCE(git_blob_sha, '\\'''\\''), is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path; SELECT id, path, title, COALESCE(content_hash, '\\'''\\'') FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST; SELECT c.source_type, COALESCE(f.path, d.path, k.source_reference), c.sequence_number, c.id, c.content_hash FROM aic_chunks c LEFT JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id LEFT JOIN aic_documents d ON d.project_id=c.project_id AND d.id=c.document_id LEFT JOIN aic_knowledge_items k ON k.project_id=c.project_id AND k.id=c.knowledge_item_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY c.source_type, 2, c.sequence_number;\"' > /tmp/pet-complaints-db-inventory.txt && wc -l /tmp/pet-complaints-db-inventory.txt"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, COALESCE(content_hash, '\\'''\\''), is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path;\"' > /tmp/pet-complaints-indexed-files.tsv && wc -l /tmp/pet-complaints-indexed-files.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, content_hash FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST;\"' > /tmp/pet-complaints-indexed-documents.tsv && wc -l /tmp/pet-complaints-indexed-documents.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, content_hash, is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path; SELECT path, content_hash FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST;\"' > /tmp/pet-complaints-final-hashes.txt"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT sequence_number, start_line, end_line, length(content), substring(content from 1 for 80), substring(content from length(content)-50 for 60) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND file_id=(SELECT id FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND path='\\''.docker/dev/docker-compose.yml'\\'') ORDER BY sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT count(*) FROM (SELECT v.chunk_id FROM aic_embeddings e JOIN v_aic_retrieval_chunks v ON v.project_id=e.project_id AND v.chunk_id=e.chunk_id WHERE e.project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid ORDER BY (e.embedding::vector(1536)) <=> (SELECT embedding::vector(1536) FROM aic_embeddings WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1) LIMIT 5) hits;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT count(*) FROM aic_search_chunks_vector_hnsw('\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid,'\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid,(SELECT embedding FROM aic_embeddings WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1),5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT id, slug FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'' AND active = TRUE\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT source_reference || E\\'\\\\t\\' || title || E\\'\\\\n\\' || left(content, 700) FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'' AND active = TRUE), '\\''UniXML google product feed identifier_exists GTIN manufacturer MPN export\\'', 8)\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"BEGIN; DELETE FROM aic_embeddings WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND chunk_id='\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid RETURNING id; DELETE FROM aic_chunks WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid RETURNING id; DELETE FROM aic_knowledge_items WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid RETURNING id; DELETE FROM aic_indexing_runs WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\''::uuid RETURNING id; COMMIT;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"BEGIN; INSERT INTO aic_indexing_runs (id, project_id, run_type, status, stats, metadata) VALUES ('\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''knowledge'\\'', '\\''running'\\'', '\\''{}'\\''::jsonb, jsonb_build_object('\\''source'\\'', '\\''docs/testing.md'\\'')); INSERT INTO aic_knowledge_items (id, project_id, kind, title, content, source_reference, status, confidence, metadata) VALUES ('\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''testing'\\'', '\\''Unresolved contract tests and coverage status'\\'', '\\''Testing contract status: OrderUpdateContractTodoCest, OrderLedgerRouteContractTodoCest, and MonomarketImportContractTodoCest are intentionally incomplete markers, not passing behavioral tests. Replace them with assertions after clarifying the order update HTTP contract (status log, composite products, draft edit); shipped-order ledger route side effects and concurrency; and Monomarket import payload schema, malformed-row handling, rollback, and recovery. The documented full Codeception run reports three incomplete contract TODOs; do not count them as completed coverage.'\\'', '\\''docs/testing.md; httpdocs/tests/functional/*ContractTodoCest.php'\\'', '\\''active'\\'', 0.99, jsonb_build_object('\\''indexing_run_id'\\'', '\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\'')); INSERT INTO aic_chunks (id, project_id, source_type, knowledge_item_id, chunk_type, sequence_number, content, content_hash, token_count, metadata) VALUES ('\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''knowledge'\\'', '\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid, '\\''knowledge'\\'', 0, '\\''Testing contract status: OrderUpdateContractTodoCest, OrderLedgerRouteContractTodoCest, and MonomarketImportContractTodoCest are intentionally incomplete markers, not passing behavioral tests. Replace them with assertions after clarifying the order update HTTP contract (status log, composite products, draft edit); shipped-order ledger route side effects and concurrency; and Monomarket import payload schema, malformed-row handling, rollback, and recovery. The documented full Codeception run reports three incomplete contract TODOs; do not count them as completed coverage.'\\'', '\\''803481f00efa8d544615896ef058245f8fe28276944d582cf00c362429a3ddf3'\\'', 83, jsonb_build_object('\\''indexing_run_id'\\'', '\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\'')); COMMIT;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_indexing_runs (project_id, run_type, status, git_commit, metadata) VALUES ('\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid, '\\''full'\\'', '\\''running'\\'', '\\''445141aceedb750c0deb717878d901e5c5d8c5f5'\\'', jsonb_build_object('\\''chunking'\\'', '\\''line fallback 240 lines/9500 chars'\\'', '\\''symbol_source'\\'', '\\''Ser