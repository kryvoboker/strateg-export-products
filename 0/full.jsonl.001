s, (SELECT count(*) FROM aic_embeddings WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS embeddings, (SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' AND e.source_content_hash=c.content_hash WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL) AS missing_embeddings; SELECT relation_type,count(*) FROM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' GROUP BY relation_type ORDER BY relation_type; SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%hnsw%9da19a96c510%7f16f2a76e0e%\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT (SELECT count(*) FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT is_deleted) AS files, (SELECT count(*) FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status='\\''active'\\'') AS knowledge, (SELECT count(*) FROM aic_symbols WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS symbols, (SELECT count(*) FROM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS relations, (SELECT count(*) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS embeddings, (SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' AND e.source_content_hash=c.content_hash WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL) AS missing_embeddings; SELECT relation_type,count(*) FROM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' GROUP BY relation_type ORDER BY relation_type;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT f.path, f.content_hash, f.file_type, count(s.id) AS symbols FROM aic_files f LEFT JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path LIKE '\\''httpdocs/frontend/app/%'\\'' GROUP BY f.path,f.content_hash,f.file_type ORDER BY f.path;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT id,kind,title,source_reference,status,left(content,320) FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status='\\''active'\\'' ORDER BY title;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT s.id,s.kind,s.name,s.qualified_name,s.start_line,s.end_line,s.is_exported,s.content_hash FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path='\\''httpdocs/frontend/app/utils/helpers.ts'\\'' ORDER BY start_line;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT n.nspname || '\\''.'\\'' || p.proname || '\\''('   || pg_get_function_identity_arguments(p.oid) || '\\'')'\\'' FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE p.proname ILIKE '\\''%search%\\'' ORDER BY 1;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -Atqc \"SELECT id, slug FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT * FROM search_chunks_text('\\''3c7f07bd-bcb6-4516-908e-bc0fc8eb52cf'\\'', '\\''date_modified easyfit_sitemap'\\'', 10);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT source_reference, title, left(content, 500) AS excerpt FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug = '\\''easyfit-pl'\\''), '\\''Universal Import Pro XML processor google feed export'\\'', 10);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT source_reference, title, rank FROM aic_search_chunks_text('\\''3c7f07bd-bcb6-4516-908e-bc0fc8eb52cf'\\''::uuid, '\\''date_modified easyfit_sitemap'\\'', 10);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -A -F \"|\" -t -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH project AS (SELECT id FROM aic_projects WHERE slug = '\\''pet-complaints-platform'\\'' AND active = TRUE) SELECT chunk_id, source_reference, title, rank, content FROM aic_search_chunks_text((SELECT id FROM project), '\\''about mission community rules guidelines contact support categories menu authentication registration'\\'', 12);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.name,p.slug, (SELECT count(*) FROM aic_files f WHERE f.project_id=p.id) files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) symbols, (SELECT count(*) FROM aic_symbol_relations r WHERE r.project_id=p.id) relations, (SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) documents, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id) knowledge, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id) embeddings FROM aic_projects p WHERE p.id='\\''71e65548-93bf-4c21-af21-ff7a2797e07d'\\''::uuid; SELECT count(*) AS invalid_embeddings FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''71e65548-93bf-4c21-af21-ff7a2797e07d'\\''::uuid AND (e.dimensions<>1536 OR e.source_content_hash<>c.content_hash); SELECT run_type,status,git_commit,stats FROM aic_indexing_runs WHERE id='\\''1e6d7175-eff3-4755-a4af-327e7aadb2e3'\\''::uuid; SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_71e6554893bf_m_7f16f2a76e0e'\\''; SELECT relation_type, count(*) FROM aic_symbol_relations WHERE project_id='\\''71e65548-93bf-4c21-af21-ff7a2797e07d'\\''::uuid GROUP BY relation_type ORDER BY relation_type;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'', finished_at=NOW(), stats=stats || jsonb_build_object('\\''files'\\'',73,'\\''symbols'\\'',187,'\\''symbol_relations'\\'',1271,'\\''documents'\\'',13,'\\''knowledge_items'\\'',5,'\\''chunks'\\'',313,'\\''embeddings'\\'',313,'\\''embedding_batches'\\'',10,'\\''embedding_model'\\'', '\\''text-embedding-3-small'\\'', '\\''dimensions'\\'',1536,'\\''hnsw_index'\\'', '\\''aic_emb_hnsw_p_71e6554893bf_m_7f16f2a76e0e'\\'', '\\''redacted_files'\\'',2,'\\''embedding_strategy_note'\\'', '\\''two long chunks were segmented and mean-pooled'\\'', '\\''verification_invalid_embeddings'\\'',0) WHERE id='\\''1e6d7175-eff3-4755-a4af-327e7aadb2e3'\\''::uuid AND project_id='\\''71e65548-93bf-4c21-af21-ff7a2797e07d'\\''::uuid AND status='\\''running'\\''; SELECT status, finished_at, stats->>'\\''files'\\'' files,stats->>'\\''embeddings'\\'' embeddings FROM aic_indexing_runs WHERE id='\\''1e6d7175-eff3-4755-a4af-327e7aadb2e3'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_indexing_runs (id, project_id, run_type, status, git_commit, stats, metadata) VALUES ('\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\'', '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'', '\\''full'\\'', '\\''running'\\'', '\\''db84b9007461b4753bd03474d38490cf4f13569e'\\'', jsonb_build_object('\\''planned_files'\\'',376,'\\''planned_code_files'\\'',355,'\\''planned_symbols'\\'',1918,'\\''planned_documents'\\'',21,'\\''planned_knowledge_items'\\'',6,'\\''planned_chunks'\\'',916), jsonb_build_object('\\''branch'\\'', '\\''dev/sync-prods'\\'', '\\''parser'\\'', '\\''ast-grep declarations; Tree-sitter batch traversal segfaulted'\\'', '\\''symbol_relations'\\'', '\\''not populated'\\'')) RETURNING id, status;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT COUNT(*) FROM aic_files WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND is_deleted = FALSE) AS files, (SELECT COUNT(*) FROM aic_symbols WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS symbols, (SELECT COUNT(*) FROM aic_documents WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS documents, (SELECT COUNT(*) FROM aic_knowledge_items WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status = '\\''active'\\'') AS 