gresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') SELECT '\\''files'\\'' AS entity, count(*) FROM aic_files WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''symbols'\\'', count(*) FROM aic_symbols WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''relations'\\'', count(*) FROM aic_symbol_relations WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''documents'\\'', count(*) FROM aic_documents WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''knowledge_items'\\'', count(*) FROM aic_knowledge_items WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''chunks'\\'', count(*) FROM aic_chunks WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''embeddings'\\'', count(*) FROM aic_embeddings WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''runs'\\'', count(*) FROM aic_indexing_runs WHERE project_id = (SELECT id FROM p); SELECT m.id, m.provider, m.model, m.dimensions, m.enabled, count(e.id) AS embedding_count FROM aic_embedding_models m LEFT JOIN aic_embeddings e ON e.embedding_model_id = m.id AND e.project_id = (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') GROUP BY m.id ORDER BY m.model; SELECT id, run_type, status, git_commit, started_at, finished_at, stats, error_message FROM aic_indexing_runs WHERE project_id = (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') ORDER BY started_at DESC LIMIT 10; SELECT indexname, indexdef FROM pg_indexes WHERE schemaname = current_schema() AND tablename = '\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%7f2841b6-c020-46ef-9597-72ac54812b45%'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\"' < /tmp/easyfit-index/easyfit-pl-index.sql"],["/