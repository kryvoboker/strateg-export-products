 ON parent.project_id=s.project_id AND parent.id=s.parent_symbol_id WHERE s.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND s.name IN ('\\''handle'\\'', '\\''query'\\'', '\\''CreateComplaint'\\'') LIMIT 25;\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COALESCE(path, '\\''\\''), content_hash FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST, title;\"' > /tmp/pet-complaints-indexed-documents.tsv && wc -l /tmp/pet-complaints-indexed-documents.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.sequence_number, c.start_line, c.end_line, length(c.content), c.content_hash FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path IN ('\\''httpdocs/frontend/openapi/openapi.yaml'\\'', '\\''httpdocs/frontend/app/pages/complaints/create.vue'\\'') ORDER BY f.path, c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.start_line, c.end_line, length(c.content), c.content_hash, encode(digest(c.content,'\\''sha256'\\''),'\\''hex'\\''), left(c.content,80), right(c.content,80) FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''.docker/dev/docker-compose.yml'\\'' ORDER BY c.sequence_number LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, path, file_type, COALESCE(language, '\\'''\\''), COALESCE(content_hash, '\\'''\\''), COALESCE(size_bytes::text, '\\'''\\''), COALESCE(git_blob_sha, '\\'''\\''), is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path; SELECT id, path, title, COALESCE(content_hash, '\\'''\\'') FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST; SELECT c.source_type, COALESCE(f.path, d.path, k.source_reference), c.sequence_number, c.id, c.content_hash FROM aic_chunks c LEFT JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id LEFT JOIN aic_documents d ON d.project_id=c.project_id AND d.id=c.document_id LEFT JOIN aic_knowledge_items k ON k.project_id=c.project_id AND k.id=c.knowledge_item_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY c.source_type, 2, c.sequence_number;\"' > /tmp/pet-complaints-db-inventory.txt && wc -l /tmp/pet-complaints-db-inventory.txt"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, COALESCE(content_hash, '\\'''\\''), is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path;\"' > /tmp/pet-complaints-indexed-files.tsv && wc -l /tmp/pet-complaints-indexed-files.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/