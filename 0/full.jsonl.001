 DESC LIMIT 3;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.id, count(c.id) AS chunks, count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id = f.project_id AND c.file_id = f.id AND c.source_type = '\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id = c.project_id AND e.chunk_id = c.id WHERE f.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path LIKE '\\''httpdocs/frontend/%Complaint%'\\'' GROUP BY f.path,f.content_hash,f.id ORDER BY f.path;\" -c \"SELECT id, kind, title, source_reference, status FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status = '\\''active'\\'' ORDER BY title;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname = '\\''public'\\'' AND tablename = '\\''aic_embeddings'\\'' AND indexname = '\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,c.id,c.sequence_number,c.start_line,c.end_line,c.content_hash,length(c.content) AS content_length,left(c.content,180) AS content_preview FROM aic_files f JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'') ORDER BY f.path,c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U 