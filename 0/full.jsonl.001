 tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_%'\\'';\"' "],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT current_database() AS database, (SELECT count(*) FROM aic_projects) AS project_rows, (SELECT count(*) FROM aic_projects WHERE slug = '\\''strateg-ua'\\'' OR root_path = '\\''/home/kamaz/www/strateg-projects/dev.strateg.ua'\\'') AS target_rows;\"'"],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT current_user, c.relname, pg_get_userbyid(c.relowner) AS owner, has_table_privilege(current_user,c.oid,'\\''INSERT'\\'') AS can_insert, has_table_privilege(current_user,c.oid,'\\''SELECT'\\'') AS can_select, has_table_privilege(current_user,c.oid,'\\''TRIGGER'\\'') AS can_trigger FROM pg_class c WHERE c.relname IN ('\\''aic_files'\\'', '\\''aic_symbols'\\'', '\\''aic_documents'\\'', '\\''aic_knowledge_items'\\'', '\\''aic_chunks'\\'', '\\''aic_embeddings'\\'', '\\''aic_indexing_runs'\\'') ORDER BY c.relname; SELECT routine_name, grantee, privilege_type FROM information_schema.routine_privileges WHERE routine_schema='\\''public'\\'' AND routine_name='\\''aic_create_project_embedding_hnsw_index'\\'' ORDER BY grantee;\"' "],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, kind, title, content, source_reference, status, confidence FROM aic_knowledge_items WHERE project_id = '\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND sta