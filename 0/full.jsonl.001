{"timestamp":"2026-10-07T08:20:10.925Z","ordinal":11557,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0a02b-47ee-7913-b18b-d4d4b0be8b60","turn_id":"01a11568-848a-7f52-809e-ba05365e644c","item":{"type":"CommandExecution","id":"exec-4ae519d8-c467-41cf-b687-ec9448e555b3","process_id":"97676","command":["/bin/bash","-lc","sed -n '1,220p' docker-entrypoint-initdb.d/004_views_and_search_functions.sql | head -180;"],"cwd":"file:///home/kamaz/www/hobby/ai-code-intelligence","parsed_cmd":[{"type":"read","cmd":"sed -n '1,220p' docker-entrypoint-initdb.d/004_views_and_search_functions.sql | head -180;","name":"004_views_and_search_functions.sql","path":"docker-entrypoint-initdb.d/004_views_and_search_functions.sql"}],"source":"unified_exec_startup","status":"completed","stdout":"Failed to create stream fd: Operation not permitted\nFailed to create stream fd: Operation not permitted\nFailed to create stream fd: Operation not permitted\nBEGIN;\n\nCREATE OR REPLACE VIEW v_aic_code_chunks AS\nSELECT\n    c.id AS chunk_id,\n    c.project_id,\n    p.slug AS project_slug,\n    c.file_id,\n    f.path AS file_path,\n    f.language,\n    c.symbol_id,\n    s.kind AS symbol_kind,\n    s.name AS symbol_name,\n    s.qualified_name,\n    c.chunk_type,\n    c.sequence_number,\n    c.start_line,\n    c.end_line,\n    c.content,\n    c.content_hash,\n    c.token_count,\n    c.metadata,\n    c.created_at,\n    c.updated_at\nFROM aic_chunks c\nJOIN aic_projects p ON p.id = c.project_id\nJOIN aic_files f\n  ON f.project_id = c.project_id\n AND f.id = c.file_id\nLEFT JOIN aic_symbols s\n  ON s.project_id = c.project_id\n AND s.id = c.symbol_id\nWHERE c.source_type = 'code';\n\nCREATE OR REPLACE VIEW v_aic_retrieval_chunks AS\nSELECT\n    c.id AS chunk_id,\n    c.project_id,\n    p.slug AS project_slug,\n    c.source_type,\n    c.chunk_type,\n    COALESCE(f.path, d.path, d.source_uri, k.source_reference) AS source_reference,\n    s.qualified_name AS symbol_qualified_name,\n    COALESCE(d.title, k.title, s.qualified_name, s.name, f.path) AS title,\n    c.content,\n    c.content_hash,\n    c.token_count,\n    c.metadata,\n    c.search_vector,\n    c.created_at,\n    c.updated_at\nFROM aic_chunks c\nJOIN aic_projects p ON p.id = c.project_id\nLEFT JOIN aic_files f\n  ON f.project_id = c.project_id\n AND f.id = c.file_id\nLEFT JOIN aic_symbols s\n  ON s.project_id = c.project_id\n AND s.id = c.symbol_id\nLEFT JOIN aic_documents d\n  ON d.project_id = c.project_id\n AND d.id = c.document_id\nLEFT JOIN aic_knowledge_items k\n  ON k.project_id = c.project_id\n AND k.id = c.knowledge_item_id;\n\nCREATE OR REPLACE FUNCTION aic_search_chunks_text(\n    p_project_id UUID,\n    p_query TEXT,\n    p_limit INTEGER DEFAULT 20\n)\nRETURNS TABLE (\n    chunk_id UUID,\n    source_type TEXT,\n    source_reference TEXT,\n    title TEXT,\n    rank REAL,\n    content TEXT\n)\nLANGUAGE sql\nSTABLE\nAS $$\n    SELECT\n        v.chunk_id,\n        v.source_type,\n        v.source_reference,\n        v.title,\n        ts_rank_cd(v.search_vector, websearch_to_tsquery('simple', p_query)) AS rank,\n        v.content\n    FROM v_aic_retrieval_chunks v\n    WHERE v.project_id = p_project_id\n      AND v.search_vector @@ websearch_to_tsquery('simple', p_query)\n    ORDER BY rank DESC, v.chunk_id\n    LIMIT GREATEST(1, LEAST(p_limit, 200));\n$$;\n\nCREATE OR REPLACE FUNCTION aic_search_symbols_fuzzy(\n    p_project_id UUID,\n    p_query TEXT,\n    p_limit INTEGER DEFAULT 20\n)\nRETURNS TABLE (\n    symbol_id UUID,\n    file_id UUID,\n    kind TEXT,\n    name TEXT,\n    qualified_name TEXT,\n    similarity_score REAL,\n    start_line INTEGER,\n    end_line INTEGER\n)\nLANGUAGE sql\nSTABLE\nAS $$\n    SELECT\n        s.id,\n        s.file_id,\n        s.kind,\n        s.name,\n        s.qualified_name,\n        GREATEST(\n            similarity(s.name, p_query),\n            similarity(COALESCE(s.qualified_name, ''), p_query)\n        ) AS similarity_score,\n        s.start_line,\n        s.end_line\n    FROM aic_symbols s\n    WHERE s.project_id = p_project_id\n      AND (\n          s.name % p_query\n          OR COALESCE(s.qualified_name, '') % p_query\n      )\n    ORDER BY similarity_score DESC, s.name\n    LIMIT GREATEST(1, LEAST(p_limit, 200));\n$$;\n\nCREATE OR REPLACE FUNCTION aic_search_chunks_vector_exact(\n    p_project_id UUID,\n    p_embedding_model_id UUID,\n    p_query_embedding VECTOR,\n    p_limit INTEGER DEFAULT 20\n)\nRETURNS TABLE (\n    chunk_id UUID,\n    source_type TEXT,\n    source_reference TEXT,\n    title TEXT,\n    distance DOUBLE PRECISION,\n    content TEXT\n)\nLANGUAGE plpgsql\nSTABLE\nAS $$\nDECLARE\n    v_distance_metric TEXT;\n    v_dimensions INTEGER;\n    v_operator TEXT;\n    v_limit INTEGER;\nBEGIN\n    SELECT distance_metric, dimensions\n    INTO v_distance_metric, v_dimensions\n    FROM aic_embedding_models\n    WHERE id = p_embedding_model_id\n      AND enabled = TRUE;\n\n    IF NOT FOUND THEN\n        RAISE EXCEPTION 'Enabled embedding model % was not found', p_embedding_model_id;\n    END IF;\n\n    IF vector_dims(p_query_embedding) <> v_dimensions THEN\n        RAISE EXCEPTION\n            'Query vector has % dimensions, model requires %',\n            vector_dims(p_query_embedding),\n            v_dimensions;\n    END IF;\n\n    v_operator := CASE v_distance_metric\n        WHEN 'cosine' THEN '<=>'\n        WHEN 'l2' THEN '<->'\n        WHEN 'inner_product' THEN '<#>'\n","stderr":"","aggregated_output":"Failed to create stream fd: Operation not permitted\nFailed to create stream fd: Operation not permitted\nFailed to create stream fd: Operation not permitted\nBEGIN;\n\nCREATE OR REPLACE VIEW v_aic_code_chunks AS\nSELECT\n    c.id AS chunk_id,\n    c.project_id,\n    p.slug AS project_slug,\n    c.file_id,\n    f.path AS file_path,\n    f.language,\n    c.symbol_id,\n    s.kind AS symbol_kind,\n    s.name AS symbol_name,\n    s.qualified_name,\n    c.chunk_type,\n    c.sequence_number,\n    c.start_line,\n    c.end_line,\n    c.content,\n    c.content_hash,\n    c.token_count,\n    c.metadata,\n    c.created_at,\n    c.updated_at\nFROM aic_chunks c\nJOIN aic_projects p ON p.id = c.project_id\nJOIN aic_files f\n  ON f.project_id = c.project_id\n AND f.id = c.file_id\nLEFT JOIN aic_symbols s\n  ON s.project_id = c.project_id\n AND s.id = c.symbol_id\nWHERE c.source_type = 'code';\n\nCREATE OR REPLACE VIEW v_aic_retrieval_chunks AS\nSELECT\n    c.id AS chunk_id,\n    c.project_id,\n    p.slug AS project_slug,\n    c.source_type,\n    c.chunk_type,\n    COALESCE(f.path, d.path, d.source_uri, k.source_reference) AS source_reference,\n    s.qualified_name AS symbol_qualified_name,\n    COALESCE(d.title, k.title, s.qualified_name, s.name, f.path) AS title,\n    c.content,\n    c.content_hash,\n    c.token_count,\n    c.metadata,\n    c.search_vector,\n    c.created_at,\n    c.updated_at\nFROM aic_chunks c\nJOIN aic_projects p ON p.id = c.project_id\nLEFT JOIN aic_files f\n  ON f.project_id = c.project_id\n AND f.id = c.file_id\nLEFT JOIN aic_symbols s\n  ON s.project_id = c.project_id\n AND s.id = c.symbol_id\nLEFT JOIN aic_documents d\n  ON d.project_id = c.project_id\n AND d.id = c.document_id\nLEFT JOIN aic_knowledge_items k\n  ON k.project_id = c.project_id\n AND k.id = c.knowledge_item_id;\n\nCREATE OR REPLACE FUNCTION aic_search_chunks_text(\n    p_project_id UUID,\n    p_query TEXT,\n    p_limit INTEGER DEFAULT 20\n)\nRETURNS TABLE (\n    chunk_id UUID,\n    source_type TEXT,\n    source_reference TEXT,\n    title TEXT,\n    rank REAL,\n    content TEXT\n)\nLANGUAGE sql\nSTABLE\nAS $$\n    SELECT\n        v.chunk_id,\n        v.source_type,\n        v.source_reference,\n        v.title,\n        ts_rank_cd(v.search_vector, websearch_to_tsquery('simple', p_query)) AS rank,\n        v.content\n    FROM v_aic_retrieval_chunks v\n    WHERE v.project_id = p_project_id\n      AND v.search_vector @@ websearch_to_tsquery('simple', p_query)\n    ORDER BY rank DESC, v.chunk_id\n    LIMIT GREATEST(1, LEAST(p_limit, 200));\n$$;\n\nCREATE OR REPLACE FUNCTION aic_search_symbols_fuzzy(\n    p_project_id UUID,\n    p_query TEXT,\n    p_limit INTEGER DEFAULT 20\n)\nRETURNS TABLE (\n    symbol_id UUID,\n    file_id UUID,\n    kind TEXT,\n    name TEXT,\n    qualified_name TEXT,\n    similarity_score REAL,\n    start_line INTEGER,\n    end_line INTEGER\n)\nLANGUAGE sql\nSTABLE\nAS $$\n    SELECT\n        s.id,\n        s.file_id,\n        s.kind,\n        s.name,\n        s.qualified_name,\n        GREATEST(\n            similarity(s.name, p_query),\n            similarity(COALESCE(s.qualified_name, ''), p_query)\n        ) AS similarity_score,\n        s.start_line,\n        s.end_line\n    FROM aic_symbols s\n    WHERE s.project_id = p_project_id\n      AND (\n          s.name % p_query\n          OR COALESCE(s.qualified_name, '') % p_query\n      )\n    ORDER BY similarity_score DESC, s.name\n    LIMIT GREATEST(1, LEAST(p_limit, 200));\n$$;\n\nCREATE OR REPLACE FUNCTION aic_search_chunks_vector_exact(\n    p_project_id UUID,\n    p_embedding_model_id UUID,\n    p_query_embedding VECTOR,\n    p_limit INTEGER DEFAULT 20\n)\nRETURNS TABLE (\n    chunk_id UUID,\n    source_type TEXT,\n    source_reference TEXT,\n    title TEXT,\n    distance DOUBLE PRECISION,\n    content TEXT\n)\nLANGUAGE plpgsql\nSTABLE\nAS $$\nDECLARE\n    v_distance_metric TEXT;\n    v_dimensions INTEGER;\n    v_operator TEXT;\n    v_limit INTEGER;\nBEGIN\n    SELECT distance_metric, dimensions\n    INTO v_distance_metric, v_dimensions\n    FROM aic_embedding_models\n    WHERE id = p_embedding_model_id\n      AND enabled = TRUE;\n\n    IF NOT FOUND THEN\n        RAISE EXCEPTION 'Enabled embedding model % was not found', p_embedding_model_id;\n    END IF;\n\n    IF vector_dims(p_query_embedding) <> v_dimensions THEN\n        RAISE EXCEPTION\n            'Query vector has % dimensions, model requires %',\n            vector_dims(p_query_embedding),\n            v_dimensions;\n    END IF;\n\n    v_operator := CASE v_distance_metric\n        WHEN 'cosine' THEN '<=>'\n        WHEN 'l2' THEN '<->'\n        WHEN 'inner_product' THEN '<#>'\n","exit_code":0,"duration":{"secs":0,"nanos":6572},"formatted_output":"Failed to create stream fd: Operation not permitted\nFailed to create stream fd: Operation not permitted\nFailed to create stream fd: Operation not permitted\nBEGIN;\n\nCREATE OR REPLACE VIEW v_aic_code_chunks AS\nSELECT\n    c.id AS chunk_id,\n    c.project_id,\n    p.slug AS project_slug,\n    c.file_id,\n    f.path AS file_path,\n    f.language,\n    c.symbol_id,\n    s.kind AS symbol_kind,\n    s.name AS symbol_name,\n    s.qualified_name,\n    c.chunk_type,\n    c.sequence_number,\n    c.start_line,\n    c.end_line,\n    c.content,\n    c.content_hash,\n    c.token_count,\n    c.metadata,\n    c.created_at,\n    c.updated_at\nFROM aic_chunks c\nJOIN aic_projects p ON p.id = c.project_id\nJOIN aic_files f\n  ON f.project_id = c.project_id\n AND f.id = c.file_id\nLEFT JOIN aic_symbols s\n  ON s.project_id = c.project_id\n AND s.id = c.symbol_id\nWHERE c.source_type = 'code';\n\nCREATE OR REPLACE VIEW v_aic_retrieval_chunks AS\nSELECT\n    c.id AS chunk_id,\n    c.project_id,\n    p.slug AS project_slug,\n    c.source_type,\n    c.chunk_type,\n    COALESCE(f.path, d.path, d.source_uri, k.source_reference) AS source_reference,\n    s.qualified_name AS symbol_qualified_name,\n    COALESCE(d.title, k.title, s.qualified_name, s.name, f.path) AS title,\n    c.content,\n    c.content_hash,\n    c.token_count,\n    c.metadata,\n    c.search_vector,\n    c.created_at,\n    c.updated_at\nFROM aic_chunks c\nJOIN aic_projects p ON p.id = c.project_id\nLEFT JOIN aic_files f\n  ON f.project_id = c.project_id\n AND f.id = c.file_id\nLEFT JOIN aic_symbols s\n  ON s.project_id = c.project_id\n AND s.id = c.symbol_id\nLEFT JOIN aic_documents d\n  ON d.project_id = c.project_id\n AND d.id = c.document_id\nLEFT JOIN aic_knowledge_items k\n  ON k.project_id = c.project_id\n AND k.id = c.knowledge_item_id;\n\nCREATE OR REPLACE FUNCTION aic_search_chunks_text(\n    p_project_id UUID,\n    p_query TEXT,\n    p_limit INTEGER DEFAULT 20\n)\nRETURNS TABLE (\n    chunk_id UUID,\n    source_type TEXT,\n    source_reference TEXT,\n    title TEXT,\n    rank REAL,\n    content TEXT\n)\nLANGUAGE sql\nSTABLE\nAS $$\n    SELECT\n        v.chunk_id,\n        v.source_type,\n        v.source_reference,\n        v.title,\n        ts_rank_cd(v.search_vector, websearch_to_tsquery('simple', p_query)) AS rank,\n        v.content\n    FROM v_aic_retrieval_chunks v\n    WHERE v.project_id = p_project_id\n      AND v.search_vector @@ websearch_to_tsquery('simple', p_query)\n    ORDER BY rank DESC, v.chunk_id\n    LIMIT GREATEST(1, LEAST(p_limit, 200));\n$$;\n\nCREATE OR REPLACE FUNCTION aic_search_symbols_fuzzy(\n    p_project_id UUID,\n    p_query TEXT,\n    p_limit INTEGER DEFAULT 20\n)\nRETURNS TABLE (\n    symbol_id UUID,\n    file_id UUID,\n    kind TEXT,\n    name TEXT,\n    qualified_name TEXT,\n    similarity_score REAL,\n    start_line INTEGER,\n    end_line INTEGER\n)\nLANGUAGE sql\nSTABLE\nAS $$\n    SELECT\n        s.id,\n        s.file_id,\n        s.kind,\n        s.name,\n        s.qualified_name,\n        GREATEST(\n            similarity(s.name, p_query),\n            similarity(COALESCE(s.qualified_name, ''), p_query)\n        ) AS similarity_score,\n        s.start_line,\n        s.end_line\n    FROM aic_symbols s\n    WHERE s.project_id = p_project_id\n      AND (\n          s.name % p_query\n          OR COALESCE(s.qualified_name, '') % p_query\n      )\n    ORDER BY similarity_score DESC, s.name\n    LIMIT GREATEST(1, LEAST(p_limit, 200));\n$$;\n\nCREATE OR REPLACE FUNCTION aic_search_chunks_vector_exact(\n    p_project_id UUID,\n    p_embedding_model_id UUID,\n    p_query_embedding VECTOR,\n    p_limit INTEGER DEFAULT 20\n)\nRETURNS TABLE (\n    chunk_id UUID,\n    source_type TEXT,\n    source_reference TEXT,\n    title TEXT,\n    distance DOUBLE PRECISION,\n    content TEXT\n)\nLANGUAGE plpgsql\nSTABLE\nAS $$\nDECLARE\n    v_distance_metric TEXT;\n    v_dimensions INTEGER;\n    v_operator TEXT;\n    v_limit INTEGER;\nBEGIN\n    SELECT distance_metric, dimensions\n    INTO v_distance_metric, v_dimensions\n    FROM aic_embedding_models\n    WHERE id = p_embedding_model_id\n      AND enabled = TRUE;\n\n    IF NOT FOUND THEN\n        RAISE EXCEPTION 'Enabled embedding model % was not found', p_embedding_model_id;\n    END IF;\n\n    IF vector_dims(p_query_embedding) <> v_dimensions THEN\n        RAISE EXCEPTION\n            'Query vector has % dimensions, model requires %',\n            vector_dims(p_query_embedding),\n            v_dimensions;\n    END IF;\n\n    v_operator := CASE v_distance_metric\n        WHEN 'cosine' THEN '<=>'\n        WHEN 'l2' THEN '<->'\n        WHEN 'inner_product' THEN '<#>'\n"},"started_at_ms":1791361210925,"completed_at_ms":1791361210925}}
