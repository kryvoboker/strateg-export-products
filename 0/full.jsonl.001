edding batch ${b.batch} failed with status ${result.status}: ${result.error?.message||\"no diagnostic\"}`); const vectors=JSON.parse(fs.readFileSync(b.result_file,\"utf8\")); if(!Array.isArray(vectors)||vectors.length!==b.texts.length||!vectors.every(v=>Array.isArray(v)&&v.length===1536)) throw new Error(`embedding batch ${b.batch} returned invalid dimensions`); done++; if(done%8===0||done===batches.length) console.log(`completed ${done}/${batches.length}`); }'\\'''"],["/bin/bash","-lc","cd /home/kamaz/www/hobby/openclaw/projects/telegram-news && DATABASE_URL=REDACTED npm run db:generate"],["/bin/bash","-lc","cd /home/kamaz/www/hobby/openclaw/projects/telegram-news && ls -la test && echo '---' && for f in test/*.test.ts; do echo \"===== $f\"; sed -n '1,260p' \"$f\"; done"],["/bin/bash","-lc","cd /home/kamaz/www/hobby/openclaw/projects/telegram-news && rg -n \"'\\\"'|\\\"'!|\\\"'`|/''\\^|\\?\\? '\\\"'|\\b'\\\"'\" src/services/news.service.ts src/cli/crud-news.args.ts src/cli/crud-news.ts"],["/bin/bash","-lc","cd /home/kamaz/www/hobby/tb-ai-chat-2 && docker compose -f .docker/dev/docker-compose.yml exec -T tb-ai-chat-php-fpm php -m | rg -i \"xhprof|tideways\" && rg -n \"^XHPROF_ENABLED|^APP_ENV|^APP_DEBUG\" httpdocs/.env httpdocs/.env.local .docker/dev/env/* 2>/dev/null && docker compose -f .docker/dev/docker-compose.yml exec -T tb-ai-chat-postgresql psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COUNT(*) AS aitb_details_count FROM aitb_details; SELECT COUNT(*) AS details_count FROM details;\""],["/bin/bash","-lc","cd /home/kamaz/www/hobby/tb-ai-chat-2 && docker compose -f .docker/dev/docker-compose.yml exec -T tb-ai-chat-php-fpm php -r \"require 'vendor/autoload.php'; $app=require 'bootstrap/app.php'; $kernel=$app->make(Illuminate\\\\Contracts\\\\Console\\\\Kernel::class); $kernel->bootstrap(); Illuminate\\\\Support\\\\Facades\\\\DB::table('languages')->update(['is_active'=>true,'is_default'=>false]); Illuminate\\\\Support\\\\Facades\\\\DB::table('