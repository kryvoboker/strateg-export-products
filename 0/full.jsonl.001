bytes::text, '\\'''\\''), COALESCE(git_blob_sha, '\\'''\\''), is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path; SELECT id, path, title, COALESCE(content_hash, '\\'''\\'') FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST; SELECT c.source_type, COALESCE(f.path, d.path, k.source_reference), c.sequence_number, c.id, c.content_hash FROM aic_chunks c LEFT JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id LEFT JOIN aic_documents d ON d.project_id=c.project_id AND d.id=c.document_id LEFT JOIN aic_knowledge_items k ON k.project_id=c.project_id AND k.id=c.knowledge_item_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY c.source_type, 2, c.sequence_number;\"' > /tmp/pet-complaints-db-inventory.txt && wc -l /tmp/pet-complaints-db-inventory.txt"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, COALESCE(content_hash, '\\'''\\''), is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path;\"' > /tmp/pet-complaints-indexed-files.tsv && wc -l /tmp/pet-complaints-indexed-files.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, content_hash FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST;\"' > /tmp/pet-complaints-indexed-documents.tsv && wc -l /tmp/pet-complaints-indexed-documents.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, content_hash, is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path; SELECT path, content_hash FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST;\"' > /tmp/pet-complaints-final-hashes.txt"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT sequence_number, start_line, end_line, length(content), substring(content from 1 for 80), substring(content from length(content)-50 for 60) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND file_id=(SELECT id FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND path='\\''.docker/dev/docker-compose.yml'\\'') ORDER BY sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT count(*) FROM (SELECT v.chunk_id FROM aic_embeddings e JOIN v_aic_retrieval_chunks v ON v.project_id=e.project_id AND v.chunk_id=e.chunk_id WHERE e.project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid ORDER BY (e.embedding::vector(1536)) <=> (SELECT embedding::vector(1536) FROM aic_embeddings WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1) LIMIT 5) hits;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT count(*) FROM aic_search_chunks_vector_hnsw('\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid,'\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid,(SELECT embedding FROM aic_embeddings WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1),5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT id, slug FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'' AND active = TRUE\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT source_reference || E\\'\\\\t\\' || title || E\\'\\\\n\\' || left(content, 700) FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'' AND active = TRUE), '\\''UniXML google product feed identifier_exists GTIN manufacturer MPN export\\'', 8)\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"BEGIN; DELETE FROM aic_embeddings WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND chunk_id='\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid RETURNING id; DELETE FROM aic