M aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') ORDER BY started_at DESC LIMIT 8;\" -c \"SELECT kind, title, source_reference, status, confidence FROM aic_knowledge_items WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') AND status='\\''active'\\'' ORDER BY created_at DESC LIMIT 20;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_reference, title, rank FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''SiteController'\\'', 5);\" -c \"SELECT * FROM aic_search_symbols_fuzzy('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''SiteController'\\'', 5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_reference,title FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\''),'\\''cross-site'\\'',20);\"'"],["/bin/bash","-lc","docker exec clothing-store-php-fpm php -l /var/www/html/mate/scripts/bind_legacy_properties.php && docker exec clothing-store-php-fpm php /var/www/html/mate/scripts/bind_legacy_properties.php --json > /dev/null; echo exit:$?"],["/bin/bash","-lc","docker exec clothing-store-php-fpm php -l /var/www/html/mate/scripts/bind_legacy_properties.php && docker exec clothing-store-php-fpm php /var/www/html/mate/scripts/bind_legacy_properties.php --json > /tmp/bind-cart-report.json; echo exit:$?; rg -n '\"(cart|currency|customer|length|tax|user|weight)\"' /tmp/bind-cart-report.json | head -20; git diff --check"],["/bin/bash","-lc","docker exec clothing-store-php-fpm php -l /var/www/html/mate/scripts/bind_legacy_properties.php && docker exec clothing-store-php-fpm php /var/www/html/mate/scripts/bind_legacy_properties.php 