beddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND e.source_content_hash<>c.content_hash; SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_8d13a159901d_m_7f16f2a76e0e'\\''; SELECT id,status,stats FROM aic_indexing_runs WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND id='\\''b4e71e53-cb30-4df2-a614-f429e110ccf1'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT '\\''fts_hits'\\'' AS check_name,count(*)::text AS result FROM aic_search_chunks_text('\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid,'\\''OpenCart API session'\\'',5) UNION ALL SELECT '\\''hnsw_hits'\\'',count(*)::text FROM aic_search_chunks_vector_hnsw('\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid,'\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid,(SELECT embedding FROM aic_embeddings WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid ORDER BY chunk_id LIMIT 1),5); SELECT count(*) AS stale_vectors FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND e.source_content_hash<>c.content_hash;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT COUNT(*) FROM aic_files WHERE project_id=p.id AND is_deleted=FALSE) AS files,(SELECT COUNT(*) FROM aic_symbols WHERE project_id=p.id) AS symbols,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''code'\\'') AS code_chunks,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''document'\\'') AS document_chunks,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''knowledge'\\'') AS knowledge_chunks,(SELECT COUNT(*) FROM aic_embeddings WHERE project_id=p.id) AS embeddings,(SELECT COUNT(*) FROM aic_knowledge_items WHERE project_id=p.id AND status='\\''active'\\'') AS active_knowledge FROM aic_projects p WHERE p.slug='\\''office-easyfit'\\'';\" -c \"SELECT s.kind,COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT COUNT(*) AS stale_vectors FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id JOIN aic_projects p ON p.id=e.project_id WHERE p.slug='\\''office-easyfit'\\'' AND e.source_content_hash<>c.content_hash;\" -c \"SELECT f.path,f.content_hash,f.size_bytes FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''.docker/dev/docker-compose.yml'\\'','\\''.docker/dev/nginx/nginx.conf'\\'') ORDER BY f.path;\" -c \"SELECT id,status,stats FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') AND id='\\''d91cdd1a-ac7b-4031-9b09-1af10edb466c'\\'';\" -c \"SELECT COUNT(*) AS hnsw_indexes FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_7f2841b6c020_m_7f16f2a76e0e'\\'';\" -c \"SELECT source_reference,title FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\''),'\\''supplier URL rendering output safety'\\'',5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT * FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''Yii2 SiteController login authentication captcha commands yii3 bootstrap'\\'', 8);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.id,c.content_hash, count(e.id) AS embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE c.project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND c.id='\\''8ba93bac-b5b0-542f-9093-9af10e249f12'\\''::uuid GROUP BY c.id,c.content_hash;\"; test ! -e /app/embedding-results/platoshka-ua/2026/10/results/platoshka-ua-batch-0119.json && echo FAILED_BATCH_OUTPUT_ABSENT; node -e \"const fs=require(\\\"fs\\\");const p=\\\"/app/embedding-results/platoshka-ua/2026/10/embedding-results-manifest.json\\\"; const x=JSON.parse(fs.readFileSync(p)); console.log(\\\"PERSISTED_BATCHES\\\",x.length)\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.id,f.path,f.content_hash FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''.docker/dev/docker-compose.yml'\\'','\\''.docker/dev/nginx/nginx.conf'\\'') ORDER BY f.path;\" -c \"SELECT id,model_name,dimensions FROM aic_embedding_models WHERE model_name='\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.language,f.file_type,COUNT(*) FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.is_deleted=FALSE GROUP BY f.language,f.file_type ORDER BY f.language,f.file_type;\" -c \"SELECT path,language,file_type FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.is_deleted=FALSE AND language='\\''php'\\'' ORDER BY path LIMIT 8;\" -c \"SELECT s.kind,COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.size_bytes, f.indexed_at, COUNT(c.id) AS chunks, COUNT(e.id) AS embeddings FROM aic_projects p JOIN aic_files f ON f.project_id=p.id LEFT JOIN aic_chunks c ON c.project_id=p.id AND c.file_id=f.id AND c.source_type='\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id=p.id AND e.chunk_id=c.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''\\.docker/dev/docker-compose.yml'\\'','\\''\\.docker/dev/nginx/nginx.conf'\\'') GROUP BY f.path,f.content_hash,f.size_bytes,f.indexed_at ORDER BY f.path;\" -c \"SELECT s.kind, COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT d.path, d.title FROM aic_projects p JOIN aic_documents d ON d.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' ORDER BY d.path;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_7f2841b6c020_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.size_bytes, f.indexed_at, c.id AS chunk_id, c.sequence_number, c.start_line, c.end_line, c.content_hash AS chunk_hash, length(c.content) AS chars, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.chunk_id=c.id) AS vector_count FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_chunks c ON c.project_id=p.id AND c.file_id=f.id AND c.source_type='\\''code'\\'' WHERE p.slug='\\''office-easyfit'\\'' AND f.path LIKE '\\''\\.docker/dev/%'\\'' ORDER BY f.path,c.sequence_number;\" -c \"SELECT COUNT(*) AS potential_supplier_knowledge FROM aic_projects p JOIN aic_knowledge_items k ON k.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND k.status='\\''active'\\'' AND (k.title ILIKE '\\''%supplier%'\\'' OR k.content ILIKE '\\''%supplier url%'\\'');\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.id,s.kind,s.name,s.qualified_name,s.parent_symbol_id,s.start_line FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path='\\''httpdocs/models/Product.php'\\'' AND s.kind='\\''method'\\'' ORDER BY s.start_line LIMIT 25;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.id,s.kind,s.name,s.qualified_name,s.parent_symbol_id,s.start_line,s.end_line FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND s.kind IN ('\\''function'\\'','\\''class'\\'') AND f.path IN ('\\''httpdocs/controllers/ProductController.php'\\'','\\''httpdocs/globals/pl/controllers/ProductController.php'\\'','\\''httpdocs/models/Product.php'\\'') ORDER BY f.path,s.start_line LIMIT 50;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.id,s.kind,s.name,s.qualified_name,s.parent_symbol_id,s.start_line,s.end_line,s.signature FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path='\\''httpdocs/controllers/ProductController.php'\\'' ORDER BY s.start_line,s.end_line LIMIT 35;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''platoshka-ua'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, provider, model, dimensions, enabled FROM aic_embedding_models WHERE provider = '\\''openai'\\'' AND model = '\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug, root_path FROM aic_projects WHERE slug = '\\''yii3-office-easyfit'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id,name,slug,root_path,active FROM aic_projects WHERE slug = '\\''platoshka-ua'\\''; SELECT id,provider,model,dimensions,enabled FROM aic_embedding_models WHERE provider='\\''openai'\\'' AND model='\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id,provider,model,dimensions FROM aic_embedding_models WHERE model='\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id,status,stats->> '\\''chunks'\\'' AS chunks,stats->> '\\''embeddings'\\'' AS embeddings FROM aic_indexing_runs WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND id='\\''b4e71e53-cb30-4df2-a614-f429e110ccf1'\\''::uuid; SELECT count(*) AS chunks FROM aic_chunks WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid; SELECT count(*) AS vectors FROM aic_embeddings WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid; SELECT count(*) AS stale FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND e.source_content_hash<>c.content_hash;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.id,k.title,k.status,k.updated_at FROM aic_projects p JOIN aic_knowledge_items k ON k.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' ORDER BY k.title;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.title,k.status,k.source_reference,c.id AS chunk_id,length(c.content) AS chars,c.content_hash,e.dimensions,e.source_content_hash=c.content_hash AS vector_matches FROM aic_projects p JOIN aic_knowledge_items k ON k.project_id=p.id JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE p.slug='\\''office-easyfit'\\'' AND k.id='\\''534b2162-a0c7-4f93-b051-af40d063649e'\\'';\" -c \"SELECT source_reference,title FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\''),'\\''supplier'\\'',5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, p.name, p.active, (SELECT COUNT(*) FROM aic_files f WHERE f.project_id=p.id AND f.is_deleted=FALSE) AS files, (SELECT COUNT(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''code'\\'') AS code_chunks, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''document'\\'') AS document_chunks, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''knowledge'\\'') AS knowledge_chunks, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id=p.id) AS embeddings, (SELECT COUNT(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS active_knowledge FROM aic_projects p WHERE p.slug='\\''office-easyfit'\\'';\" -c \"SELECT COUNT(*) AS stale FROM aic_projects p JOIN aic_embeddings e ON e.project_id=p.id JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE p.slug='\\''office-easyfit'\\'' AND e.source_content_hash <> c.content_hash;\" -c \"SELECT id, run_type, status, started_at, stats FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') ORDER BY started_at DESC LIMIT 8;\" -c \"SELECT kind, title, source_reference, status, confidence FROM aic_knowledge_items WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') AND status='\\''active'\\'' ORDER BY created_at DESC LIMIT 20;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.name,p.slug,p.active,m.model,m.dimensions FROM aic_projects p CROSS JOIN aic_embedding_models m WHERE p.id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND m.id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid; SELECT (SELECT count(*) FROM aic_files WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND is_deleted=FALSE) AS files,(SELECT count(*) FROM aic_symbols WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid) AS symbols,(SELECT count(*) FROM aic_symbol_relations WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid) AS relations,(SELECT count(*) FROM aic_documents WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid) AS documents,(SELECT count(*) FROM aic_knowledge_items WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND status='\\''active'\\'') AS knowledge,(SELECT count(*) FROM aic_chunks WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid) AS chunks,(SELECT count(*) FROM aic_embeddings WHERE project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid AND dimensions=1536) AS vectors; SELECT count(*) AS missing_vectors FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND e.id IS NULL; SELECT count(*) AS stale_vectors FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid AND e.source_content_hash<>c.content_hash; SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_8d13a159901d_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.slug,(SELECT COUNT(*) FROM aic_files f WHERE f.project_id=p.id AND f.is_deleted=FALSE) files,(SELECT COUNT(*) FROM aic_symbols s WHERE s.project_id=p.id) symbols,(SELECT COUNT(*) FROM aic_symbol_relations r WHERE r.project_id=p.id) relations,(SELECT COUNT(*) FROM aic_indexing_runs ir WHERE ir.project_id=p.id AND ir.status='\\''running'\\'') running_runs FROM aic_projects p WHERE p.slug='\\''office-easyfit'\\'' AND p.active=TRUE;\" -c \"SELECT s.kind,COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT provider,model,dimensions FROM aic_embedding_models WHERE model='\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_reference, title, rank FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''SiteController'\\'', 5);\" -c \"SELECT * FROM aic_search_symbols_fuzzy('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''SiteController'\\'', 5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_reference, title, rank, left(content, 1200) FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\''), '\\''warehouse sorting order print TTN'\\'', 12);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_reference,title FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\''),'\\''cross-site'\\'',20);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_type,source_reference,title,rank FROM aic_search_chunks_text('\\''8d13a159-901d-5c38-b136-63f05566555e'\\''::uuid,'\\''OpenCart API session'\\'',5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'p