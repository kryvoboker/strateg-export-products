RE e.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (e.source_content_hash <> c.content_hash OR e.dimensions <> 1536); SELECT id,title,status FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\''; SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT r.id, r.status, r.started_at, r.completed_at, r.stats FROM aic_indexing_runs r WHERE r.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY r.started_at DESC LIMIT 8;\" -c \"SELECT '''files''' AS table_name, count(*) FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''symbols''', count(*) FROM aic_symbols WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''chunks''', count(*) FROM aic_chunks WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''embeddings''', count(*) FROM aic_embeddings WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''docs''', count(*) FROM aic_documents WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''knowledge''', count(*) FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT path, content_hash, is_deleted, indexed_at FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/index.vue'