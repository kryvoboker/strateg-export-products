OM aic_projects WHERE slug='\\''yii3-office-easyfit'\\'') SELECT (SELECT count(*) FROM aic_files WHERE project_id=(SELECT id FROM p)) AS files, (SELECT count(*) FROM aic_symbols WHERE project_id=(SELECT id FROM p)) AS symbols, (SELECT count(*) FROM aic_documents WHERE project_id=(SELECT id FROM p)) AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id=(SELECT id FROM p) AND status='\\''active'\\'') AS knowledge, (SELECT count(*) FROM aic_chunks WHERE project_id=(SELECT id FROM p)) AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id=(SELECT id FROM p)) AS embeddings, (SELECT status FROM aic_indexing_runs WHERE project_id=(SELECT id FROM p) ORDER BY started_at DESC LIMIT 1) AS latest_run_status;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug='\\''yii3-office-easyfit'\\''), m AS (SELECT id FROM aic_embedding_models WHERE provider='\\''openai'\\'' AND model='\\''text-embedding-3-small'\\'') SELECT (SELECT count(*) FROM aic_files WHERE project_id=(SELECT id FROM p) AND is_deleted=false) AS files, (SELECT count(*) FROM aic_symbols WHERE project_id=(SELECT id FROM p)) AS symbols, (SELECT count(*) FROM aic_symbol_relations WHERE project_id=(SELECT id FROM p)) AS relations, (SELECT count(*) FROM aic_documents WHERE project_id=(SELECT id FROM p)) AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id=(SELECT id FROM p) AND status='\\''active'\\'') AS active_knowledge, (SELECT count(*) FROM aic_chunks WHERE project_id=(SELECT id FROM p)) AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id=(SELECT id FROM p) AND embedding_model_id=(SELECT id FROM m)) AS embeddings, (SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_i