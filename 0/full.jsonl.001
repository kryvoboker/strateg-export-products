leted'\\'', finished_at=NOW(), stats='\\''{\\\"files\\\":1264,\\\"symbols\\\":4020,\\\"relations\\\":0,\\\"documents\\\":15,\\\"knowledge_items\\\":4,\\\"chunks\\\":4343,\\\"embeddings\\\":4343,\\\"stale_or_missing_embeddings\\\":0,\\\"hnsw_index\\\":true}'\\''::jsonb, metadata=metadata || jsonb_build_object('\\''verification'\\'', '\\''project/model HNSW exists; all chunk hashes match embeddings; dimensions=1536'\\'') WHERE id='\\''7b9088f3-588d-44d5-8f68-4d8d4e00d2ed'\\''::uuid AND project_id='\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid AND status='\\''running'\\'' RETURNING id,status,stats;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug='\\''yii3-office-easyfit'\\'') SELECT (SELECT count(*) FROM aic_files WHERE project_id=(SELECT id FROM p)) AS files, (SELECT count(*) FROM aic_symbols WHERE project_id=(SELECT id FROM p)) AS symbols, (SELECT count(*) FROM aic_documents WHERE project_id=(SELECT id FROM p)) AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id=(SELECT id FROM p) AND status='\\''active'\\'') AS knowledge, (SELECT count(*) FROM aic_chunks WHERE project_id=(SELECT id FROM p)) AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id=(SELECT id FROM p)) AS embeddings, (SELECT status FROM aic_indexing_runs WHERE project_id=(SELECT id FROM p) ORDER BY started_at DESC LIMIT 1) AS latest_run_status;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug='\\''yii3-office-easyfit'\\''), m AS (SELECT id FROM aic_embedding_models WHERE provider='\\''openai'\\'' AND model='\\''text-embedding-3-small'\\'') SELECT (SELECT count(*) FROM aic_files WHERE project_id=(SELECT id FROM p) AND is_deleted=false) AS files, (SELECT count(*) FROM aic_symbols WHERE project_id=(SELECT id FROM p)) AS symbols, (SELECT count(*) FROM aic_symbol_relations WHERE project_id=(SELECT id FROM p)) AS relations, (SELECT count(*) FROM aic_documents WHERE project_id=(SELECT id FROM p)) AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id=(SELECT id FROM p) AND status='\\''active'\\'') AS active_knowledge, (SELECT count(*) FROM aic_chunks WHERE project_id=(SELECT id FROM p)) AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id=(SELECT id FROM p) AND embedding_model_id=(SELECT id FROM m)) AS embeddings, (SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id=(SELECT id FROM m) WHERE c.project_id=(SELECT id FROM p) AND (e.id IS NULL OR e.source_content_hash<>c.content_hash OR e.dimensions<>1536 OR vector_dims(e.embedding)<>1536)) AS stale_or_invalid, (SELECT count(*) FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_09dfc1e0d429_m_7f16f2a76e0e'\\'') AS hnsw_index;\" -c \"SELECT run_type,status,stats FROM aic_indexing_runs WHERE id='\\''7b9088f3-588d-44d5-8f68-4d8d4e00d2ed'\\''::uuid AND project_id='\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug='\\''yii3-office-easyfit'\\''), m AS (SELECT id FROM aic_embedding_models WHERE provider='\\''openai'\\'' AND model='\\''text-embedding-3-small'\\'') SELECT (SELECT count(*) FROM aic_files WHERE project_id=(SELECT id FROM p) AND is_deleted=false) AS files, (SELECT count(*) FROM aic_symbols WHERE project_id=(SELECT id FROM p)) AS symbols, (SELECT count(*) FROM aic_symbol_relations WHERE project_id=(SELECT id FROM p)) AS relations, (SELECT count(*) FROM aic_documents WHERE project_id=(SELECT id FROM p)) AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id=(SELECT id FROM p) AND status='\\''active'\\'') AS active_knowledge, (SELECT count(*) FROM aic_chunks WHERE project_id=(SELECT id FROM p)) AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id=(SELECT id FROM p) AND embedding_model_id=(SELECT id FROM m)) AS embeddings, (SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id=(SELECT id FROM m) WHERE c.project_id=(SELECT id FROM p) AND (e.id IS NULL OR e.source_content_hash<>c.content_hash OR e.dimensions<>1536 OR vector_dims(e.embedding)<>1536)) AS stale_or_invalid, (SELECT count(*) FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_09dfc1e0d429_m_7f16f2a76e0e'\\'') AS hnsw_index;\" -c \"SELECT run_type,status,stats FROM aic_indexing_runs WHERE project_id='\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid ORDER BY started_at;\" -c \"SELECT title,source_reference FROM aic_knowledge_items WHERE project_id='\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid AND status='\\''active'\\'' ORDER BY title;\" -c \"SELECT source_type,source_reference,title,left(content,120) AS excerpt FROM aic_search_chunks_text(''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32''::uuid,''unresolved contract tests incomplete'',5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH target AS (SELECT id FROM aic_projects WHERE slug = '\\''easyfit-ua'\\