1f8ec38c${q}::uuid AND project_id=${q}7f2841b6-c020-46ef-9597-72ac54812b45${q}::uuid; COMMIT;`; fs.writeFileSync(output,sql,{mode:0o600});'\\'' /app/embedding-results/2026/10/office-easyfit-contract-test-status-20261004-batch-0000.json /tmp/office-easyfit-vector-upsert.sql; psql -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -f /tmp/office-easyfit-vector-upsert.sql >/dev/null; node -e '\\''const fs=require(\"node:fs\"); const p=\"/app/embedding-results/2026/10/office-easyfit-contract-test-status-20261004-manifest.json\"; const m=JSON.parse(fs.readFileSync(p,\"utf8\")); m.status=\"completed\"; m.batches[0].status=\"completed\"; m.completed_at=new Date().toISOString(); fs.writeFileSync(p,JSON.stringify(m,null,2)+\"\\n\");'\\'''"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'set -eu; node -e '\\''const fs=require(\"node:fs\"); const input=process.argv[1], output=process.argv[2]; const result=JSON.parse(fs.readFileSync(input,\"utf8\")); if(!Array.isArray(result)||result.length!==1||!Array.isArray(result[0])||result[0].length!==1536||!result[0].every(Number.isFinite)) throw new Error(\"invalid embedding batch\"); const vector=\"[\"+result[0].join(\",\")+\"]\"; const sql=`BEGIN; INSERT INTO aic_embeddings (project_id, chunk_id, embedding_model_id, dimensions, embedding, source_content_hash) VALUES (\\0477f2841b6-c020-46ef-9597-72ac54812b45\\047::uuid, \\047f4c346cb-a86c-415b-9099-e2edb584df80\\047::uuid, \\0477f16f2a7-6e0e-4fd8-9dd6-31f981768774\\047::uuid, 1536, \\047${vector}\\047::vector, \\047803481f00efa8d544615896ef058245f8fe28276944d582cf00c362429a3ddf3\\047) ON CONFLICT (chunk_id, embedding_model_id) DO UPDATE SET dimensions=EXCLUDED.dimensions, embedding=EXCLUDED.embedding, source_content_hash=EXCLUDED.source_content_hash, updated_at=NOW() WHERE aic_embeddings.project_id=EXCLUDED.project_id; UPDATE aic_indexing_runs SET 