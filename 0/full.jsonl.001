(\"/tmp/biome-diagnostics.json\",\"utf8\"));const grouped=new Map();for(const d of x.diagnostics??[]){if(!d.category?.includes(\"noUnused\"))continue;const key=`${d.location.path}:${d.location.start.line}`;if(!grouped.has(key))grouped.set(key,{path:d.location.path,line:d.location.start.line,rules:new Set()});grouped.get(key).rules.add(d.category.split(\"/\").pop())}const files=new Map();for(const item of grouped.values()){if(!files.has(item.path))files.set(item.path,[]);files.get(item.path).push(item)}for(const [path,items] of files){const lines=fs.readFileSync(path,\"utf8\").split(/\\n/);for(const item of items.sort((a,b)=>b.line-a.line)){const comments=[...item.rules].map(rule=>`// biome-ignore lint/correctness/${rule}: Referenced from the Vue template.`);lines.splice(item.line-1,0,...comments)}fs.writeFileSync(path,lines.join(\"\\n\"))}console.log(`Added ${grouped.size} targeted suppressions across ${files.size} Vue files.`)'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && node -e '\\''const fs=require(\"fs\");const x=JSON.parse(fs.readFileSync(\"/tmp/biome-diagnostics.json\",\"utf8\"));const seen=new Set();for(const d of x.diagnostics??[]){if(!d.category?.includes(\"noUnused\"))continue;const p=d.location.path,n=d.location.start.line,s=fs.readFileSync(p,\"utf8\").split(/\\n/)[n-1];const key=p+\":\"+n;if(seen.has(key))continue;seen.add(key);const m=s.match(/(?:const|function|import)\\s+(?:\\{\\s*)?([\\w$]+)/);const name=m?.[1]??\"?\";const tpl=fs.readFileSync(p,\"utf8\").split(/<template[^>]*>/)[1]?.split(/<\\/template>/)[0]??\"\";console.log(`${key} ${name} template=${new RegExp(`\\\\b${name}\\\\b`).test(tpl)} | ${s.trim()}`)}'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && node -e '\\''const fs=require(\"fs\");const x=JSON.parse(fs.readFileSync(\"/tmp/biome-diagnostics.json\",\"utf8\"));for(const d of x.diagnostics??[]){if(!d.category?.includes(\"noUnused\"))continue;const p=d.location.path,s=fs.readFileSync(p,\"utf8\");const at=d.location.start;const line=s.split(/\\n/)[at.line-1];const col=at.column-1;const token=line.slice(col,d.location.end.column-1);const tpl=s.split(/<template[^>]*>/)[1]?.split(/<\\/template>/)[0]??\"\";console.log(`${p}:${at.line} ${d.category.split(\"/\").pop()} ${token} template=${tpl.includes(token)}`)}'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && node -e '\\''const fs=require(\"fs\");const x=JSON.parse(fs.readFileSync(\"/tmp/biome-diagnostics.json\",\"utf8\"));for(const d of x.diagnostics??[]){if(d.category?.includes(\"noUnused\")){const p=d.location.path;const n=d.location.start.line;const s=fs.readFileSync(p,\"utf8\").split(/\\n/)[n-1];console.log(`${p}:${n}: ${d.category.split(\"/\").pop()}: ${s.trim()}`)}}'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && node -e '\\''const fs=require(\"fs\");const {parse,compileTemplate}=require(\"@vue/compiler-sfc\");const filename=\"app/components/AppHeader.vue\";const source=fs.readFileSync(filename,\"utf8\");const parsed=parse(source,{filename});console.log(parsed.errors);const result=compileTemplate({source:parsed.descriptor.template.content,filename,id:\"test\"});console.log(result.errors);'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && node -e '\\''const fs=require(\"fs\");const {parse}=require(\"@vue/compiler-sfc\");const filename=\"app/components/AppHeader.vue\";const result=parse(fs.readFileSync(filename,\"utf8\"),{filename});console.log(result.errors.map(({message,loc})=>({message,line:loc.start.line,column:loc.start.column,source:loc.source})));'\\'''"],["/bin/bash","-lc",