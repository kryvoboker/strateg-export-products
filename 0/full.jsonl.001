sh, f.file_type, count(s.id) AS symbols FROM aic_files f LEFT JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path LIKE '\\''httpdocs/frontend/app/%'\\'' GROUP BY f.path,f.content_hash,f.file_type ORDER BY f.path;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT id,kind,title,source_reference,status,left(content,320) FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status='\\''active'\\'' ORDER BY title;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT s.id,s.kind,s.name,s.qualified_name,s.start_line,s.end_line,s.is_exported,s.content_hash FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path='\\''httpdocs/frontend/app/utils/helpers.ts'\\'' ORDER BY start_line;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT n.nspname || '\\''.'\\'' || p.proname || '\\''('   || pg_get_function_identity_arguments(p.oid) || '\\'')'\\'' FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE p.proname ILIKE '\\''%search%\\'' ORDER BY 1;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -Atqc \"SELECT id, slug FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT * FROM search_chunks_text('\\''3c7f07bd-bcb6-4516-908e-bc0fc8eb52cf'\\'', '\\''date_modified easyfit_sitemap'\\'', 10