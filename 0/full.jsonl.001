OM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' GROUP BY relation_type ORDER BY relation_type; SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%hnsw%9da19a96c510%7f16f2a76e0e%\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT (SELECT count(*) FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT is_deleted) AS files, (SELECT count(*) FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status='\\''active'\\'') AS knowledge, (SELECT count(*) FROM aic_symbols WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS symbols, (SELECT count(*) FROM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS relations, (SELECT count(*) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS embeddings, (SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' AND e.source_content_hash=c.content_hash WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL) AS missing_embeddings; SELECT relation_type,count(*) FROM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' GROUP BY relation_type ORDER BY relation_type;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT f.path, f.content_ha