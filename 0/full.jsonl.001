\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid,(SELECT embedding FROM aic_embeddings WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1),5); SELECT id,status,finished_at,stats FROM aic_indexing_runs WHERE id='\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) FILTER (WHERE kind='\\''method'\\'' AND qualified_name IS NOT NULL) AS misleading_method_fqns FROM aic_symbols WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT indexname, indexdef FROM pg_indexes WHERE schemaname = current_schema() AND indexname = '\\''aic_emb_hnsw_p_a05ac957939f_m_7f16f2a76e0e'\\''; SELECT COUNT(*) AS embeddings, COUNT(*) FILTER (WHERE dimensions <> 1536) AS wrong_dimensions, COUNT(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid; SELECT COUNT(*) AS unmatched_chunks FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.id IS NULL; SELECT COUNT(*) AS persisted_result_batches FROM aic_indexing_runs r, jsonb_array_elements(r.metadata->'embedding_batches') AS batch WHERE r.id = '\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_schema,table_name FROM information_schema.views WHERE table_name ILIKE '\\''%retrieval%'\\'' OR table_name ILIKE '\\''%chunk%'\\'' ORDER BY table_schema,table_name; SELECT to_regclass('\\''v_retrieval_chunks'\\'') AS resolved_view; SELECT id,status,finished_at,stats FROM aic_indexing_runs WHERE id='\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS method_symbols_with_fqn FROM aic_symbols WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND kind='\\''method'\\'' AND qualified_name IS NOT NULL;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET stats = jsonb_build_object('\\''planned_files'\\'',376,'\\''planned_code_files'\\'',355,'\\''planned_symbols'\\'',1918,'\\''planned_documents'\\'',21,'\\''planned_knowledge_items'\\'',6,'\\''planned_chunks'\\'',1028), metadata = metadata || jsonb_build_object('\\''embedding_script'\\'', '\\''/app/embedding.js'\\'', '\\''chunk_limit_chars'\\'',4000) WHERE id = '\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status = '\\''running'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_symbols SET qualified_name = NULL WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND kind='\\''method'\\''; UPDATE aic_indexing_runs SET status='\\''completed'\\'', finished_at=NOW(), stats=jsonb_build_object('\\''files'\\'',355,'\\''symbols'\\'',1918,'\\''symbol_relations'\\'',0,'\\''documents'\\'',21,'\\''active_knowledge_items'\\'',6,'\\''chunks'\\'',1028,'\\''embeddings'\\'',1028,'\\''stale_embeddings'\\'',0,'\\''embedding_dimensions'\\'',1536,'\\''embedding_batches'\\'',65,'\\''hnsw_index'\\'', '\\''aic_emb_hnsw_p_a05ac957939f_m_7f16f2a76e0e'\\''), metadata=metadata || jsonb_build_object('\\''embedding_script'\\'', '\\''/app/embedding.js'\\'', '\\''embedding_model'\\'', '\\''text-embedding-3-small'\\'', '\\''embedding_results_path'\\'', '\\''/home/kamaz/www/hobby/ai-code-intelligence/app/embedding-results/strateg-export-products/2026/10/'\\'', '\\''manifest_path'\\'', '\\''manifest.json'\\'', '\\''parser_fallback'\\'', '\\''ast-grep declarations; Tree-sitter batch traversal segfaulted'\\'', '\\''symbol_relations_populated'\\'',false,'\\''unindexed_stale_ai_guide'\\'', '\\''docs/ai-code-intelligence.md excluded because its old project-index counts and root path were stale'\\'', '\\''limitations'\\'', jsonb_build_array('\\''No symbol relations were extracted'\\'', '\\''Method symbol qualified names intentionally left NULL because containing-class names were not reconstructed'\\'', '\\''PostgreSQL FTS ignores individual words longer than 2047 characters'\\'')) WHERE id='\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status='\\''running'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -c \"SELECT aic_create_project_embedding_hnsw_index('\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid, '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"COPY (SELECT f.path,s.id::text,s.kind,s.name,COALESCE(s.qualified_name,''''),COALESCE(s.signature,''''),COALESCE(s.parent_symbol_id::text,''''),COALESCE(s.start_line,0),COALESCE(s.end_line,0) FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND p.active=TRUE AND f.is_deleted=FALSE ORDER BY f.path,s.start_line,s.id) TO STDOUT WITH (FORMAT csv, HEADER true);\"' > /tmp/office-easyfit-symbols.csv"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT COUNT(*) FROM aic_files WHERE project_id=p.id AND is_deleted=FALSE) AS files,(SELECT COUNT(*) FROM aic_symbols WHERE project_id=p.id) AS symbols,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''code'\\'') AS code_chunks,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''document'\\'') AS document_chunks,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''knowledge'\\'') AS knowledge_chunks,(SELECT COUNT(*) FROM aic_embeddings WHERE project_id=p.id) AS embeddings,(SELECT COUNT(*) FROM aic_knowledge_items WHERE project_id=p.id AND status='\\''active'\\'') AS active_knowledge FROM aic_projects p WHERE p.slug='\\''office-easyfit'\\'';\" -c \"SELECT s.kind,COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT COUNT(*) AS stale_vectors FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id JOIN aic_projects p ON p.id=e.project_id WHERE p.slug='\\''office-easyfit'\\'' AND e.source_content_hash<>c.content_hash;\" -c \"SELECT f.path,f.content_hash,f.size_bytes FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''.docker/dev/docker-compose.yml'\\'','\\''.docker/dev/nginx/nginx.conf'\\'') ORDER BY f.path;\" -c \"SELECT id,status,stats FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') AND id='\\''d91cdd1a-ac7b-4031-9b09-1af10edb466c'\\'';\" -c \"SELECT COUNT(*) AS hnsw_indexes FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_7f2841b6c020_m_7f16f2a76e0e'\\'';\" -c \"SELECT source_reference,title FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\''),'\\''supplier URL rendering output safety'\\'',5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT * FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''Yii2 SiteController login authentication captcha commands yii3 bootstrap'\\'', 8);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.id,f.path,f.content_hash FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''.docker/dev/docker-compose.yml'\\'','\\''.docker/dev/nginx/nginx.conf'\\'') ORDER BY f.path;\" -c \"SELECT id,model_name,dimensions FROM aic_embedding_models WHERE model_name='\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.language,f.file_type,COUNT(*) FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.is_deleted=FALSE GROUP BY f.language,f.file_type ORDER BY f.language,f.file_type;\" -c \"SELECT path,language,file_type FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.is_deleted=FALSE AND language='\\''php'\\'' ORDER BY path LIMIT 8;\" -c \"SELECT s.kind,COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.size_bytes, f.indexed_at, COUNT(c.id) AS chunks, COUNT(e.id) AS embeddings FROM aic_projects p JOIN aic_files f ON f.project_id=p.id LEFT JOIN aic_chunks c ON c.project_id=p.id AND c.file_id=f.id AND c.source_type='\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id=p.id AND e.chunk_id=c.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''\\.docker/dev/docker-compose.yml'\\'','\\''\\.docker/dev/nginx/nginx.conf'\\'') GROUP BY f.path,f.content_hash,f.size_bytes,f.indexed_at ORDER BY f.path;\" -c \"SELECT s.kind, COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT d.path, d.title FROM aic_projects p JOIN aic_documents d ON d.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' ORDER BY d.path;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_7f2841b6c020_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.size_bytes, f.indexed_at, c.id AS chunk_id, c.sequence_number, c.start_line, c.end_line, c.content_hash AS chunk_hash, length(c.content) AS chars, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.chunk_id=c.id) AS vector_count FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_chunks c ON c.project_id=p.id AND c.file_id=f.id AND c.source_type='\\''code'\\'' WHERE p.slug='\\''office-easyfit'\\'' AND f.path LIKE '\\''\\.docker/dev/%'\\