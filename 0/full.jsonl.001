'stale_embeddings'', 0, ''symbol_relations'', 0), metadata=metadata || jsonb_build_object(''completed_at'', NOW(), ''embedding_manifest'', ''/home/kamaz/www/hobby/ai-code-intelligence/app/embedding-results/pet-complaints-platform/2026/10/pet-complaints-platform-d099058c-e63c-42a5-8082-6c6080b787fd-manifest.json'', ''hnsw_index_verified'', ''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'', ''relations_populated'', false, ''serena_symbol_cache_refreshed'', false, ''parser_fallback'', ''Tree-sitter Vue root passed; recursive traversal segfaulted; 80-line/12k-character source chunks used'' ) WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND id='\\''d099058c-e63c-42a5-8082-6c6080b787fd'\\''::uuid AND status='\\''running'\\'' RETURNING id, status, finished_at, stats;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'', finished_at=NOW(), stats='\\''{\\\"files\\\":1264,\\\"symbols\\\":4020,\\\"relations\\\":0,\\\"documents\\\":15,\\\"knowledge_items\\\":4,\\\"chunks\\\":4343,\\\"embeddings\\\":4343,\\\"stale_or_missing_embeddings\\\":0,\\\"hnsw_index\\\":true}'\\''::jsonb, metadata=metadata || jsonb_build_object('\\''verification'\\'', '\\''project/model HNSW exists; all chunk hashes match embeddings; dimensions=1536'\\'') WHERE id='\\''7b9088f3-588d-44d5-8f68-4d8d4e00d2ed'\\''::uuid AND project_id='\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid AND status='\\''running'\\'' RETURNING id,status,stats;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FR