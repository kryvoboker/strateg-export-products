'\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS chunks, (SELECT COUNT(*) FROM aic_embeddings WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid) AS embeddings, (SELECT COUNT(*) FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid AND e.source_content_hash <> c.content_hash) AS stale_embeddings; SELECT COUNT(*) AS symbol_relations FROM aic_symbol_relations WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT id,status,stats FROM aic_indexing_runs WHERE id = '\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT COUNT(*) FROM aic_files WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND is_deleted=FALSE) AS files,(SELECT COUNT(*) FROM aic_symbols WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS symbols,(SELECT COUNT(*) FROM aic_documents WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS documents,(SELECT COUNT(*) FROM aic_knowledge_items WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status='\\''active'\\'') AS knowledge,(SELECT COUNT(*) FROM aic_chunks WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS chunks,(SELECT COUNT(*) FROM aic_embeddings WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid) AS embeddings,(SELECT COUNT(*) FROM aic_symbol_relations WHERE project_id='\\''a05