e.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'if [ -n \"$OPENAI_API_KEY\" ]; then printf \"OPENAI_API_KEY is configured\\n\"; else printf \"OPENAI_API_KEY is missing\\n\"; fi; psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT provider, model, dimensions, enabled FROM aic_embedding_models WHERE provider = '\\''openai'\\'' AND model = '\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -At -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT status FROM aic_indexing_runs WHERE id='\\''44f782c7-d534-4d21-8772-f20d01add878'\\''\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -At -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT status||E\\''\\t'\\''||stats->>\\''embeddings'\\'' FROM aic_indexing_runs WHERE id='\\''44f782c7-d534-4d21-8772-f20d01add878'\\''\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT count(*) FROM aic_symbol_relations) AS all_relations,(SELECT count(*) FROM aic_symbol_relations WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'') AS strateg_ua_relations,(SELECT count(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'') AS strateg_ua_symbols; SELECT p.slug,count(r.id) AS relations FROM aic_projects p LEFT JOIN aic_symbol_relations r ON r.project_id=p.id GROUP BY p.slug HAVING count(r.id)>0 ORDER BY relations DESC LIMIT 10;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.language,s.kind,count(*) FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY f.language,s.kind ORDER BY f.language,s.kind;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND (s.name IN ('\\''BaseService'\\'','\\''HttpException'\\'','\\''ToolInterface'\\'','\\''ProductSearchProviderInterface'\\'') OR s.qualified_name ILIKE '\\''%BaseService'\\'') ORDER BY s.name LIMIT 25;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name,s.start_line,s.start_column,s.end_line,s.end_column FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND s.kind IN ('\\''class'\\'','\\''method'\\'','\\''function'\\'','\\''interface'\\'','\\''trait'\\'') ORDER BY f.path,s.start_line LIMIT 12;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT kind,count(*) AS symbols FROM aic_symbols GROUP BY kind ORDER BY symbols DESC; SELECT p.slug,s.kind,count(*) AS symbols FROM aic_symbols s JOIN aic_projects p ON p.id=s.project_id WHERE s.kind IN ('\\''module'\\'','\\''file'\\'','\\''namespace'\\'') GROUP BY p.slug,s.kind ORDER BY p.slug,s.kind;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT language,COUNT(*) FROM aic_files WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND is_deleted=FALSE GROUP BY language ORDER BY COUNT(*) DESC; SELECT kind,COUNT(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY kind ORDER BY COUNT(*) DESC; SELECT run_type,status,COUNT(*) FROM aic_indexing_runs WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY run_type,status ORDER BY run_type,status;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE conname = '\\''indexing_runs_type_valid'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT relation_type, count(*) AS total, count(target_symbol_id) AS resolved, count(*) FILTER (WHERE target_symbol_id IS NULL) AS unresolved FROM aic_symbol_relations WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY relation_type ORDER BY relation_type; SELECT count(*) AS total_relations, count(*) FILTER (WHERE evidence IS NULL OR evidence = '\\''{}'\\''::jsonb) AS missing_evidence, count(*) FILTER (WHERE source_line < 1) AS invalid_lines, count(*) FILTER (WHERE target_symbol_id IS NOT NULL AND source.project_id <> target.project_id) AS cross_project_targets FROM aic_symbol_relations r JOIN aic_symbols source ON source.id=r.source_symbol_id LEFT JOIN aic_symbols target ON target.id=r.target_symbol_id WHERE r.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\''; SELECT kind,count(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND kind='\\''module'\\'' GROUP BY kind; SELECT id,run_type,status,stats FROM aic_indexing_runs WHERE id='\\''afe788a3-466d-4c16-b81e-4d1c34f4a109'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,data_type FROM information_schema.columns WHERE table_name='\\''aic_indexing_runs'\\'' ORDER BY ordinal_position\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,data_type,udt_name,is_nullable FROM information_schema.columns WHERE table_name = '\\''aic_embeddings'\\'' ORDER BY ordinal_position\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -q -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"COPY (SELECT f.path,f.id AS file_id,f.language,f.content_hash,s.id AS symbol_id,s.kind,s.name,s.qualified_name,s.start_line,s.start_column,s.end_line,s.end_column,s.parent_symbol_id FROM aic_files f LEFT JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND f.is_deleted=FALSE ORDER BY f.path,s.start_line) TO STDOUT WITH CSV HEADER\"' > /tmp/strategua_aic_symbols.csv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -q -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"COPY (SELECT f.path,f.id AS file_id,f.language,s.id AS symbol_id,s.kind,s.name,s.qualified_name,s.start_line,s.start_column,s.end_line,s.end_column,s.parent_symbol_id FROM aic_files f LEFT JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND f.is_deleted=FALSE ORDER BY f.path,s.start_line) TO STDOUT WITH CSV HEADER\"' > /tmp/strategua_aic_symbols.csv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"$1\"' sh \"UPDATE aic_indexing_runs SET stats=stats || '{\\\"parser_fallback\\\":\\\"Tree-sitter batch traversal segfaulted; AST call extraction used ast-grep PHP structural queries instead.\\\"}'::jsonb WHERE project_id='9cb2ac9e-7047-4353-812c-35ecbb51289f' AND id='c59a80f2-855e-4c13-88fa-5909b42a4f03' RETURNING id,status,stats->>'parser_fallback' AS parser_fallback;\""],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -F \"$(printf '\\''\\t'\\'')\" -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT s.id, s.file_id, f.path, f.language, s.kind, s.name, COALESCE(s.qualified_name, '\\'' '\\''), s.start_line, s.end_line FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT f.is_deleted ORDER BY f.path, s.start_line, s.end_line;\"' > /tmp/pet-aic-symbols.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -F \"$(printf '\\''\\t'\\'')\" -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT s.id, s.parent_symbol_id, s.file_id, f.path, f.language, s.kind, s.name, COALESCE(s.qualified_name, '\\'' '\\''), s.start_line, s.end_line FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT f.is_deleted ORDER BY f.path, s.start_line, s.end_line;\"' > /tmp/pet-aic-symbols.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -F \"$(printf '\\''\\t'\\'')\" -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT s.kind, s.name, s.qualified_name, parent.name AS parent FROM aic_symbols s LEFT JOIN aic_symbols parent ON parent.project_id=s.project_id AND parent.id=s.parent_symbol_id WHERE s.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND s.name IN ('\\''handle'\\'', '\\''query'\\'', '\\''CreateComplaint'\\'') LIMIT 25;\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COALESCE(path, '\\''\\''), content_hash FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST, title;\"' > /tmp/pet-complaints-indexed-documents.tsv && wc -l /tmp/pet-complaints-indexed-documents.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.sequence_number, c.start_line, c.end_line, length(c.content), c.content_hash FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path IN ('\\''httpdocs/frontend/openapi/openapi.yaml'\\'', '\\''httpdocs/frontend/app/pages/complaints/create.vue'\\'') ORDER BY f.path, c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.start_line, c.end_line, length(c.content), c.content_hash, encode(digest(c.content,'\\''sha256'\\''),'\\''hex'\\''), left(c.content,80), right(c.content,80) FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''.docker/dev/docker-compose.yml'\\'' ORDER BY c.sequence_number LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, path, file_type, COALESCE(language, '\\'''\\''), COALESCE(content_hash, '\\'''\\''), COALESCE(size_bytes::text, '\\'''\\''), COALESCE(git_blob_sha, '\\'''\\''), is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path; SELECT id, path, title, COALESCE(content_hash, '\\'''\\'') FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST; SELECT c.source_type, COALESCE(f.path, d.path, k.source_reference), c.sequence_number, c.id, c.content_hash FROM aic_chunks c LEFT JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id LEFT JOIN aic_documents d ON d.project_id=c.project_id AND d.id=c.document_id LEFT JOIN aic_knowledge_items k ON k.project_id=c.project_id AND k.id=c.knowledge_item_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY c.source_type, 2, c.sequence_number;\"' > /tmp/pet-complaints-db-inventory.txt && wc -l /tmp/pet-complaints-db-inventory.txt"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, COALESCE(content_hash, '\\'''\\''), is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path;\"' > /tmp/pet-complaints-indexed-files.tsv && wc -l /tmp/pet-complaints-indexed-files.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, content_hash FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST;\"' > /tmp/pet-complaints-indexed-documents.tsv && wc -l /tmp/pet-complaints-indexed-documents.tsv"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, content_hash, is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path; SELECT path, content_hash FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST;\"' > /tmp/pet-complaints-final-hashes.txt"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT sequence_number, start_line, end_line, length(content), substring(content from 1 for 80), substring(content from length(content)-50 for 60) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND file_id=(SELECT id FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND path='\\''.docker/dev/docker-compose.yml'\\'') ORDER BY sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT count(*) FROM (SELECT v.chunk_id FROM aic_embeddings e JOIN v_aic_retrieval_chunks v ON v.project_id=e.project_id AND v.chunk_id=e.chunk_id WHERE e.project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid ORDER BY (e.embedding::vector(1536)) <=> (SELECT embedding::vector(1536) FROM aic_embeddings WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1) LIMIT 5) hits;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -A -t -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT count(*) FROM aic_search_chunks_vector_hnsw('\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid,'\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid,(SELECT embedding FROM aic_embeddings WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1),5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT id, slug FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'' AND active = TRUE\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT source_reference || E\\'\\\\t\\' || title || E\\'\\\\n\\' || left(content, 700) FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'' AND active = TRUE), '\\''UniXML google product feed identifier_exists GTIN manufacturer MPN export\\'', 8)\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"BEGIN; DELETE FROM aic_embeddings WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND chunk_id='\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid RETURNING id; DELETE FROM aic_chunks WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid RETURNING id; DELETE FROM aic_knowledge_items WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid RETURNING id; DELETE FROM aic_indexing_runs WHERE project_id='\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND id='\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\''::uuid RETURNING id; COMMIT;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"BEGIN; INSERT INTO aic_indexing_runs (id, project_id, run_type, status, stats, metadata) VALUES ('\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''knowledge'\\'', '\\''running'\\'', '\\''{}'\\''::jsonb, jsonb_build_object('\\''source'\\'', '\\''docs/testing.md'\\'')); INSERT INTO aic_knowledge_items (id, project_id, kind, title, content, source_reference, status, confidence, metadata) VALUES ('\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''testing'\\'', '\\''Unresolved contract tests and coverage status'\\'', '\\''Testing contract status: OrderUpdateContractTodoCest, OrderLedgerRouteContractTodoCest, and MonomarketImportContractTodoCest are intentionally incomplete markers, not passing behavioral tests. Replace them with assertions after clarifying the order update HTTP contract (status log, composite products, draft edit); shipped-order ledger route side effects and concurrency; and Monomarket import payload schema, malformed-row handling, rollback, and recovery. The documented full Codeception run reports three incomplete contract TODOs; do not count them as completed coverage.'\\'', '\\''docs/testing.md; httpdocs/tests/functional/*ContractTodoCest.php'\\'', '\\''active'\\'', 0.99, jsonb_build_object('\\''indexing_run_id'\\'', '\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\'')); INSERT INTO aic_chunks (id, project_id, source_type, knowledge_item_id, chunk_type, sequence_number, content, content_hash, token_count, metadata) VALUES ('\\''f4c346cb-a86c-415b-9099-e2edb584df80'\\''::uuid, '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid, '\\''knowledge'\\'', '\\''e0ca6e2b-e7e4-48e8-ac02-411e3379bd2a'\\''::uuid, '\\''knowledge'\\'', 0, '\\''Testing contract status: OrderUpdateContractTodoCest, OrderLedgerRouteContractTodoCest, and MonomarketImportContractTodoCest are intentionally incomplete markers, not passing behavioral tests. Replace them with assertions after clarifying the order update HTTP contract (status log, composite products, draft edit); shipped-order ledger route side effects and concurrency; and Monomarket import payload schema, malformed-row handling, rollback, and recovery. The documented full Codeception run reports three incomplete contract TODOs; do not count them as completed coverage.'\\'', '\\''803481f00efa8d544615896ef058245f8fe28276944d582cf00c362429a3ddf3'\\'', 83, jsonb_build_object('\\''indexing_run_id'\\'', '\\''dd03c1f6-d128-46ab-a42b-345d1f8ec38c'\\'')); COMMIT;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_indexing_runs (project_id, run_type, status, git_commit, metadata) VALUES ('\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid, '\\''full'\\'', '\\''running'\\'', '\\''445141aceedb750c0deb717878d901e5c5d8c5f5'\\'', jsonb_build_object('\\''chunking'\\'', '\\''line fallback 240 lines/9500 chars'\\'', '\\''symbol_source'\\'', '\\''Serena PHP LSP'\\'', '\\''tree_sitter_fallback'\\'', '\\''batch segfault'\\'')) RETURNING id, project_id, status;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_indexing_runs (project_id,run_type,status,finished_at,stats,metadata) VALUES ('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid,'\\''incremental'\\'','\\''completed'\\'',NOW(),'{\\\"files\\\":7,\\\"chunks\\\":15,\\\"embeddings\\\":15,\\\"knowledge_items_updated\\\":1}', '{\\\"scope\\\":\\\"homepage UI, demo seeder, API test, frontend guidelines\\\",\\\"chunking\\\":\\\"80-line fallback\\\",\\\"structural_symbols_refreshed\\\":false}');\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_projects (name, slug, root_path, repository_url, default_branch, metadata) VALUES ('\\''Strateg Export Products'\\'', '\\''strateg-export-products'\\'', '\\''/home/kamaz/www/strateg-projects/strateg-export-products'\\'', '\\''git@github.com:kryvoboker/strateg-export-products.git'\\'', '\\''main'\\'', jsonb_build_object('\\''indexed_checkout_branch'\\'', '\\''dev/sync-prods'\\'')) RETURNING id, name, slug, root_path, active;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_projects (name, slug, root_path, repository_url, default_branch, metadata) VALUES ('\\''Yii3 Office Easyfit'\\'', '\\''yii3-office-easyfit'\\'', '\\''/home/kamaz/www/easyfit-projects/yii3-office.easyfit.com.ua'\\'', '\\''git@github.com:kryvoboker/yii3-office-easyfit.com.ua.git'\\'', '\\''main'\\'', jsonb_build_object('\\''created_for'\\'', '\\''current Yii3 Office Easyfit checkout'\\'')) RETURNING id, name, slug, root_path, active;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_projects (name, slug, root_path, repository_url, metadata) VALUES ('\\''Easyfit UA'\\'', '\\''easyfit-ua'\\'', '\\''/home/kamaz/www/easyfit-projects/easyfit.com.ua/httpdocs'\\'', '\\''git@github.com:EasyFit-global/easyfit-com-ua.git'\\'', jsonb_build_object('\\''source_submodule'\\'', '\\''httpdocs'\\'', '\\''git_commit'\\'', '\\''445141aceedb750c0deb717878d901e5c5d8c5f5'\\'')) RETURNING id, slug, root_path;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT count(*) FROM aic_files WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND is_deleted = false) AS files, (SELECT count(*) FROM aic_symbols WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid) AS symbols, (SELECT count(*) FROM aic_symbol_relations WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid) AS relations, (SELECT count(*) FROM aic_documents WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid) AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND status = '\\''active'\\'') AS active_knowledge, (SELECT count(*) FROM aic_chunks WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid) AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid) AS embeddings;\" -c \"SELECT id, name, provider, model, dimensions, enabled FROM aic_embedding_models ORDER BY model;\" -c \"SELECT id, status, started_at, completed_at, stats FROM aic_indexing_runs WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid ORDER BY started_at DESC LIMIT 5;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT count(*) FROM aic_files WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid) AS files, (SELECT count(*) FROM aic_symbols WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid) AS symbols, (SELECT count(*) FROM aic_documents WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid) AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid) AS knowledge, (SELECT count(*) FROM aic_chunks WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid) AS chunks; SELECT id,status,error_message FROM aic_indexing_runs WHERE id='\\''eec76587-38a0-4e2a-af2b-68f7c5c5ed9f'\\''::uuid AND project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT * FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''Yii2 Yii3 migration authentication inventory order product routing'\\'', 8);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT * FROM aic_search_chunks_text('\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'', '\\''store setting config telephone localized language contacts footer menu'\\'', 8);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COUNT(*) AS total_relations, COUNT(DISTINCT source_symbol_id) AS source_symbols, COUNT(target_symbol_id) AS resolved_targets, COUNT(*) FILTER (WHERE target_symbol_id IS NULL) AS unresolved_targets, COUNT(*) FILTER (WHERE evidence ? '\\''snippet'\\'') AS snippet_fields_remaining, COUNT(*) FILTER (WHERE evidence->>'\\''evidence_kind'\\'' = '\\''ast_grep_match'\\'') AS verified_ast_evidence FROM aic_symbol_relations WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid;\" -c \"SELECT relation_type, COUNT(*) AS edge_count FROM aic_symbol_relations WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid GROUP BY relation_type ORDER BY relation_type;\" -c \"SELECT status, stats->>'\\''relations_inserted'\\'' AS run_relations, stats->>'\\''unassigned_ast_match_count'\\'' AS unassigned_matches FROM aic_indexing_runs WHERE id = '\\''dbe373a7-2de4-4599-8ea0-14c869ad7626'\\''::uuid AND project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid;\" -c \"SELECT COUNT(*) AS outgoing_graph_walk_edges FROM aic_symbol_relations_walk('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, (SELECT s.id FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''httpdocs/backend/app/Actions/Complaints/CreateComplaint.php'\\'' AND s.name='\\''handle'\\''), '\\''outgoing'\\'', 2);\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.sequence_number,s.rank,left(s.content,100) AS match FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, '\\''categories'\\'', 20) s JOIN aic_chunks c ON c.id=s.chunk_id WHERE s.source_reference='\\''httpdocs/frontend/app/pages/index.vue'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT chunk_id,source_type,source_reference,title,left(content,120) AS excerpt FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid,'\\''intentionally incomplete markers'\\'',5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT chunk_id,source_type,source_reference,title,left(content,120) AS excerpt FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid,'\\''unresolved contract tests incomplete'\\'',5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name FROM information_schema.columns WHERE table_name = '\\''aic_chunks'\\'' ORDER BY ordinal_position; SELECT f.path, c.id, c.chunk_index, c.content_hash FROM aic_chunks c JOIN aic_files f ON f.id=c.file_id WHERE c.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/pages/index.vue'\\'', '\\''httpdocs/frontend/app/assets/css/main.css'\\'') ORDER BY f.path, c.chunk_index;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name FROM information_schema.columns WHERE table_name='\\''aic_files'\\'' ORDER BY ordinal_position; SELECT id,path,content_hash,metadata,indexed_at FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''d0f6680a-5956-4efc-a89b-1ea7505d3c97'\\''; SELECT id,sequence_number,start_line,end_line,token_count,metadata FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND file_id='\\''d0f6680a-5956-4efc-a89b-1ea7505d3c97'\\'' ORDER BY sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name, data_type FROM information_schema.columns WHERE table_name IN ('\\''aic_files'\\'', '\\''aic_symbols'\\'', '\\''aic_chunks'\\'', '\\''aic_documents'\\'', '\\''aic_knowledge_items'\\'', '\\''aic_embeddings'\\'') ORDER BY table_name, ordinal_position; SELECT s.id, s.kind, s.name, s.qualified_name, s.signature, s.start_line, s.end_line FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''httpdocs/frontend/app/components/AppHeader.vue'\\'' ORDER BY s.start_line; SELECT c.id, c.sequence_number, c.start_line, c.end_line, c.content_hash, length(c.content) AS chars, c.chunk_type, e.id IS NOT NULL AS has_embedding, c.metadata FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''httpdocs/frontend/app/components/AppHeader.vue'\\'' ORDER BY c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name, data_type FROM information_schema.columns WHERE table_name='\\''aic_indexing_runs'\\'' ORDER BY ordinal_position; SELECT id, status, started_at, stats, metadata FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'') ORDER BY started_at DESC LIMIT 10; SELECT count(*) FILTER (WHERE e.id IS NULL) AS missing_embeddings, count(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT f.id, f.path, f.content_hash, f.is_deleted, count(c.id) AS chunks, count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''httpdocs/frontend/app/components/AppHeader.vue'\\'' GROUP BY f.id;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,is_nullable,column_default FROM information_schema.columns WHERE table_schema='\\''public'\\'' AND table_name='\\''aic_symbol_relations'\\'' ORDER BY ordinal_position; SELECT conname,pg_get_constraintdef(oid) AS definition FROM pg_constraint WHERE conrelid='\\''public.aic_symbol_relations'\\''::regclass ORDER BY conname; SELECT indexname,indexdef FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_symbol_relations'\\'' ORDER BY indexname; SELECT p.proname,pg_get_function_identity_arguments(p.oid) AS arguments FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='\\''public'\\'' AND (p.proname ILIKE '\\''%relation%write%'\\'' OR p.proname ILIKE '\\''%relation%upsert%'\\'' OR p.proname='\\''aic_symbol_relations_walk'\\'') ORDER BY p.proname; SELECT count(*) AS target_relation_rows FROM aic_symbol_relations WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,is_nullable,column_default FROM information_schema.columns WHERE table_schema='\\''public'\\'' AND table_name='\\''aic_symbol_relations'\\'' ORDER BY ordinal_position; SELECT conname,pg_get_constraintdef(oid) AS definition FROM pg_constraint WHERE conrelid='\\''public.aic_symbol_relations'\\''::regclass ORDER BY conname; SELECT indexname,indexdef FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_symbol_relations'\\'' ORDER BY indexname; SELECT p.proname,pg_get_function_identity_arguments(p.oid) AS arguments FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='\\''public'\\'' AND (p.proname ILIKE '\\''%relation%write%'\\'' OR p.proname ILIKE '\\''%relation%upsert%'\\'' OR p.proname='\\''aic_symbol_relations_walk'\\'') ORDER BY p.proname; SELECT count(*) AS target_relation_rows FROM aic_symbol_relations WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'';\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT d.path, d.content_hash, COUNT(c.id) AS chunks FROM aic_documents d LEFT JOIN aic_chunks c ON c.project_id=d.project_id AND c.document_id=d.id WHERE d.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid GROUP BY d.id ORDER BY d.path; SELECT f.path,c.sequence_number,c.start_line,c.end_line,c.content_hash,encode(digest(c.content,'\\''sha256'\\''),'\\''hex'\\'') AS digest_sha256,char_length(c.content) AS chars,LEFT(c.content,80) AS prefix FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path='\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'' ORDER BY c.sequence_number LIMIT 2;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.content_hash, c.sequence_number, c.content_hash AS chunk_hash, e.source_content_hash, e.dimensions, vector_dims(e.embedding) AS vector_dimensions FROM aic_files f JOIN aic_chunks c ON c.file_id=f.id AND c.project_id=f.project_id JOIN aic_embeddings e ON e.chunk_id=c.id AND e.project_id=c.project_id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path='\\''httpdocs/frontend/app/pages/index.vue'\\'' ORDER BY c.sequence_number; SELECT status,stats,metadata FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.language, COUNT(*) AS files FROM aic_files f WHERE f.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.is_deleted = FALSE GROUP BY f.language ORDER BY f.language; SELECT f.language, COUNT(DISTINCT f.id) AS symbol_files, COUNT(s.id) AS symbols FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid GROUP BY f.language ORDER BY f.language; SELECT f.language, sr.relation_type, COUNT(*) FROM aic_symbol_relations sr JOIN aic_symbols s ON s.project_id=sr.project_id AND s.id=sr.source_symbol_id JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE sr.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid GROUP BY f.language, sr.relation_type ORDER BY f.language, sr.relation_type;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, c.id, c.sequence, c.content_hash FROM aic_chunks c JOIN aic_files f ON f.id=c.file_id WHERE c.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/pages/index.vue'\\'', '\\''httpdocs/frontend/app/assets/css/main.css'\\'') ORDER BY f.path, c.sequence;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, c.id, c.sequence_number, c.content_hash FROM aic_chunks c JOIN aic_files f ON f.id=c.file_id WHERE c.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/pages/index.vue'\\'', '\\''httpdocs/frontend/app/assets/css/main.css'\\'') ORDER BY f.path, c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, c.sequence_number, c.start_line, c.end_line, c.content_hash AS chunk_hash, e.dimensions, e.source_content_hash, vector_dims(e.embedding) AS vector_dimensions FROM aic_files f JOIN aic_chunks c ON c.file_id=f.id AND c.project_id=f.project_id JOIN aic_embeddings e ON e.chunk_id=c.id AND e.project_id=c.project_id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path='\\''httpdocs/frontend/app/pages/index.vue'\\'' ORDER BY c.sequence_number; SELECT indexname FROM pg_indexes WHERE tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\''; SELECT status,run_type,stats,metadata FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.language, count(s.id) AS symbols FROM aic_files f LEFT JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT f.is_deleted GROUP BY f.path, f.language ORDER BY f.path LIMIT 30;\" -c \"SELECT status, stats, metadata FROM aic_indexing_runs WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY created_at DESC LIMIT 3;\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,f.content_hash,c.sequence_number,c.content_hash AS chunk_hash,e.source_content_hash,e.dimensions,vector_dims(e.embedding) AS vector_dimensions FROM aic_files f JOIN aic_chunks c ON c.file_id=f.id AND c.project_id=f.project_id JOIN aic_embeddings e ON e.chunk_id=c.id AND e.project_id=c.project_id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path='\\''httpdocs/frontend/app/pages/index.vue'\\'' AND c.sequence_number=0; SELECT status,stats FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,f.id,count(c.id) AS chunks,count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND f.path IN ('\\''httpdocs/frontend/app/assets/css/main.css'\\'', '\\''httpdocs/frontend/app/pages/index.vue'\\'') GROUP BY f.path,f.id ORDER BY f.path;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT file_type, language, count(*) FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND NOT is_deleted GROUP BY file_type, language ORDER BY file_type, language; SELECT path, title, content_hash, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=d.project_id AND c.document_id=d.id) AS chunks FROM aic_documents d WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY path NULLS LAST, title; SELECT path, file_type, language, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=f.project_id AND c.file_id=f.id) AS chunks FROM aic_files f WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND NOT is_deleted AND (path LIKE '\\''%.md'\\'' OR path LIKE '\\''%.jpg'\\'' OR path LIKE '\\''%.png'\\'') ORDER BY path;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug FROM aic_projects WHERE slug = '\\''strateg-ua'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''easyfit-ua'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''export-strateg-ua'\\'' ORDER BY created_at DESC;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''yii3-office-easyfit'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug ILIKE '\\''%easyfit%'\\'' OR name ILIKE '\\''%easyfit%'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug ILIKE '\\''%pet-complaints%'\\'' OR root_path ILIKE '\\''%pet-complaints-platform%'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug LIKE '\\''%easyfit%'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active, created_at, updated_at FROM aic_projects WHERE slug = '\\''export-strateg-ua'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, path, content_hash FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path IN ('\\''httpdocs/frontend/app/pages/index.vue'\\'', '\\''httpdocs/frontend/app/assets/css/main.css'\\'');\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, provider, model, dimensions, enabled FROM aic_embedding_models ORDER BY model;\" -c \"SELECT id, run_type, status, git_commit, started_at, finished_at, stats, error_message FROM aic_indexing_runs WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid ORDER BY started_at DESC LIMIT 10;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname = current_schema() AND tablename = '\\''aic_embeddings'\\'';\" -c \"SELECT count(*) AS stale_or_missing_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id = c.project_id AND e.chunk_id = c.id AND e.embedding_model_id = (SELECT id FROM aic_embedding_models WHERE model = '\\''text-embedding-3-small'\\'' AND provider = '\\''openai'\\'') WHERE c.project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND (e.id IS NULL OR e.source_content_hash <> c.content_hash);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug FROM aic_projects WHERE slug = '\\''easyfit-ua'\\'' AND active = TRUE;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug FROM aic_projects WHERE slug = '\\''pet-complaints-platform'\\'';\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug FROM aic_projects WHERE slug = '\\''yii3-office-easyfit'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id,slug FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'' AND active=TRUE; SELECT chunk_id,source_reference,title,rank,left(content,420) AS content FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'' AND active=TRUE),'\\''container'\\'',8);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT indexname, indexdef FROM pg_indexes WHERE schemaname=current_schema() AND tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_%'\\'' AND indexdef LIKE '\\''%9cb2ac9e-7047-4353-812c-35ecbb51289f%'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT kind, title, source_reference, left(content, 220) AS content_preview FROM aic_knowledge_items WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND status = '\\''active'\\'' ORDER BY kind, title;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT n.nspname, p.proname, pg_get_function_identity_arguments(p.oid) AS args FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE p.proname ILIKE '\\''%search%chunk%text%'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id AS project_id, p.slug, p.name, em.id AS model_id, em.provider, em.model, em.dimensions FROM aic_projects p LEFT JOIN aic_embedding_models em ON em.provider = '\\''openai'\\'' AND em.model = '\\''text-embedding-3-small'\\'' WHERE p.slug = '\\''pet-complaints-platform'\\''; SELECT r.id, r.run_type, r.status, r.started_at, r.finished_at, r.stats FROM aic_indexing_runs r JOIN aic_projects p ON p.id = r.project_id WHERE p.slug = '\\''pet-complaints-platform'\\'' ORDER BY r.started_at DESC LIMIT 10; SELECT p.slug, (SELECT COUNT(*) FROM aic_files f WHERE f.project_id = p.id AND NOT f.is_deleted) AS files, (SELECT COUNT(*) FROM aic_symbols s WHERE s.project_id = p.id) AS symbols, (SELECT COUNT(*) FROM aic_symbol_relations sr WHERE sr.project_id = p.id) AS relations, (SELECT COUNT(*) FROM aic_documents d WHERE d.project_id = p.id) AS documents, (SELECT COUNT(*) FROM aic_knowledge_items k WHERE k.project_id = p.id) AS knowledge, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id = p.id) AS chunks, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id = p.id) AS embeddings FROM aic_projects p WHERE p.slug = '\\''pet-complaints-platform'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.name, p.slug, (SELECT count(*) FROM aic_files f WHERE f.project_id = p.id AND NOT f.is_deleted) AS files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id = p.id) AS symbols, (SELECT count(*) FROM aic_symbol_relations r WHERE r.project_id = p.id) AS relations, (SELECT count(*) FROM aic_indexing_runs ir WHERE ir.project_id = p.id) AS runs FROM aic_projects p WHERE p.slug = '\\''pet-complaints-platform'\\'' AND p.active = TRUE;\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.name, p.slug, p.root_path, p.active FROM aic_projects p WHERE p.slug = '\\''strateg-export-products'\\''; SELECT em.id, em.provider, em.model, em.dimensions FROM aic_embedding_models em WHERE em.model = '\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, p.active, (SELECT count(*) FROM aic_files f WHERE f.project_id=p.id AND NOT f.is_deleted) AS files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS active_knowledge, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id) AS embeddings FROM aic_projects p WHERE p.slug='\\''pet-complaints-platform'\\''; SELECT m.id, m.provider, m.model, m.dimensions, m.enabled FROM aic_embedding_models m WHERE m.provider='\\''openai'\\'' AND m.model='\\''text-embedding-3-small'\\''; SELECT id, status, started_at, completed_at, stats, metadata FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'') ORDER BY started_at DESC LIMIT 10;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.name,p.slug,p.root_path,r.id AS run_id,r.status,r.git_commit,r.stats->> '\\''files'\\'' AS stat_files,r.stats->> '\\''symbols'\\'' AS stat_symbols,r.stats->> '\\''chunks'\\'' AS stat_chunks,(SELECT count(*) FROM aic_files f WHERE f.project_id=p.id) AS files,(SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols,(SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents,(SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS knowledge,(SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks,(SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.embedding_model_id=m.id) AS embeddings,(SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.embedding_model_id=m.id AND (e.dimensions<>1536 OR vector_dims(e.embedding)<>1536 OR e.source_content_hash<> (SELECT c.content_hash FROM aic_chunks c WHERE c.project_id=e.project_id AND c.id=e.chunk_id))) AS invalid_embeddings,(SELECT count(*) FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_9cb2ac9e704b_m_0e87a4a94b79'\\'') AS expected_hnsw_index FROM aic_projects p JOIN aic_indexing_runs r ON r.project_id=p.id JOIN aic_embedding_models m ON m.provider='\\''openai'\\'' AND m.model='\\''text-embedding-3-small'\\'' WHERE p.slug='\\''easyfit-ua'\\'' AND p.id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND r.id='\\''eec76587-38a0-4e2a-af2b-68f7c5c5ed9f'\\''::uuid; SELECT kind,title,source_reference,status,confidence FROM aic_knowledge_items WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid ORDER BY kind,title;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.slug,s.chunk_id,s.source_type,s.source_reference,s.title,s.rank,left(s.content,650) AS content FROM aic_projects p CROSS JOIN LATERAL aic_search_chunks_text(p.id, '\\''homepage desktop container margin spacing layout'\\'', 8) s WHERE p.slug='\\''pet-complaints-platform'\\'' AND p.active=TRUE ORDER BY s.rank;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.slug, (SELECT count(*) FROM aic_files f WHERE f.project_id=p.id AND NOT f.is_deleted) AS files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS knowledge, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id) AS embeddings, (SELECT count(*) FROM aic_indexing_runs r WHERE r.project_id=p.id AND r.status='\\''running'\\'') AS running_runs FROM aic_projects p WHERE p.id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT count(*) FILTER (WHERE e.id IS NULL) AS missing_embeddings, count(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT r.id, r.status, r.stats, r.metadata->>'\\''relations_populated'\\'' AS relations_populated FROM aic_indexing_runs r WHERE r.id='\\''d099058c-e63c-42a5-8082-6c6080b787fd'\\''::uuid;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.slug, (SELECT count(*) FROM aic_files f WHERE f.project_id=p.id AND NOT f.is_deleted) AS files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT count(*) FROM aic_symbol_relations r WHERE r.project_id=p.id) AS symbol_relations, (SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS active_knowledge, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid) AS model_embeddings FROM aic_projects p WHERE p.id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT dimensions, count(*) AS vectors FROM aic_embeddings WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid GROUP BY dimensions; SELECT count(*) FILTER (WHERE e.id IS NULL) AS missing_embeddings, count(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\''; SELECT id, status, stats FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, sequence_number, left(content, 100) AS match FROM search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, '\\''max-w-7xl homepage layout'\\'', 5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path,sequence_number,left(content,100) AS match FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, '\\''max-w-7xl homepage layout'\\'', 5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT pg_get_function_result(p.oid) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='\\''public'\\'' AND p.proname='\\''aic_search_chunks_text'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT r.id, r.run_type, r.status, r.git_commit, r.started_at, r.stats FROM aic_indexing_runs r WHERE r.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY r.started_at DESC LIMIT 5; SELECT k.id, k.kind, k.title, k.source_reference, k.status FROM aic_knowledge_items k WHERE k.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY k.updated_at DESC; SELECT c.source_type, COUNT(*) AS chunks, COUNT(e.id) AS embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id = c.project_id AND e.chunk_id = c.id AND e.embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid GROUP BY c.source_type ORDER BY c.source_type; SELECT indexname FROM pg_indexes WHERE schemaname = '\\''public'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e%'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT r.relation_type, COUNT(*) AS edge_count, COUNT(r.target_symbol_id) AS resolved_count, COUNT(*) FILTER (WHERE r.target_symbol_id IS NULL) AS unresolved_count FROM aic_symbol_relations r WHERE r.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' GROUP BY r.relation_type ORDER BY r.relation_type;\" -c \"SELECT status, run_type, stats FROM aic_indexing_runs WHERE id = '\\''dbe373a7-2de4-4599-8ea0-14c869ad7626'\\''::uuid AND project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT source.name AS source_symbol, target.name AS target_symbol, r.relation_type, f.path, r.source_line, r.confidence FROM aic_symbol_relations r JOIN aic_symbols source ON source.project_id=r.project_id AND source.id=r.source_symbol_id JOIN aic_symbols target ON target.project_id=r.project_id AND target.id=r.target_symbol_id JOIN aic_files f ON f.project_id=source.project_id AND f.id=source.file_id WHERE r.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND r.relation_type='\\''calls'\\'' ORDER BY r.confidence DESC, f.path, r.source_line LIMIT 10;\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT root_path FROM aic_projects WHERE id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT f.language, COUNT(DISTINCT f.id) AS files, COUNT(s.id) AS symbols FROM aic_files f LEFT JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT f.is_deleted GROUP BY f.language ORDER BY f.language;\" -c \"SELECT column_name FROM information_schema.columns WHERE table_name='aic_indexing_runs' ORDER BY ordinal_position;\" -c \"SELECT status, run_type, stats, metadata FROM aic_indexing_runs WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 3;\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT run_type,status,stats,metadata FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY started_at DESC LIMIT 1; SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND tablename='\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%hnsw%'\\'' ORDER BY indexname;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT s.source_reference,s.rank FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, '\\''category'\\'', 100) s WHERE s.source_reference='\\''httpdocs/frontend/app/pages/index.vue'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT schemaname,viewname FROM pg_views WHERE viewname ILIKE '\\''%retrieval%chunk%'\\'' ORDER BY schemaname,viewname;\"' && rg -n 'v_retrieval_chunks|CREATE.*VIEW' /home/kamaz/www/hobby/ai-code-intelligence/docker-entrypoint-initdb.d/002_schema.sql /home/kamaz/www/hobby/ai-code-intelligence/docker-entrypoint-initdb.d/004_views_and_search_functions.sql"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT sequence_number, content LIKE '\\''%categories%'\\'' AS has_categories, search_vector IS NOT NULL AS vector_present, search_vector @@ plainto_tsquery('\\''simple'\\'', '\\''categories'\\'') AS fts_hit FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND file_id='\\''d0f6680a-5956-4efc-a89b-1ea7505d3c97'\\'' ORDER BY sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT sequence_number, content_hash FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND file_id='\\''4e8b07c8-1bdf-4af5-9c14-9dde439b9a04'\\''::uuid ORDER BY sequence_number; SELECT count(*) AS exact_chunk_hash_matches FROM aic_chunks c JOIN jsonb_to_recordset(''[]''::jsonb) AS i(content_hash text) ON i.content_hash=c.content_hash WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid;\"'"],["/bin/bash","-lc","d