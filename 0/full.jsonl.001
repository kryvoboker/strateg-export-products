_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT count(*) FROM aic_files WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'') AS files,(SELECT count(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'') AS symbols,(SELECT count(*) FROM aic_documents WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'') AS documents,(SELECT count(*) FROM aic_knowledge_items WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND status='\\''active'\\'') AS active_knowledge,(SELECT count(*) FROM aic_chunks WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'') AS chunks,(SELECT count(*) FROM aic_embeddings WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'') AS embeddings,(SELECT count(*) FROM aic_embeddings WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND (dimensions<>1536 OR vector_dims(embedding)<>1536)) AS bad_dimensions,(SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE c.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND e.id IS NULL) AS missing_embeddings; SELECT id,status,stats FROM aic_indexing_runs WHERE id='\\''44f782c7-d534-4d21-8772-f20d01add878'\\''; SELECT indexname FROM pg_indexes WHERE indexname='\\''aic_emb_hnsw_p_9efb77e21469_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'' WHERE id='\\''afe788a3-466d-4c16-b81e-4d1c34f4a109'\\'' AND project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\''; SELECT id,run_type,status FROM aic_indexing_runs WHERE id='\\''afe788a3-466d-4c16-b8