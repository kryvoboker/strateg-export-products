 tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_%'\\'';\"' "],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT current_database() AS database, (SELECT count(*) FROM aic_projects) AS project_rows, (SELECT count(*) FROM aic_projects WHERE slug = '\\''strateg-ua'\\'' OR root_path = '\\''/home/kamaz/www/strateg-projects/dev.strateg.ua'\\'') AS target_rows;\"'"],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT current_user, c.relname, pg_get_userbyid(c.relowner) AS owner, has_table_privilege(current_user,c.oid,'\\''INSERT'\\'') AS can_insert, has_table_privilege(current_user,c.oid,'\\''SELECT'\\'') AS can_select, has_table_privilege(current_user,c.oid,'\\''TRIGGER'\\'') AS can_trigger FROM pg_class c WHERE c.relname IN ('\\''aic_files'\\'', '\\''aic_symbols'\\'', '\\''aic_documents'\\'', '\\''aic_knowledge_items'\\'', '\\''aic_chunks'\\'', '\\''aic_embeddings'\\'', '\\''aic_indexing_runs'\\'') ORDER BY c.relname; SELECT routine_name, grantee, privilege_type FROM information_schema.routine_privileges WHERE routine_schema='\\''public'\\'' AND routine_name='\\''aic_create_project_embedding_hnsw_index'\\'' ORDER BY grantee;\"' "],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, kind, title, content, source_reference, status, confidence FROM aic_knowledge_items WHERE project_id = '\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND status = '\\''active'\\'' ORDER BY kind, title;\"'"],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''strateg-ua'\\'' OR root_path = '\\''/home/kamaz/www/strateg-projects/dev.strateg.ua'\\''; SELECT table_name, column_name, is_nullable, column_default FROM information_schema.columns WHERE table_schema = '\\''public'\\'' AND table_name IN ('\\''aic_embedding_models'\\'', '\\''aic_indexing_runs'\\'') ORDER BY table_name, ordinal_position;\"' "],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT slug, id, name, root_path, active FROM aic_projects WHERE slug = '\\''dev-strateg-ua'\\'' OR root_path = '\\''/home/kamaz/www/strateg-projects/dev.strateg.ua'\\'' ORDER BY slug;\"' "],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT slug, id, name, root_path, active FROM aic_projects WHERE slug = '\\''strateg-ua'\\'' OR root_path = '\\''/home/kamaz/www/strateg-projects/dev.strateg.ua'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT slug, id, name, root_path, active FROM aic_projects WHERE slug = '\\''strateg-ua'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T -e BOOST_PHP_EXECUTABLE_PATH='php -d memory_limit=512M' clothing-store-php-fpm php -d memory_limit=512M -r 'echo \"memory_limit=\".ini_get(\"memory_limit\").PHP_EOL; echo \"boost_php=\".getenv(\"BOOST_PHP_EXECUTABLE_PATH\").PHP_EOL;' && docker compose -f .docker/dev/docker-compose.yml exec -T -e BOOST_PHP_EXECUTABLE_PATH='php -d memory_limit=512M' clothing-store-php-fpm php -d memory_limit=512M artisan boost:mcp </dev/null >/tmp/clothing-boost-cli.out 2>/tmp/clothing-boost-cli.err; boost_status=$?; echo \"boost_exit=$boost_status\"; sed -n '1,80p' /tmp/clothing-boost-cli.err; git diff --check; git diff -- .docker/dev/php/php.ini .mcp.json"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = 'easyfit-pl';\""],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -At -F \"|\" -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,c.sequence_number,c.id,c.content_hash FROM aic_files f JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'') ORDER BY f.path,c.sequence_number;\" -c \"SELECT id,provider,model,dimensions,distance_metric FROM aic_embedding_models WHERE id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -At -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.content_hash = encode(digest(convert_to(c.content,'\\''UTF8'\\''),'\\''sha256'\\''),'\\''hex'\\'') FROM aic_chunks c WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_embedding_models (id, provider, model, dimensions, distance_metric, enabled, metadata) VALUES ('\\''75057a8a-8980-43a8-9487-7b0945fd8233'\\''::uuid, '\\''openai'\\'', '\\''text-embedding-3-small'\\'', 1536, '\\''cosine'\\'', TRUE, '\\''{\\\"source\\\":\\\"ai-code-intelligence docs/getting-started.md\\\"}'\\''::jsonb) ON CONFLICT (provider, model) DO UPDATE SET dimensions=EXCLUDED.dimensions, distance_metric=EXCLUDED.distance_metric, enabled=TRUE RETURNING id, provider, model, dimensions;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_projects (id, name, slug, root_path, default_branch, metadata) VALUES ('\\''3c7f07bd-bcb6-4516-908e-bc0fc8eb52cf'\\''::uuid, '\\''Easyfit PL'\\'', '\\''easyfit-pl'\\'', '\\''/home/kamaz/www/easyfit-projects/easyfit-pl.com'\\'', '\\''main'\\'', '\\''{\\\"index_scope\\\":\\\"OpenCart source, docs, and front-end source; secrets/vendor/runtime excluded\\\"}'\\''::jsonb) ON CONFLICT (slug) DO UPDATE SET name=EXCLUDED.name, root_path=EXCLUDED.root_path, active=TRUE RETURNING id, name, slug;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.id, c.chunk_type, c.sequence_number, c.start_line, c.end_line, c.metadata, c.content_hash, e.source_content_hash FROM aic_projects p JOIN aic_files f ON f.project_id = p.id JOIN aic_chunks c ON c.project_id = p.id AND c.file_id = f.id LEFT JOIN aic_embeddings e ON e.project_id = p.id AND e.chunk_id = c.id WHERE p.slug = '\\''pet-complaints-platform'\\'' AND f.path = '\\''httpdocs/frontend/app/components/AppFooter.vue'\\'' AND f.is_deleted = FALSE; SELECT indexname FROM pg_indexes WHERE schemaname = '\\''public'\\'' AND tablename = '\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_embeddings_project_%'\\'';\"' && docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'node -e '\\''const fs=require(\"fs\"); for (const f of process.argv.slice(1)){const v=JSON.parse(fs.readFileSync(f)); console.log(JSON.stringify({file:f,count:v.length,dimensions:v[0]?.length}));}'\\'' /app/embedding-results/2026/10/pet-complaints-platform-app-footer-script-c2626174.json /app/embedding-results/2026/10/pet-complaints-platform-app-footer-template-3e1f214e.json'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT chunk_id,source_type,source_reference,title,left(content,180) AS content_preview FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid,'\\''complaint category rel nofollow filter state'\\'',10);\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT count(*) AS matching_knowledge_titles FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\''; SELECT count(*) AS old_code_chunks FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND c.source_type='\\''code'\\'' AND f.path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]);\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.id AS file_id, f.content_hash AS file_hash, c.id AS chunk_id, c.content_hash AS chunk_hash, c.start_line, c.end_line, length(c.content) AS chunk_length, e.id AS embedding_id, e.source_content_hash, e.dimensions FROM aic_projects p JOIN aic_files f ON f.project_id = p.id JOIN aic_chunks c ON c.project_id = p.id AND c.file_id = f.id LEFT JOIN aic_embeddings e ON e.project_id = p.id AND e.chunk_id = c.id WHERE p.slug = '\\''pet-complaints-platform'\\'' AND f.path = '\\''httpdocs/frontend/app/components/AppFooter.vue'\\'' AND f.is_deleted = FALSE ORDER BY c.sequence_number; SELECT run_type, status, started_at, finished_at FROM aic_indexing_runs r JOIN aic_projects p ON p.id = r.project_id WHERE p.slug = '\\''pet-complaints-platform'\\'' ORDER BY started_at DESC LIMIT 3;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.id, count(c.id) AS chunks, count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id = f.project_id AND c.file_id = f.id AND c.source_type = '\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id = c.project_id AND e.chunk_id = c.id WHERE f.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path LIKE '\\''httpdocs/frontend/%Complaint%'\\'' GROUP BY f.path,f.content_hash,f.id ORDER BY f.path;\" -c \"SELECT id, kind, title, source_reference, status FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status = '\\''active'\\'' ORDER BY title;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname = '\\''public'\\'' AND tablename = '\\''aic_embeddings'\\'' AND indexname = '\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,c.id,c.sequence_number,c.start_line,c.end_line,c.content_hash,length(c.content) AS content_length,left(c.content,180) AS content_preview FROM aic_files f JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'') ORDER BY f.path,c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,count(c.id) AS code_chunks,count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id AND c.source_type='\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]) GROUP BY f.path ORDER BY f.path; SELECT count(c.id) AS knowledge_chunks,count(e.id) AS knowledge_embeddings FROM aic_knowledge_items k LEFT JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE k.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND k.title='\\''Complaint list frontend flow and filter state'\\''; SELECT id,status,finished_at FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name,s.signature,s.start_line,s.end_line,s.visibility,s.is_exported FROM aic_files f JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'') ORDER BY f.path,s.start_line;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''pet-complaints-platform'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug IN ('\\''export-strateg-ua'\\'', '\\''strateg-ua'\\'', '\\''strateg-export-products'\\'') ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug, name, root_path, active FROM aic_projects WHERE slug ILIKE '\\''%easyfit%'\\'' OR name ILIKE '\\''%easyfit%'\\'' OR root_path ILIKE '\\''%yii3-office%'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug, name, root_path, active, created_at, updated_at FROM aic_projects WHERE slug = '\\''yii3-office-easyfit'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, status, started_at, finished_at, stats FROM aic_indexing_runs WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 8;\" -c \"SELECT '\\''files'\\'' AS table_name, count(*) FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''symbols'\\'', count(*) FROM aic_symbols WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''chunks'\\'', count(*) FROM aic_chunks WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''embeddings'\\'', count(*) FROM aic_embeddings WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''docs'\\'', count(*) FROM aic_documents WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''knowledge'\\'', count(*) FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT path, content_hash, is_deleted, indexed_at FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'', '\\''httpdocs/frontend/i18n/locales/en.json'\\'', '\\''httpdocs/frontend/i18n/locales/uk.json'\\'') ORDER BY path;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.id,k.kind,k.title,k.status,k.confidence,k.source_reference,count(c.id) AS linked_chunks,count(e.id) AS linked_embeddings FROM aic_knowledge_items k LEFT JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE k.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND k.title='\\''Complaint list frontend flow and filter state'\\'' GROUP BY k.id; SELECT c.source_type,count(*) AS chunks,count(e.id) AS embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (f.path LIKE '\\''httpdocs/frontend/%Complaint%'\\'' OR c.knowledge_item_id IN (SELECT id FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\'')) GROUP BY c.source_type ORDER BY c.source_type;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, m.id AS model_id, m.model, m.dimensions, (SELECT count(*) FROM aic_files f WHERE f.project_id = p.id AND f.is_deleted = FALSE) AS files, (SELECT count(*) FROM aic_chunks c WHERE c.project_id = p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id = p.id AND e.embedding_model_id = m.id) AS embeddings, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id = p.id) AS knowledge FROM aic_projects p LEFT JOIN aic_embedding_models m ON m.provider = '\\''openai'\\'' AND m.model = '\\''text-embedding-3-small'\\'' WHERE p.slug = '\\''pet-complaints-platform'\\'' AND p.active = TRUE;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path,id,content_hash FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]) ORDER BY path; SELECT r.status,r.finished_at,r.stats FROM aic_indexing_runs r WHERE r.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND r.id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\''; SELECT count(*) AS missing FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL; SELECT count(*) AS stale FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (e.source_content_hash <> c.content_hash OR e.dimensions <> 1536); SELECT id,title,status FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\''; SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT r.id, r.status, r.started_at, r.completed_at, r.stats FROM aic_indexing_runs r WHERE r.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY r.started_at DESC LIMIT 8;\" -c \"SELECT '''files''' AS table_name, count(*) FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''symbols''', count(*) FROM aic_symbols WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''chunks''', count(*) FROM aic_chunks WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''embeddings''', count(*) FROM aic_embeddings WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''docs''', count(*) FROM aic_documents WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''knowledge''', count(*) FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT path, content_hash, is_deleted, indexed_at FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'', '\\''httpdocs/frontend/i18n/locales/en.json'\\'', '\\''httpdocs/frontend/i18n/locales/uk.json'\\'') ORDER BY path;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT run_type,status,started_at,finished_at,stats FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\''; SELECT '\\''files'\\'' AS table_name,count(*) FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND is_deleted=FALSE UNION ALL SELECT '\\''symbols'\\'',count(*) FROM aic_symbols WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''chunks'\\'',count(*) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''embeddings'\\'',count(*) FROM aic_embeddings WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''documents'\\'',count(*) FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''knowledge'\\'',count(*) FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status='\\''active'\\''; SELECT count(*) AS missing_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL; SELECT count(*) AS stale_embeddings FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (e.source_content_hash <> c.content_hash OR e.dimensions <> 1536); SELECT path,content_hash,is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]) ORDER BY path; SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\''; SELECT id,title,status,confidence FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\''::uuid;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_name, column_name FROM information_schema.columns WHERE table_schema = '\\''public'\\'' AND table_name IN ('\\''aic_indexing_runs'\\'', '\\''aic_files'\\'', '\\''aic_chunks'\\'', '\\''aic_knowledge_items'\\'', '\\''aic_embeddings'\\'') ORDER BY table_name, ordinal_position;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'',finished_at=NOW(),stats='\\''{\"files_added\":1,\"files_updated\":4,\"documents_added\":0,\"documents_updated\":0,\"knowledge_items_added\":1,\"deleted_chunks\":10,\"code_chunks_added\":14,\"knowledge_chunks_added\":1,\"embeddings_to_generate\":15,\"embeddings_generated\":15,\"chunks_retained_with_existing_embeddings\":611,\"stale_embeddings\":0,\"missing_embeddings\":0,\"embedding_model\":\"text-embedding-3-small\",\"embedding_dimensions\":1536,\"symbol_relations\":0,\"hnsw_index\":\"aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e\",\"final_project_files\":391,\"final_project_symbols\":799,\"final_project_documents\":25,\"active_knowledge_items\":12,\"final_project_chunks\":626,\"final_project_embeddings\":626}'\\''::jsonb WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\'' AND status='\\''running'\\'' RETURNING id,status,finished_at,stats;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'',finished_at=NOW(),stats=jsonb_build_object('\\''files_added'\\'',1,'\\''files_updated'\\'',4,'\\''documents_added'\\'',0,'\\''documents_updated'\\'',0,'\\''knowledge_items_added'\\'',1,'\\''deleted_chunks'\\'',10,'\\''code_chunks_added'\\'',14,'\\''knowledge_chunks_added'\\'',1,'\\''embeddings_to_generate'\\'',15,'\\''embeddings_generated'\\'',15,'\\''chunks_retained_with_existing_embeddings'\\'',611,'\\''stale_embeddings'\\'',0,'\\''missing_embeddings'\\'',0,'\\''embedding_model'\\'','\\''text-embedding-3-small'\\'','\\''embedding_dimensions'\\'',1536,'\\''symbol_relations'\\'',0,'\\''hnsw_index'\\'','\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'','\\''final_project_files'\\'',391,'\\''final_project_symbols'\\'',799,'\\''final_project_documents'\\'',25,'\\''active_knowledge_items'\\'',12,'\\''final_project_chunks'\\'',626,'\\''final_project_embeddings'\\'',626) WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\'' AND status='\\''running'\\'' RETURNING id,status,finished_at,stats;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') SELECT '\\''file_rows'\\'' AS metric, count(*)::text AS value FROM aic_files WHERE project_id=(SELECT id FROM p) UNION ALL SELECT '\\''nondeleted_files'\\'', count(*)::text FROM aic_files WHERE project_id=(SELECT id FROM p) AND is_deleted=false UNION ALL SELECT '\\''deleted_files'\\'', count(*)::text FROM aic_files WHERE project_id=(SELECT id FROM p) AND is_deleted=true UNION ALL SELECT '\\''chunks_code'\\'', count(*)::text FROM aic_chunks WHERE project_id=(SELECT id FROM p) AND source_type='\\''code'\\'' UNION ALL SELECT '\\''chunks_document'\\'', count(*)::text FROM aic_chunks WHERE project_id=(SELECT id FROM p) AND source_type='\\''document'\\'' UNION ALL SELECT '\\''chunks_knowledge'\\'', count(*)::text FROM aic_chunks WHERE project_id=(SELECT id FROM p) AND source_type='\\''knowledge'\\'' UNION ALL SELECT '\\''knowledge_status'\\'', status||'\\'': '\\''||count(*) FROM aic_knowledge_items WHERE project_id=(SELECT id FROM p) GROUP BY status UNION ALL SELECT '\\''unembedded_chunks'\\'', count(*)::text FROM aic_chunks c WHERE c.project_id=(SELECT id FROM p) AND NOT EXISTS (SELECT 1 FROM aic_embeddings e WHERE e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid);\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug = '\\''office-easy