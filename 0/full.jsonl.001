\''main'\\'', '\\''{\\\"index_scope\\\":\\\"OpenCart source, docs, and front-end source; secrets/vendor/runtime excluded\\\"}'\\''::jsonb) ON CONFLICT (slug) DO UPDATE SET name=EXCLUDED.name, root_path=EXCLUDED.root_path, active=TRUE RETURNING id, name, slug;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.id, c.chunk_type, c.sequence_number, c.start_line, c.end_line, c.metadata, c.content_hash, e.source_content_hash FROM aic_projects p JOIN aic_files f ON f.project_id = p.id JOIN aic_chunks c ON c.project_id = p.id AND c.file_id = f.id LEFT JOIN aic_embeddings e ON e.project_id = p.id AND e.chunk_id = c.id WHERE p.slug = '\\''pet-complaints-platform'\\'' AND f.path = '\\''httpdocs/frontend/app/components/AppFooter.vue'\\'' AND f.is_deleted = FALSE; SELECT indexname FROM pg_indexes WHERE schemaname = '\\''public'\\'' AND tablename = '\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_embeddings_project_%'\\'';\"' && docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'node -e '\\''const fs=require(\"fs\"); for (const f of process.argv.slice(1)){const v=JSON.parse(fs.readFileSync(f)); console.log(JSON.stringify({file:f,count:v.length,dimensions:v[0]?.length}));}'\\'' /app/embedding-results/2026/10/pet-complaints-platform-app-footer-script-c2626174.json /app/embedding-results/2026/10/pet-complaints-platform-app-footer-template-3e1f214e.json'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT chunk_id,source_type,source_reference,title,left(content,180) AS content_preview FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid,'\\''complain