bedding_model_id=(SELECT id FROM m)) AS embeddings, (SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id=(SELECT id FROM m) WHERE c.project_id=(SELECT id FROM p) AND (e.id IS NULL OR e.source_content_hash<>c.content_hash OR e.dimensions<>1536 OR vector_dims(e.embedding)<>1536)) AS stale_or_invalid, (SELECT count(*) FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_09dfc1e0d429_m_7f16f2a76e0e'\\'') AS hnsw_index;\" -c \"SELECT run_type,status,stats FROM aic_indexing_runs WHERE project_id='\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid ORDER BY started_at;\" -c \"SELECT title,source_reference FROM aic_knowledge_items WHERE project_id='\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid AND status='\\''active'\\'' ORDER BY title;\" -c \"SELECT source_type,source_reference,title,left(content,120) AS excerpt FROM aic_search_chunks_text(''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32''::uuid,''unresolved contract tests incomplete'',5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH target AS (SELECT id FROM aic_projects WHERE slug = '\\''easyfit-ua'\\'' AND active = TRUE) SELECT r.source_reference, r.title, left(r.content, 700) AS excerpt FROM target t CROSS JOIN LATERAL aic_search_chunks_text(t.id, '\\''blog getBlog date_added admin edit form'\\'', 10) r;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -f /tmp/pet-complaints-refresh/embedding-insert.sql' > /tmp/pet-complaints-refresh/embedding-insert.log"],["/bin/bash","-lc","docker 