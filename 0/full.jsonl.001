nt(target_symbol_id) AS resolved, count(*) FILTER (WHERE target_symbol_id IS NULL) AS unresolved FROM aic_symbol_relations WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY relation_type ORDER BY relation_type; SELECT count(*) AS total_relations, count(*) FILTER (WHERE evidence IS NULL OR evidence = '\\''{}'\\''::jsonb) AS missing_evidence, count(*) FILTER (WHERE source_line < 1) AS invalid_lines, count(*) FILTER (WHERE target_symbol_id IS NOT NULL AND source.project_id <> target.project_id) AS cross_project_targets FROM aic_symbol_relations r JOIN aic_symbols source ON source.id=r.source_symbol_id LEFT JOIN aic_symbols target ON target.id=r.target_symbol_id WHERE r.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\''; SELECT kind,count(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND kind='\\''module'\\'' GROUP BY kind; SELECT id,run_type,status,stats FROM aic_indexing_runs WHERE id='\\''afe788a3-466d-4c16-b81e-4d1c34f4a109'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,data_type FROM information_schema.columns WHERE table_name='\\''aic_indexing_runs'\\'' ORDER BY ordinal_position\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,data_type,udt_name,is_nullable FROM information_schema.columns WHERE table_name = '\\''aic_embeddings'\\'' ORDER BY ordinal_position\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -q -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"