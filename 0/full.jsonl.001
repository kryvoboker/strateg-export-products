c680023'\\'' GROUP BY f.language,s.kind ORDER BY f.language,s.kind;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND (s.name IN ('\\''BaseService'\\'','\\''HttpException'\\'','\\''ToolInterface'\\'','\\''ProductSearchProviderInterface'\\'') OR s.qualified_name ILIKE '\\''%BaseService'\\'') ORDER BY s.name LIMIT 25;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name,s.start_line,s.start_column,s.end_line,s.end_column FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND s.kind IN ('\\''class'\\'','\\''method'\\'','\\''function'\\'','\\''interface'\\'','\\''trait'\\'') ORDER BY f.path,s.start_line LIMIT 12;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT kind,count(*) AS symbols FROM aic_symbols GROUP BY kind ORDER BY symbols DESC; SELECT p.slug,s.kind,count(*) AS symbols FROM aic_symbols s JOIN aic_projects p ON p.id=s.project_id WHERE s.kind IN ('\\''module'\\'','\\''file'\\'','\\''namespace'\\'') GROUP BY p.slug,s.kind ORDER BY p.slug,s.kind;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgr