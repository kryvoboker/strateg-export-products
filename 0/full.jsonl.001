t category rel nofollow filter state'\\'',10);\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT count(*) AS matching_knowledge_titles FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\''; SELECT count(*) AS old_code_chunks FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND c.source_type='\\''code'\\'' AND f.path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]);\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.id AS file_id, f.content_hash AS file_hash, c.id AS chunk_id, c.content_hash AS chunk_hash, c.start_line, c.end_line, length(c.content) AS chunk_length, e.id AS embedding_id, e.source_content_hash, e.dimensions FROM aic_projects p JOIN aic_files f ON f.project_id = p.id JOIN aic_chunks c ON c.project_id = p.id AND c.file_id = f.id LEFT JOIN aic_embeddings e ON e.project_id = p.id AND e.chunk_id = c.id WHERE p.slug = '\\''pet-complaints-platform'\\'' AND f.path = '\\''httpdocs/frontend/app/components/AppFooter.vue'\\'' AND f.is_deleted = FALSE ORDER BY c.sequence_number; SELECT run_type, status, started_at, finished_at FROM aic_indexing_runs r JOIN aic_projects p ON p.id = r.project_id WHERE p.slug = '\\''pet-complaints-platform'\\'' ORDER BY started_at DESC LIMIT 3;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.id, count(c.id) AS chunks, count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id = f.project_id AND c.file_id = f.id AND c.source_type = '\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id = c.project_id AND e.chunk_id = c.id WHERE f.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path LIKE '\\''httpdocs/frontend/%Complaint%'\\'' GROUP BY f.path,f.content_hash,f.id ORDER BY f.path;\" -c \"SELECT id, kind, title, source_reference, status FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status = '\\''active'\\'' ORDER BY title;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname = '\\''public'\\'' AND tablename = '\\''aic_embeddings'\\'' AND indexname = '\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,c.id,c.sequence_number,c.start_line,c.end_line,c.content_hash,length(c.content) AS content_length,left(c.content,180) AS content_preview FROM aic_files f JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'') ORDER BY f.path,c.sequence_number;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,count(c.id) AS code_chunks,count(e.id) AS embeddings FROM aic_files f LEFT JOIN aic_chunks c ON c.project_id=f.project_id AND c.file_id=f.id AND c.source_type='\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]) GROUP BY f.path ORDER BY f.path; SELECT count(c.id) AS knowledge_chunks,count(e.id) AS knowledge_embeddings FROM aic_knowledge_items k LEFT JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE k.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND k.title='\\''Complaint list frontend flow and filter state'\\''; SELECT id,status,finished_at FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name,s.signature,s.start_line,s.end_line,s.visibility,s.is_exported FROM aic_files f JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'') ORDER BY f.path,s.start_line;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''pet-complaints-platform'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug, name, root_path, active FROM aic_projects WHERE slug ILIKE '\\''%easyfit%'\\'' OR name ILIKE '\\''%easyfit%'\\'' OR root_path ILIKE '\\''%yii3-office%'\\'' ORDER BY slug;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug, name, root_path, active, created_at, updated_at FROM aic_projects WHERE slug = '\\''yii3-office-easyfit'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, status, started_at, finished_at, stats FROM aic_indexing_runs WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 8;\" -c \"SELECT '\\''files'\\'' AS table_name, count(*) FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''symbols'\\'', count(*) FROM aic_symbols WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''chunks'\\'', count(*) FROM aic_chunks WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''embeddings'\\'', count(*) FROM aic_embeddings WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''docs'\\'', count(*) FROM aic_documents WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''knowledge'\\'', count(*) FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT path, content_hash, is_deleted, indexed_at FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'', '\\''httpdocs/frontend/i18n/locales/en.json'\\'', '\\''httpdocs/frontend/i18n/locales/uk.json'\\'') ORDER BY path;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.id,k.kind,k.title,k.status,k.confidence,k.source_reference,count(c.id) AS linked_chunks,count(e.id) AS linked_embeddings FROM aic_knowledge_items k LEFT JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE k.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND k.title='\\''Complaint list frontend flow and filter state'\\'' GROUP BY k.id; SELECT c.source_type,count(*) AS chunks,count(e.id) AS embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (f.path LIKE '\\''httpdocs/frontend/%Complaint%'\\'' OR c.knowledge_item_id IN (SELECT id FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\'')) GROUP BY c.source_type ORDER BY c.source_type;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, m.id AS model_id, m.model, m.dimensions, (SELECT count(*) FROM aic_files f WHERE f.project_id = p.id AND f.is_deleted = FALSE) AS files, (SELECT count(*) FROM aic_chunks c WHERE c.project_id = p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id = p.id AND e.embedding_model_id = m.id) AS embeddings, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id = p.id) AS knowledge FROM aic_projects p LEFT JOIN aic_embedding_models m ON m.provider = '\\''openai'\\'' AND m.model = '\\''text-embedding-3-small'\\'' WHERE p.slug = '\\''pet-complaints-platform'\\'' AND p.active = TRUE;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path,id,content_hash FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]) ORDER BY path; SELECT r.status,r.finished_at,r.stats FROM aic_indexing_runs r WHERE r.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND r.id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\''; SELECT count(*) AS missing FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL; SELECT count(*) AS stale FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (e.source_content_hash <> c.content_hash OR e.dimensions <> 1536); SELECT id,title,status FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\''; SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT r.id, r.status, r.started_at, r.completed_at, r.stats FROM aic_indexing_runs r WHERE r.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY r.started_at DESC LIMIT 8;\" -c \"SELECT '''files''' AS table_name, count(*) FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''symbols''', count(*) FROM aic_symbols WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''chunks''', count(*) FROM aic_chunks WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''embeddings''', count(*) FROM aic_embeddings WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''docs''', count(*) FROM aic_documents WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''knowledge''', count(*) FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT path, content_hash, is_deleted, indexed_at FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'', '\\''httpdocs/frontend/i18n/locales/en.json'\\'', '\\''httpdocs/frontend/i18n/locales/uk.json'\\'') ORDER BY path;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT run_type,status,started_at,finished_at,stats FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\''; SELECT '\\''files'\\'' AS table_name,count(*) FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND is_deleted=FALSE UNION ALL SELECT '\\''symbols'\\'',count(*) FROM aic_symbols WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''chunks'\\'',count(*) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''embeddings'\\'',count(*) FROM aic_embeddings WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''documents'\\'',count(*) FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''knowledge'\\'',count(*) FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status='\\''active'\\''; SELECT count(*) AS missing_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL; SELECT count(*) AS stale_embeddings FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (e.source_content_hash <> c.content_hash OR e.dimensions <> 1536); SELECT path,content_hash,is_deleted FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]) ORDER BY path; SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\''; SELECT id,title,status,confidence FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\''::uuid;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_name, column_name FROM information_schema.columns WHERE table_schema = '\\''public'\\'' AND table_name IN ('\\''aic_indexing_runs'\\'', '\\''aic_files'\\'', '\\''aic_chunks'\\'', '\\''aic_knowledge_items'\\'', '\\''aic_embeddings'\\'') ORDER BY table_name, ordinal_position;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'',finished_at=NOW(),stats='\\''{\"files_added\":1,\"files_updated\":4,\"documents_added\":0,\"documents_updated\":0,\"knowledge_items_added\":1,\"deleted_chunks\":10,\"code_chunks_added\":14,\"knowledge_chunks_added\":1,\"embeddings_to_generate\":15,\"embeddings_generated\":15,\"chunks_retained_with_existing_embeddings\":611,\"stale_embeddings\":0,\"missing_embeddings\":0,\"embedding_model\":\"text-embedding-3-small\",\"embedding_dimensions\":1536,\"symbol_relations\":0,\"hnsw_index\":\"aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e\",\"final_project_files\":391,\"final_project_symbols\":799,\"final_project_documents\":25,\"active_knowledge_items\":12,\"final_project_chunks\":626,\"final_project_embeddings\":626}'\\''::jsonb WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\'' AND status='\\''running'\\'' RETURNING id,status,finished_at,stats;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'',finished_at=NOW(),stats=jsonb_build_object('\\''files_added'\\'',1,'\\''files_updated'\\'',4,'\\''documents_added'\\'',0,'\\''documents_updated'\\'',0,'\\''knowledge_items_added'\\'',1,'\\''deleted_chunks'\\'',10,'\\''code_chunks_added'\\'',14,'\\''knowledge_chunks_added'\\'',1,'\\''embeddings_to_generate'\\'',15,'\\''embeddings_generated'\\'',15,'\\''chunks_retained_with_existing_embeddings'\\'',611,'\\''stale_embeddings'\\'',0,'\\''missing_embeddings'\\'',0,'\\''embedding_model'\\'','\\''text-embedding-3-small'\\'','\\''embedding_dimensions'\\'',1536,'\\''symbol_relations'\\'',0,'\\''hnsw_index'\\'','\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'','\\''final_project_files'\\'',391,'\\''final_project_symbols'\\'',799,'\\''final_project_documents'\\'',25,'\\''active_knowledge_items'\\'',12,'\\''final_project_chunks'\\'',626,'\\''final_project_embeddings'\\'',626) WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\'' AND status='\\''running'\\'' RETURNING id,status,finished_at,stats;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') SELECT '\\''file_rows'\\'' AS metric, count(*)::text AS value FROM aic_files WHERE project_id=(SELECT id FROM p) UNION ALL SELECT '\\''nondeleted_files'\\'', count(*)::text FROM aic_files WHERE project_id=(SELECT id FROM p) AND is_deleted=false UNION ALL SELECT '\\''deleted_files'\\'', count(*)::text FROM aic_files WHERE project_id=(SELECT id FROM p) AND is_deleted=true UNION ALL SELECT '\\''chunks_code'\\'', count(*)::text FROM aic_chunks WHERE project_id=(SELECT id FROM p) AND source_type='\\''code'\\'' UNION ALL SELECT '\\''chunks_document'\\'', count(*)::text FROM aic_chunks WHERE project_id=(SELECT id FROM p) AND source_type='\\''document'\\'' UNION ALL SELECT '\\''chunks_knowledge'\\'', count(*)::text FROM aic_chunks WHERE project_id=(SELECT id FROM p) AND source_type='\\''knowledge'\\'' UNION ALL SELECT '\\''knowledge_status'\\'', status||'\\'': '\\''||count(*) FROM aic_knowledge_items WHERE project_id=(SELECT id FROM p) GROUP BY status UNION ALL SELECT '\\''unembedded_chunks'\\'', count(*)::text FROM aic_chunks c WHERE c.project_id=(SELECT id FROM p) AND NOT EXISTS (SELECT 1 FROM aic_embeddings e WHERE e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid);\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') SELECT '\\''files'\\'' AS entity, count(*) FROM aic_files WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''symbols'\\'', count(*) FROM aic_symbols WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''relations'\\'', count(*) FROM aic_symbol_relations WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''documents'\\'', count(*) FROM aic_documents WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''knowledge_items'\\'', count(*) FROM aic_knowledge_items WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''chunks'\\'', count(*) FROM aic_chunks WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''embeddings'\\'', count(*) FROM aic_embeddings WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''runs'\\'', count(*) FROM aic_indexing_runs WHERE project_id = (SELECT id FROM p); SELECT m.id, m.provider, m.model, m.dimensions, m.enabled, count(e.id) AS embedding_count FROM aic_embedding_models m LEFT JOIN aic_embeddings e ON e.embedding_model_id = m.id AND e.project_id = (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') GROUP BY m.id ORDER BY m.model; SELECT id, run_type, status, git_commit, started_at, finished_at, stats, error_message FROM aic_indexing_runs WHERE project_id = (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') ORDER BY started_at DESC LIMIT 10; SELECT indexname, indexdef FROM pg_indexes WHERE schemaname = current_schema() AND tablename = '\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%7f2841b6-c020-46ef-9597-72ac54812b45%'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\"' < /tmp/easyfit-index/easyfit-pl-index.sql"],["/