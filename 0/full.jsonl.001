 pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_name, column_name, data_type FROM information_schema.columns WHERE table_schema = '\\''public'\\'' AND table_name IN ('\\''aic_indexing_runs'\\'', '\\''aic_files'\\'') ORDER BY table_name, ordinal_position;\" -c \"SELECT id, status, git_commit, stats, created_at, updated_at FROM aic_indexing_runs WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' ORDER BY created_at DESC LIMIT 3;\" -c \"SELECT s.id, f.path, s.kind, s.name, s.qualified_name, s.start_line, s.end_line, s.parent_symbol_id FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' ORDER BY f.path,s.start_line LIMIT 25;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_name,column_name,data_type FROM information_schema.columns WHERE table_name IN ('\\''aic_embeddings'\\'', '\\''aic_indexing_runs'\\'') ORDER BY table_name,ordinal_position; SELECT id,provider,model,dimensions FROM aic_embedding_models WHERE model='\\''text-embedding-3-small'\\''; SELECT id,status,started_at,completed_at FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 3;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'', finished_at=NOW(), error_message=NULL, stats=stats || jsonb_build_object(''chunks_retained_with_existing_embeddings'', 524, ''final_project_files'', 390, ''final_project_documents'', 25, ''final_project_chunks'', 62