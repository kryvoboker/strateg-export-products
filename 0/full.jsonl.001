e Vue template.`);lines.splice(item.line-1,0,...comments)}fs.writeFileSync(path,lines.join(\"\\n\"))}console.log(`Added ${grouped.size} targeted suppressions across ${files.size} Vue files.`)'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && node -e '\\''const fs=require(\"fs\");const x=JSON.parse(fs.readFileSync(\"/tmp/biome-diagnostics.json\",\"utf8\"));const seen=new Set();for(const d of x.diagnostics??[]){if(!d.category?.includes(\"noUnused\"))continue;const p=d.location.path,n=d.location.start.line,s=fs.readFileSync(p,\"utf8\").split(/\\n/)[n-1];const key=p+\":\"+n;if(seen.has(key))continue;seen.add(key);const m=s.match(/(?:const|function|import)\\s+(?:\\{\\s*)?([\\w$]+)/);const name=m?.[1]??\"?\";const tpl=fs.readFileSync(p,\"utf8\").split(/<template[^>]*>/)[1]?.split(/<\\/template>/)[0]??\"\";console.log(`${key} ${name} template=${new RegExp(`\\\\b${name}\\\\b`).test(tpl)} | ${s.trim()}`)}'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && node -e '\\''const fs=require(\"fs\");const x=JSON.parse(fs.readFileSync(\"/tmp/biome-diagnostics.json\",\"utf8\"));for(const d of x.diagnostics??[]){if(!d.category?.includes(\"noUnused\"))continue;const p=d.location.path,s=fs.readFileSync(p,\"utf8\");const at=d.location.start;const line=s.split(/\\n/)[at.line-1];const col=at.column-1;const token=line.slice(col,d.location.end.column-1);const tpl=s.split(/<template[^>]*>/)[1]?.split(/<\\/template>/)[0]??\"\";console.log(`${p}:${at.line} ${d.category.split(\"/\").pop()} ${token} template=${tpl.includes(token)}`)}'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && node -e '\\''const fs=require(\"fs\");const x=JSON.parse(fs.readFileSync(\"/tmp/biome-diagnostics.json\",\"utf8\"));for(const d of x.diagnos