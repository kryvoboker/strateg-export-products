, count(*) FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT path, content_hash, is_deleted, indexed_at FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'', '\\''httpdocs/frontend/i18n/locales/en.json'\\'', '\\''httpdocs/frontend/i18n/locales/uk.json'\\'') ORDER BY path;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.id,k.kind,k.title,k.status,k.confidence,k.source_reference,count(c.id) AS linked_chunks,count(e.id) AS linked_embeddings FROM aic_knowledge_items k LEFT JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE k.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND k.title='\\''Complaint list frontend flow and filter state'\\'' GROUP BY k.id; SELECT c.source_type,count(*) AS chunks,count(e.id) AS embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (f.path LIKE '\\''httpdocs/frontend/%Complaint%'\\'' OR c.knowledge_item_id IN (SELECT id FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\'')) GROUP BY c.source_type ORDER BY c.source_type;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-inte