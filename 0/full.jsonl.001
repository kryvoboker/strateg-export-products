e,git_commit FROM aic_indexing_runs WHERE id='\\''7c2c4a9a-bd04-48cb-8736-56145e5541b4'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw%\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT last_indexed_commit, count(*) FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' GROUP BY last_indexed_commit ORDER BY count(*) DESC LIMIT 12;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT table_name,column_name FROM information_schema.columns WHERE table_schema = '\\''public'\\'' AND table_name IN ('\\''aic_files'\\'', '\\''aic_symbols'\\'', '\\''aic_symbol_relations'\\'', '\\''aic_chunks'\\'', '\\''aic_embeddings'\\'') ORDER BY table_name, ordinal_position;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT (SELECT count(*) FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT is_deleted) AS files, (SELECT count(*) FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status='\\''active'\\'') AS knowledge, (SELECT count(*) FROM aic_symbols WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS symbols, (SELECT count(*) FROM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS relations, (SELECT count(*) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-