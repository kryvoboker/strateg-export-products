SELECT COUNT(*) FROM aic_embeddings WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid) AS embeddings, (SELECT COUNT(*) FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid AND e.source_content_hash <> c.content_hash) AS stale_embeddings; SELECT COUNT(*) AS symbol_relations FROM aic_symbol_relations WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT id,status,stats FROM aic_indexing_runs WHERE id = '\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT COUNT(*) FROM aic_files WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND is_deleted=FALSE) AS files,(SELECT COUNT(*) FROM aic_symbols WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS symbols,(SELECT COUNT(*) FROM aic_documents WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS documents,(SELECT COUNT(*) FROM aic_knowledge_items WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status='\\''active'\\'') AS knowledge,(SELECT COUNT(*) FROM aic_chunks WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS chunks,(SELECT COUNT(*) FROM aic_embeddings WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid) AS embeddings,(SELECT COUNT(*) FROM aic_symbol_relations WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS relations; SELECT COUNT(*) AS stale FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid AND e.source_content_hash<>c.content_hash; SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_a05ac957939f_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COUNT(*) AS chunks FROM aic_chunks WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS embeddings FROM aic_embeddings WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COUNT(*) AS files FROM aic_files WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND is_deleted = FALSE; SELECT COUNT(*) AS symbols FROM aic_symbols WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS documents FROM aic_documents WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS knowledge FROM aic_knowledge_items WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status = '\\''active'\\''; SELECT COUNT(*) AS chunks FROM aic_chunks WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS embeddings FROM aic_embeddings WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COUNT(*) AS fts_search_results FROM aic_search_chunks_text('\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid,'\\''product export'\\'',5); SELECT COUNT(*) AS exact_vector_search_results FROM aic_search_chunks_vector_exact('\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid,'\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid,(SELECT embedding FROM aic_embeddings WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1),5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COUNT(*) AS hnsw_search_results FROM aic_search_chunks_vector_hnsw('\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid,'\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid,(SELECT embedding FROM aic_embeddings WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1),5); SELECT id,status,finished_at,stats FROM aic_indexing_runs WHERE id='\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) FILTER (WHERE kind='\\''method'\\'' AND qualified_name IS NOT NULL) AS misleading_method_fqns FROM aic_symbols WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT indexname, indexdef FROM pg_indexes WHERE schemaname = current_schema() AND indexname = '\\''aic_emb_hnsw_p_a05ac957939f_m_7f16f2a76e0e'\\''; SELECT COUNT(*) AS embeddings, COUNT(*) FILTER (WHERE dimensions <> 1536) AS wrong_dimensions, COUNT(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid; SELECT COUNT(*) AS unmatched_chunks FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.id IS NULL; SELECT COUNT(*) AS persisted_result_batches FROM aic_indexing_runs r, jsonb_array_elements(r.metadata->'embedding_batches') AS batch WHERE r.id = '\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_schema,table_name FROM information_schema.views WHERE table_name ILIKE '\\''%retrieval%'\\'' OR table_name ILIKE '\\''%chunk%'\\'' ORDER BY table_schema,table_name; SELECT to_regclass('\\''v_retrieval_chunks'\\'') AS resolved_view; SELECT id,status,finished_at,stats FROM aic_indexing_runs WHERE id='\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS method_symbols_with_fqn FROM aic_symbols WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND kind='\\''method'\\'' AND qualified_name IS NOT NULL;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET stats = jsonb_build_object('\\''planned_files'\\'',376,'\\''planned_code_files'\\'',355,'\\''planned_symbols'\\'',1918,'\\''planned_documents'\\'',21,'\\''planned_knowledge_items'\\'',6,'\\''planned_chunks'\\'',1028), metadata = metadata || jsonb_build_object('\\''embedding_script'\\'