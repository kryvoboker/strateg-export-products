LE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, p.name, p.active, (SELECT COUNT(*) FROM aic_files f WHERE f.project_id=p.id AND f.is_deleted=FALSE) AS files, (SELECT COUNT(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''code'\\'') AS code_chunks, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''document'\\'') AS document_chunks, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''knowledge'\\'') AS knowledge_chunks, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id=p.id) AS embeddings, (SELECT COUNT(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS active_knowledge FROM aic_projects p WHERE p.slug='\\''office-easyfit'\\'';\" -c \"SELECT COUNT(*) AS stale FROM aic_projects p JOIN aic_embeddings e ON e.project_id=p.id JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE p.slug='\\''office-easyfit'\\'' AND e.source_content_hash <> c.content_hash;\" -c \"SELECT id, run_type, status, started_at, stats FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') ORDER BY started_at DESC LIMIT 8;\" -c \"SELECT kind, title, source_reference, status, confidence FROM aic_knowledge_items WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') AND status='\\''active'\\'' ORDER BY created_at DESC LIMIT 20;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_reference, title, rank FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''SiteController'\\'', 5);\" -c \"SELECT * FROM aic_search_symbols_fuzzy('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''SiteController'\\'', 5);\"'"],["/bin/bash","-lc","dock