" -d \"$POSTGRES_DB\" -c \"SELECT c.content_hash = encode(digest(convert_to(c.content,'\\''UTF8'\\''),'\\''sha256'\\''),'\\''hex'\\'') FROM aic_chunks c WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_embedding_models (id, provider, model, dimensions, distance_metric, enabled, metadata) VALUES ('\\''75057a8a-8980-43a8-9487-7b0945fd8233'\\''::uuid, '\\''openai'\\'', '\\''text-embedding-3-small'\\'', 1536, '\\''cosine'\\'', TRUE, '\\''{\\\"source\\\":\\\"ai-code-intelligence docs/getting-started.md\\\"}'\\''::jsonb) ON CONFLICT (provider, model) DO UPDATE SET dimensions=EXCLUDED.dimensions, distance_metric=EXCLUDED.distance_metric, enabled=TRUE RETURNING id, provider, model, dimensions;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_projects (id, name, slug, root_path, default_branch, metadata) VALUES ('\\''3c7f07bd-bcb6-4516-908e-bc0fc8eb52cf'\\''::uuid, '\\''Easyfit PL'\\'', '\\''easyfit-pl'\\'', '\\''/home/kamaz/www/easyfit-projects/easyfit-pl.com'\\'', '\\''main'\\'', '\\''{\\\"index_scope\\\":\\\"OpenCart source, docs, and front-end source; secrets/vendor/runtime excluded\\\"}'\\''::jsonb) ON CONFLICT (slug) DO UPDATE SET name=EXCLUDED.name, root_path=EXCLUDED.root_path, active=TRUE RETURNING id, name, slug;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.id, c.chunk_type, c.sequence_number, c.start_line, c.end_line, c.metadata, c.content_hash, e.source_content_hash FROM aic_projects p JOIN aic_files f ON f.project_id = p.id JOIN aic_chunks c ON c.project_id = p.id AND c.file_id = f.id LEFT JOIN aic_embeddings e ON e.project_id = p.id AND e.chunk_id = c.id WHERE p.slug = '\\''pet-complaints-platform'\\'' AND f.path = '\\''httpdocs/frontend/app/components/AppFooter.vue'\\'' AND f.is_deleted = FALSE; SELECT indexname FROM pg_indexes WHERE schemaname = '\\''public'\\'' AND tablename = '\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_embeddings_project_%'\\'';\"' && docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'node -e '\\''const fs=require(\"fs\"); for (const f of process.argv.slice(1)){const v=JSON.parse(fs.readFileSync(f)); console.log(JSON.stringify({file:f,count:v.length,dimensions:v[0]?.length}));}'\\'' /app/embedding-results/2026/10/pet-complaints-platform-app-footer-script-c2626174.json /app/embedding-results/2026/10/pet-complaints-platform-app-footer-template-3e1f214e.json'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT chunk_id,source_type,source_reference,title,left(content,180) AS content_preview FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid,'\\''complaint category rel nofollow filter state'\\'',10);\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT count(*) AS matching_knowledge_titles FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\''; SELECT count(*) AS old_code_chunks FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND 