resql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id,slug FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'' AND active=TRUE; SELECT chunk_id,source_reference,title,rank,left(content,420) AS content FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'' AND active=TRUE),'\\''container'\\'',8);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT indexname, indexdef FROM pg_indexes WHERE schemaname=current_schema() AND tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_%'\\'' AND indexdef LIKE '\\''%9cb2ac9e-7047-4353-812c-35ecbb51289f%'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT kind, title, source_reference, left(content, 220) AS content_preview FROM aic_knowledge_items WHERE project_id = '\\''7f2841b6-c020-46ef-9597-72ac54812b45'\\''::uuid AND status = '\\''active'\\'' ORDER BY kind, title;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT n.nspname, p.proname, pg_get_function_identity_arguments(p.oid) AS args FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE p.proname ILIKE '\\''%search%chunk%text%'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id AS project_id, p.slug, p.name, em.id AS model_id, em.provider, em.model, em.dimensions FROM aic_projects p LEFT JOIN aic_embedding_models em ON em.provider = '\\''openai'\\'' AND em.model = '\\''text-embedding-3-small'\\'' WHERE p.slug = '\\''pet-complaints-platform'\\''; SELECT r.id, r.run_type, r.status, r.started_at, r.finished_at, r.stats FROM aic_indexing_runs r JOIN aic_projects p ON p.id = r.project_id WHERE p.slug = '\\''pet-complaints-platform'\\'' ORDER BY r.started_at DESC LIMIT 10; SELECT p.slug, (SELECT COUNT(*) FROM aic_files f WHERE f.project_id = p.id AND NOT f.is_deleted) AS files, (SELECT COUNT(*) FROM aic_symbols s WHERE s.project_id = p.id) AS symbols, (SELECT COUNT(*) FROM aic_symbol_relations sr WHERE sr.project_id = p.id) AS relations, (SELECT COUNT(*) FROM aic_documents d WHERE d.project_id = p.id) AS documents, (SELECT COUNT(*) FROM aic_knowledge_items k WHERE k.project_id = p.id) AS knowledge, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id = p.id) AS chunks, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id = p.id) AS embeddings FROM aic_projects p WHERE p.slug = '\\''pet-complaints-platform'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.name, p.slug, (SELECT count(*) FROM aic_files f WHERE f.project_id = p.id AND NOT f.is_deleted) AS files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id = p.id) AS symbols, (SELECT count(*) FROM aic_symbol_relations r WHERE r.project_id = p.id) AS relations, (SELECT count(*) FROM aic_indexing_runs ir WHERE ir.project_id = p.id) AS runs FROM aic_projects p WHERE p.slug = '\\''pet-complaints-platform'\\'' AND p.active = TRUE;\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.name, p.slug, p.root_path, p.active FROM aic_projects p WHERE p.slug = '\\''strateg-export-products'\\''; SELECT em.id, em.provider, em.model, em.dimensions FROM aic_embedding_models em WHERE em.model = '\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, p.active, (SELECT count(*) FROM aic_files f WHERE f.project_id=p.id AND NOT f.is_deleted) AS files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS active_knowledge, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id) AS embeddings FROM aic_projects p WHERE p.slug='\\''pet-complaints-platform'\\''; SELECT m.id, m.provider, m.model, m.dimensions, m.enabled FROM aic_embedding_models m WHERE m.provider='\\''openai'\\'' AND m.model='\\''text-embedding-3-small'\\''; SELECT id, status, started_at, completed_at, stats, metadata FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''pet-complaints-platform'\\'') ORDER BY started_at DESC LIMIT 10;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.name,p.slug,p.root_path,r.id AS run_id,r.status,r.git_commit,r.stats->> '\\''files'\\'' AS stat_files,r.stats->> '\\''symbols'\\'' AS stat_symbols,r.stats->> '\\''chunks'\\'' AS stat_chunks,(SELECT count(*) FROM aic_files f WHERE f.project_id=p.id) AS files,(SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols,(SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents,(SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS knowledge,(SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks,(SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.embedding_model_id=m.id) AS embeddings,(SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.embedding_model_id=m.id AND (e.dimensions<>1536 OR vector_dims(e.embedding)<>1536 OR e.source_content_hash<> (SELECT c.content_hash FROM aic_chunks c WHERE c.project_id=e.project_id AND c.id=e.chunk_id))) AS invalid_embeddings,(SELECT count(*) FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_9cb2ac9e704b_m_0e87a4a94b79'\\'') AS expected_hnsw_index FROM aic_projects p JOIN aic_indexing_runs r ON r.project_id=p.id JOIN aic_embedding_models m ON m.provider='\\''openai'\\'' AND m.model='\\''text-embedding-3-small'\\'' WHERE p.slug='\\''easyfit-ua'\\'' AND p.id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid AND r.id='\\''eec76587-38a0-4e2a-af2b-68f7c5c5ed9f'\\''::uuid; SELECT kind,title,source_reference,status,confidence FROM aic_knowledge_items WHERE project_id='\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid ORDER BY kind,title;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.slug,s.chunk_id,s.source_type,s.source_reference,s.title,s.rank,left(s.content,650) AS content FROM aic_projects p CROSS JOIN LATERAL aic_search_chunks_text(p.id, '\\''homepage desktop container margin spacing layout'\\'', 8) s WHERE p.slug='\\''pet-complaints-platform'\\'' AND p.active=TRUE ORDER BY s.rank;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.name, p.slug, p.id, r.id AS run_id, r.status, r.finished_at, r.stats FROM aic_projects p JOIN aic_indexing_runs r ON r.project_id=p.id WHERE p.slug='\\''syvak-ua'\\'' AND r.id='\\''ff8290f4-4baa-4dd6-a2bf-cdd6f89bdeee'\\''::uuid; SELECT COUNT(*) FILTER (WHERE e.dimensions <> 1536 OR vector_dims(e.embedding) <> 1536) AS bad_dimensions, COUNT(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale_source_hashes, COUNT(*) AS embeddings FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id JOIN aic_projects p ON p.id=e.project_id WHERE p.slug='\\''syvak-ua'\\''; SELECT COUNT(*) AS chunks_without_embeddings FROM aic_chunks c JOIN aic_projects p ON p.id=c.project_id WHERE p.slug='\\''syvak-ua'\\'' AND NOT EXISTS (SELECT 1 FROM aic_embeddings e WHERE e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid); SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_b551d9ee60dd_m_7f16f2a76e0e'\\''; SELECT status, COUNT(*) FROM aic_indexing_runs r JOIN aic_projects p ON p.id=r.project_id WHERE p.slug='\\''syvak-ua'\\'' GROUP BY status ORDER BY status;\"' && find /home/kamaz/www/hobby/ai-code-intelligence/app/embedding-results/syvak-ua/2026/10 -maxdepth 1 -type f -name 'syvak-ua-full-20261008-batch-*.json' | wc -l && ls -l /home/kamaz/www/hobby/ai-code-intelligence/app