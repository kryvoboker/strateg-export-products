='\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%hnsw%'\\'' ORDER BY indexname;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT s.source_reference,s.rank FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, '\\''category'\\'', 100) s WHERE s.source_reference='\\''httpdocs/frontend/app/pages/index.vue'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT schemaname,viewname FROM pg_views WHERE viewname ILIKE '\\''%retrieval%chunk%'\\'' ORDER BY schemaname,viewname;\"' && rg -n 'v_retrieval_chunks|CREATE.*VIEW' /home/kamaz/www/hobby/ai-code-intelligence/docker-entrypoint-initdb.d/002_schema.sql /home/kamaz/www/hobby/ai-code-intelligence/docker-entrypoint-initdb.d/004_views_and_search_functions.sql"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT sequence_number, content LIKE '\\''%categories%'\\'' AS has_categories, search_vector IS NOT NULL AS vector_present, search_vector @@ plainto_tsquery('\\''simple'\\'', '\\''categories'\\'') AS fts_hit FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND file_id='\\''d0f6680a-5956-4efc-a89b-1ea7505d3c97'\\'' ORDER BY sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v