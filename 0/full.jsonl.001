 exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_reference,title,rank,left(content,100) AS match FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, '\\''max-w-7xl homepage layout'\\'', 5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_type, chunk_type, COALESCE(metadata->>'\\''chunking'\\'', '\\''(none)'\\'') AS chunking, count(*) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid GROUP BY source_type, chunk_type, metadata->>'\\''chunking'\\'' ORDER BY source_type, chunk_type, chunking;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_type, file_path, left(content, 600) AS excerpt FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''Yii2 Yii3 migration authentication inventory order product routing'\\'', 8);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT status, finished_at FROM aic_indexing_runs WHERE id = '\\''d099058c-e63c-42a5-8082-6c6080b787fd'\\''::uuid AND project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT status,run_type,started_at,finished_at,stats,metadata FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 2; SELECT indexname,indexdef FROM pg_indexes WHERE tablename='\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%9da19a96-c510-418b-8cbe-52572c2a89fd%'\\''; SELECT indexname,indexdef FROM pg_indexes WHERE tablename='\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%UNIQUE%'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_name,column_name,data_type FROM information_schema.columns WHERE table_name IN ('\\''aic_embeddings'\\'', '\\''aic_indexing_runs'\\'') ORDER BY table_name,ordinal_position; SELECT id,provider,model,dimensions FROM aic_embedding_models WHERE model='\\''text-embedding-3-small'\\''; SELECT id,status,started_at,completed_at FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 3;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'', finished_at=NOW(), error_message=NULL, stats=stats || jsonb_build_object(''chunks_retained_with_existing_embeddings'', 524, ''final_project_files'', 390, ''final_project_documents'', 25, ''final_project_chunks'', 621, ''final_project_embeddings'', 621, ''embedding_model'', ''text-embedding-3-small'', ''embedding_dimensions'', 1536, ''embeddings_generated'', 97, ''missing_embeddings'', 0, '