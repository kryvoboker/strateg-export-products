HERE id='\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status='\\''running'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -c \"SELECT aic_create_project_embedding_hnsw_index('\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid, '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"COPY (SELECT f.path,s.id::text,s.kind,s.name,COALESCE(s.qualified_name,''''),COALESCE(s.signature,''''),COALESCE(s.parent_symbol_id::text,''''),COALESCE(s.start_line,0),COALESCE(s.end_line,0) FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND p.active=TRUE AND f.is_deleted=FALSE ORDER BY f.path,s.start_line,s.id) TO STDOUT WITH (FORMAT csv, HEADER true);\"' > /tmp/office-easyfit-symbols.csv"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT COUNT(*) FROM aic_files WHERE project_id=p.id AND is_deleted=FALSE) AS files,(SELECT COUNT(*) FROM aic_symbols WHERE project_id=p.id) AS symbols,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''code'\\'') AS code_chunks,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''document'\\'') AS document_chunks,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''knowledge'\\'') AS knowledge_chunks,(SELECT COUNT(*) FROM aic_embeddings WHERE project_id=p.id) AS embeddings,(SELECT COUNT(*) FROM aic_knowledge_items WHERE project_id=p.id AND status='\\''active'\\'') AS active_knowledge FROM aic_projects p WHERE p.slug='\\''office-easyfit'\\'';\" -c \"SELECT s.kind,COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT COUNT(*) AS stale_vectors FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id JOIN aic_projects p ON p.id=e.project_id WHERE p.slug='\\''office-easyfit'\\'' AND e.source_content_hash<>c.content_hash;\" -c \"SELECT f.path,f.content_hash,f.size_bytes FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''.docker/dev/docker-compose.yml'\\'','\\''.docker/dev/nginx/nginx.conf'\\'') ORDER BY f.path;\" -c \"SELECT id,status,stats FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') AND id='\\''d91cdd1a-ac7b-4031-9b09-1af10edb466c'\\'';\" -c \"SELECT COUNT(*) AS hnsw_indexes FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_7f2841b6c020_m_7f16f2a76e0e'\\'';\" -c \"SELECT source_reference,title FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\''),'\\''supplier URL rendering output safety'\\'',5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT * FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''Yii2 SiteController login authentication captcha commands yii3 bootstrap'\\'', 8);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.id,f.path,f.content_hash FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''.docker/dev/docker-compose.yml'\\'','\\''.docker/dev/nginx/nginx.conf'\\'') ORDER BY f.path;\" -c \"SELECT id,model_name,dimensions FROM aic_embedding_models WHERE model_name='\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.language,f.file_type,COUNT(*) FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.is_deleted=FALSE GROUP BY f.language,f.file_type ORDER BY f.language,f.file_type;\" -c \"SELECT path,language,file_type FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.is_deleted=FALSE AND language='\\''php'\\'' ORDER BY path LIMIT 8;\" -c \"SELECT s.kind,COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.size_bytes, f.indexed_at, COUNT(c.id) AS chunks, COUNT(e.id) AS embeddings FROM aic_projects p JOIN aic_files f ON f.project_id=p.id LEFT JOIN aic_chunks c ON c.project_id=p.id AND c.file_id=f.id AND c.source_type='\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id=p.id AND e.chunk_id=c.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''\\.docker/dev/docker-compose.yml'\\'','\\''\\.docker/dev/nginx/nginx.conf'\\'') GROUP BY f.path,f.content_hash,f.size_bytes,f.indexed_at ORDER BY f.path;\" -c \"SELECT s.kind, COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT d.path, d.title FROM aic_projects p JOIN aic_documents d ON d.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' ORDER BY d.path;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_7f2841b6c020_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.size_bytes, f.indexed_at, c.id AS chunk_id, c.sequence_number, c.start_line, c.end_line, c.content_hash AS chunk_hash, length(c.content) AS chars, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.chunk_id=c.id) AS vector_count FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_chunks c ON c.project_id=p.id AND c.file_id=f.id AND c.source_type='\\''code'\\'' WHERE p.slug='\\''office-easyfit'\\'' AND f.path LIKE '\\''\\.docker/dev/%'\\'' ORDER BY f.path,c.sequence_number;\" -c \"SELECT COUNT(*) AS potential_supplier_knowledge FROM aic_projects p JOIN aic_knowledge_items k ON k.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND k.status='\\''active'\\'' AND (k.title ILIKE '\\''%supplier%'\\'' OR k.content ILIKE '\\''%supplier url%'\\'');\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.id,s.kind,s.name,s.qualified_name,s.parent_symbol_id,s.start_line FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path='\\''httpdocs/models/Product.php'\\'' AND s.kind='\\''method'\\'' ORDER BY s.start_line LIMIT 25;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.id,s.kind,s.name,s.qualified_name,s.parent_symbol_id,s.start_line,s.end_line FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND s.kind IN ('\\''function'\\'','\\''class'\\'') AND f.path IN ('\\''httpdocs/controllers/ProductController.php'\\'','\\''httpdocs/globals/pl/controllers/ProductController.php'\\'','\\''httpdocs/models/Product.php'\\'') ORDER BY f.path,s.start_line LIMIT 50;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.id,s.kind,s.name,s.qualified_name,s.parent_symbol_id,s.start_line,s.end_line,s.signature FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path='\\''httpdocs/controllers/ProductController.php'\\'' ORDER BY s.start_line,s.end_line LIMIT 35;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug, root_path FROM aic_projects WHERE slug = '\\''yii3-office-easyfit'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id,provider,model,dimensions FROM aic_embedding_models WHERE model='\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.id,k.title,k.status,k.updated_at FROM aic_projects p JOIN aic_knowledge_items k ON k.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' ORDER BY k.title;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.title,k.status,k.source_reference,c.id AS chunk_id,length(c.content) AS chars,c.content_hash,e.dimensions,e.source_content_hash=c.content_hash AS vector_matches FROM aic_projects p JOIN aic_knowledge_items k ON k.project_id=p.id JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE p.slug='\\''office-easyfit'\\'' AND k.id='\\''534b2162-a0c7-4f93-b051-af40d063649e'\\'';\" -c \"SELECT source_reference,title FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\''),'\\''supplier'\\'',5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, p.name, p.active, (SELECT COUNT(*) FROM aic_files f WHERE f.project_id=p.id AND f.is_deleted=FALSE) AS files, (SELECT COUNT(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''code'\\'') AS code_chunks, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''document'\\'') AS document_chunks, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''knowledge'\\'') AS knowledge_chunks, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id=p.id) AS embeddings, (SELECT COUNT(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS active_knowledge FROM aic_projects p WHERE p.slug='\\''office-easyfit'\\'';\" -c \"SELECT COUNT(*) AS stale FROM aic_projects p JOIN aic_embeddings e ON e.project_id=p.id JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE p.slug='\\''office-easyfit'\\'' AND e.source_content_hash <> c.content_hash;\" -c \"SELECT id, run_type, status, started_at, stats FROM aic_indexing_runs WH