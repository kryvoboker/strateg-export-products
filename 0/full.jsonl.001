ge_items WHERE project_id=p.id AND status='\\''active'\\'') AS active_knowledge FROM aic_projects p WHERE p.slug='\\''office-easyfit'\\'';\" -c \"SELECT s.kind,COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT COUNT(*) AS stale_vectors FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id JOIN aic_projects p ON p.id=e.project_id WHERE p.slug='\\''office-easyfit'\\'' AND e.source_content_hash<>c.content_hash;\" -c \"SELECT f.path,f.content_hash,f.size_bytes FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''.docker/dev/docker-compose.yml'\\'','\\''.docker/dev/nginx/nginx.conf'\\'') ORDER BY f.path;\" -c \"SELECT id,status,stats FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') AND id='\\''d91cdd1a-ac7b-4031-9b09-1af10edb466c'\\'';\" -c \"SELECT COUNT(*) AS hnsw_indexes FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_7f2841b6c020_m_7f16f2a76e0e'\\'';\" -c \"SELECT source_reference,title FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\''),'\\''supplier URL rendering output safety'\\'',5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT * FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''Yii2 SiteController login authentication captcha commands yii3 bootstrap'\\'', 8);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.id,f.path,f.content_hash FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'