:${n}: ${d.category.split(\"/\").pop()}: ${s.trim()}`)}}'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && node -e '\\''const fs=require(\"fs\");const {parse,compileTemplate}=require(\"@vue/compiler-sfc\");const filename=\"app/components/AppHeader.vue\";const source=fs.readFileSync(filename,\"utf8\");const parsed=parse(source,{filename});console.log(parsed.errors);const result=compileTemplate({source:parsed.descriptor.template.content,filename,id:\"test\"});console.log(result.errors);'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && node -e '\\''const fs=require(\"fs\");const {parse}=require(\"@vue/compiler-sfc\");const filename=\"app/components/AppHeader.vue\";const result=parse(fs.readFileSync(filename,\"utf8\"),{filename});console.log(result.errors.map(({message,loc})=>({message,line:loc.start.line,column:loc.start.column,source:loc.source})));'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && npx biome lint . --max-diagnostics=none --reporter=json > /tmp/biome-diagnostics.json && node -e '\\''const fs=require(\"fs\");const x=JSON.parse(fs.readFileSync(\"/tmp/biome-diagnostics.json\",\"utf8\"));for(const d of x.diagnostics??[])console.log([d.severity,d.category,d.location?.path,d.location?.span?.start,d.message].join(\"\\t\"));console.error(JSON.stringify(x.summary))'\\'''"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T pet-complaints-platform-nodejs sh -lc 'cd /var/www/html && npx biome lint . --max-diagnostics=none --reporter=json > /tmp/biome-diagnostics.json && node -e '\\''const fs=require(\"fs\");const x=JSON.parse(fs.readFileSync(\"/tmp/biome-diagnostics.json\",\"utf8\"));for(const d of x.diagnostics??[]){if(d.category?.includes(\"noUnused\")){cons