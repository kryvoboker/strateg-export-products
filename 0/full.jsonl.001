ge(current_user,c.oid,'\\''TRIGGER'\\'') AS can_trigger FROM pg_class c WHERE c.relname IN ('\\''aic_files'\\'', '\\''aic_symbols'\\'', '\\''aic_documents'\\'', '\\''aic_knowledge_items'\\'', '\\''aic_chunks'\\'', '\\''aic_embeddings'\\'', '\\''aic_indexing_runs'\\'') ORDER BY c.relname; SELECT routine_name, grantee, privilege_type FROM information_schema.routine_privileges WHERE routine_schema='\\''public'\\'' AND routine_name='\\''aic_create_project_embedding_hnsw_index'\\'' ORDER BY grantee;\"' "],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, kind, title, content, source_reference, status, confidence FROM aic_knowledge_items WHERE project_id = '\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND status = '\\''active'\\'' ORDER BY kind, title;\"'"],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, name, slug, root_path, active FROM aic_projects WHERE slug = '\\''strateg-ua'\\'' OR root_path = '\\''/home/kamaz/www/strateg-projects/dev.strateg.ua'\\''; SELECT table_name, column_name, is_nullable, column_default FROM information_schema.columns WHERE table_schema = '\\''public'\\'' AND table_name IN ('\\''aic_embedding_models'\\'', '\\''aic_indexing_runs'\\'') ORDER BY table_name, ordinal_position;\"' "],["/bin/bash","-lc","docker compose -f ../../hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT slug, id, name, root_path, active FROM aic_projects WHERE slug = '\\''dev-strateg-ua'\\'' OR root