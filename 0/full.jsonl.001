yfit-pl'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -AtF \"|\" -c \"SELECT '\\''F'\\'', f.path, f.id, f.file_type, COALESCE(f.language,'\\'''\\''), COALESCE(f.content_hash,'\\'''\\'') FROM aic_files f WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT f.is_deleted UNION ALL SELECT '\\''D'\\'', d.path, d.id, d.document_type, d.title, COALESCE(d.content_hash,'\\'''\\'') FROM aic_documents d WHERE d.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY 1,2;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -AtF \"|\" -c \"SELECT f.path,c.chunk_type,count(*) FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/assets/css/main.css'\\'', '\\''httpdocs/frontend/app/components/CommentSection.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'', '\\''httpdocs/frontend/app/components/PetCard.vue'\\'', '\\''httpdocs/frontend/app/components/PetFollowButton.vue'\\'', '\\''httpdocs/frontend/app/components/ReactionBar.vue'\\'', '\\''httpdocs/frontend/app/components/ShareButton.vue'\\'', '\\''httpdocs/frontend/app/components/VerdictPanel.vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/[slug].vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'', '\\''httpdocs/frontend/app/pages/index.vue'\\'', '\\''httpdocs/frontend/app/utils/helpers.ts'\\'') GROUP BY f.path,c.chunk_type ORDER BY f.path,c.chunk_type;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -AtF \"|\" -c \"SELECT source_type,chunk_type,count(*),count(DISTINCT file_id),c