E schemaname = '\\''public'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e%'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT r.relation_type, COUNT(*) AS edge_count, COUNT(r.target_symbol_id) AS resolved_count, COUNT(*) FILTER (WHERE r.target_symbol_id IS NULL) AS unresolved_count FROM aic_symbol_relations r WHERE r.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' GROUP BY r.relation_type ORDER BY r.relation_type;\" -c \"SELECT status, run_type, stats FROM aic_indexing_runs WHERE id = '\\''dbe373a7-2de4-4599-8ea0-14c869ad7626'\\''::uuid AND project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT source.name AS source_symbol, target.name AS target_symbol, r.relation_type, f.path, r.source_line, r.confidence FROM aic_symbol_relations r JOIN aic_symbols source ON source.project_id=r.project_id AND source.id=r.source_symbol_id JOIN aic_symbols target ON target.project_id=r.project_id AND target.id=r.target_symbol_id JOIN aic_files f ON f.project_id=source.project_id AND f.id=source.file_id WHERE r.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND r.relation_type='\\''calls'\\'' ORDER BY r.confidence DESC, f.path, r.source_line LIMIT 10;\"' "],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT root_path FROM aic_projects WHERE id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT f.language, COUNT(DISTINCT f.id) AS files, COUNT(s.id) AS symbols FROM aic_files f LEFT JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id = '\