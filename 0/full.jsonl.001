docs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'') ORDER BY f.path,c.sequence_number;\" -c \"SELECT id,provider,model,dimensions,distance_metric FROM aic_embedding_models WHERE id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -At -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT c.content_hash = encode(digest(convert_to(c.content,'\\''UTF8'\\''),'\\''sha256'\\''),'\\''hex'\\'') FROM aic_chunks c WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_embedding_models (id, provider, model, dimensions, distance_metric, enabled, metadata) VALUES ('\\''75057a8a-8980-43a8-9487-7b0945fd8233'\\''::uuid, '\\''openai'\\'', '\\''text-embedding-3-small'\\'', 1536, '\\''cosine'\\'', TRUE, '\\''{\\\"source\\\":\\\"ai-code-intelligence docs/getting-started.md\\\"}'\\''::jsonb) ON CONFLICT (provider, model) DO UPDATE SET dimensions=EXCLUDED.dimensions, distance_metric=EXCLUDED.distance_metric, enabled=TRUE RETURNING id, provider, model, dimensions;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_projects (id, name, slug, root_path, default_branch, metadata) VALUES ('\\''3c7f07bd-bcb6-4516-908e-bc0fc8eb52cf'\\''::uuid, '\\''Easyfit PL'\\'', '\\''easyfit-pl'\\'', '\\''/home/kamaz/www/easyfit-projects/easyfit-pl.com'\\'', '\