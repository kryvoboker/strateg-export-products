->>'\\''chunking'\\'', '\\''(none)'\\'') AS chunking, count(*) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid GROUP BY source_type, chunk_type, metadata->>'\\''chunking'\\'' ORDER BY source_type, chunk_type, chunking;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_type, file_path, left(content, 600) AS excerpt FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''Yii2 Yii3 migration authentication inventory order product routing'\\'', 8);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT status, finished_at FROM aic_indexing_runs WHERE id = '\\''d099058c-e63c-42a5-8082-6c6080b787fd'\\''::uuid AND project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT status,run_type,started_at,finished_at,stats,metadata FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 2; SELECT indexname,indexdef FROM pg_indexes WHERE tablename='\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%9da19a96-c510-418b-8cbe-52572c2a89fd%'\\''; SELECT indexname,indexdef FROM pg_indexes WHERE tablename='\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%UNIQUE%'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_name, column_name, data_type FROM information_schema.columns WHERE table_schema = '\\''public'\\'' AND table_name IN ('\\''aic_indexing_runs'\\'', '\\''aic_files'\\'') ORDER BY table_name, ordinal_position;\" -c \"SELECT id, status, git_commit, stats, created_at, updated_at FROM aic_indexing_runs WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' ORDER BY created_at DESC LIMIT 3;\" -c \"SELECT s.id, f.path, s.kind, s.name, s.qualified_name, s.start_line, s.end_line, s.parent_symbol_id FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'' ORDER BY f.path,s.start_line LIMIT 25;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_name,column_name,data_type FROM information_schema.columns WHERE table_name IN ('\\''aic_embeddings'\\'', '\\''aic_indexing_runs'\\'') ORDER BY table_name,ordinal_position; SELECT id,provider,model,dimensions FROM aic_embedding_models WHERE model='\\''text-embedding-3-small'\\''; SELECT id,status,started_at,completed_at FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY started_at DESC LIMIT 3;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'', finished_at=NOW(), error_message=NULL, stats=stats || jsonb_build_object(''chunks_retained_with_existing_embeddings'', 524, ''final_project_files'', 390, ''final_project_documents'', 25, ''final_project_chunks'', 621, ''final_project_embeddings'', 621, ''embedding_model'', ''text-embedding-3-small'', ''embedding_dimensions'', 1536, ''embeddings_generated'', 97, ''missing_embeddings'', 0, ''stale_embeddings'', 0, ''symbol_relations'', 0), metadata=metadata || jsonb_build_object(''completed_at'', NOW(), ''embedding_manifest'', ''/home/kamaz/www/hobby/ai-code-intelligence/app/embedding-results/pet-complaints-platform/2026/10/pet-complaints-platform-d099058c-e63c-42a5-8082-6c6080b787fd-manifest.json'', ''hnsw_index_verified'', ''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'', ''relations_populated'', false, ''serena_symbol_cache_refreshed'', false, ''parser_fallback'', ''Tree-sitter Vue root passed; recursive traversal segfaulted; 80-line/12k-character source chunks used'' ) WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND id='\\''d099058c-e63c-42a5-8082-6c6080b787fd'\\''::uuid AND status='\\''running'\\'' RETURNING id, status, finished_at, stats;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'', finished_at=NOW(), stats='\\''{\\\"files\\\":1264,\\\"symbols\\\":4020,\\\"relations\\\":0,\\\"documents\\\":15,\\\"knowledge_items\\\":4,\\\"chunks\\\":4343,\\\"embeddings\\\":4343,\\\"stale_or_missing_embeddings\\\":0,\\\"hnsw_index\\\":true}'\\''::jsonb, metadata=metadata || jsonb_build_object('\\''verification'\\'', '\\''project/model HNSW exists; all chunk hashes match embeddings; dimensions=1536'\\'') WHERE id='\\''7b9088f3-588d-44d5-8f68-4d8d4e00d2ed'\\''::uuid AND project_id='\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid AND status='\\''running'\\'' RETURNING id,status,stats;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug='\\''yii3-office-easyfit'\\'') SELECT (SELECT count(*) FROM aic_files WHERE project_id=(SELECT id FROM p)) AS files, (SELECT count(*) FROM aic_symbols WHERE project_id=(SELECT id FROM p)) AS symbols, (SELECT count(*) FROM aic_documents WHERE project_id=(SELECT id FROM p)) AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id=(SELECT id FROM p) AND status='\\''active'\\'') AS knowledge, (SELECT count(*) FROM aic_chunks WHERE project_id=(SELECT id FROM p)) AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id=(SELECT id FROM p)) AS embeddings, (SELECT status FROM aic_indexing_runs WHERE project_id=(SELECT id FROM p) ORDER BY started_at DESC LIMIT 1) AS latest_run_status;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug='\\''yii3-office-easyfit'\\''), m AS (SELECT id FROM aic_embedding_models WHERE provider='\\''openai'\\'' AND model='\\''text-embedding-3-small'\\'') SELECT (SELECT count(*) FROM aic_files WHERE project_id=(SELECT id FROM p) AND is_deleted=false) AS files, (SELECT count(*) FROM aic_symbols WHERE project_id=(SELECT id FROM p)) AS symbols, (SELECT count(*) FROM aic_symbol_relations WHERE project_id=(SELECT id FROM p)) AS relations, (SELECT count(*) FROM aic_documents WHERE project_id=(SELECT id FROM p)) AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id=(SELECT id FROM p) AND status='\\''active'\\'') AS active_knowledge, (SELECT