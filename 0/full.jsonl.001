f -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT sequence_number, start_line, end_line, left(content, 180) AS content_start FROM aic_chunks WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND file_id = '\\''d0f6680a-5956-4efc-a89b-1ea7505d3c97'\\'' ORDER BY sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT sequence_number,left(search_vector::text,300) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND file_id='\\''d0f6680a-5956-4efc-a89b-1ea7505d3c97'\\'' ORDER BY sequence_number;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT sequence_number,rank,left(content,100) AS match FROM aic_search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid, '\\''categories'\\'', 20) s JOIN aic_chunks c ON c.id=s.chunk_id WHERE s.source_reference='\\''httpdocs/frontend/app/pages/index.vue'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT source_reference, title, left(content, 500) AS excerpt FROM aic_search_chunks_text('\\''9cb2ac9e-7047-4353-812c-35ecbb51289f'\\''::uuid, '\\''OCFilter status_login ocfilter_page'\\'', 5);\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=of