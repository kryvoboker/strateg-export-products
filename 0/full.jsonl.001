FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT count(*) FROM aic_symbol_relations r WHERE r.project_id=p.id) AS symbol_relations, (SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) AS documents, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS active_knowledge, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid) AS model_embeddings FROM aic_projects p WHERE p.id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT dimensions, count(*) AS vectors FROM aic_embeddings WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid GROUP BY dimensions; SELECT count(*) FILTER (WHERE e.id IS NULL) AS missing_embeddings, count(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale_embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid; SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\''; SELECT id, status, stats FROM aic_indexing_runs WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\''::uuid ORDER BY started_at DESC LIMIT 1;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path, sequence_number, left(content, 100) AS match FROM search_chunks_text('\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\