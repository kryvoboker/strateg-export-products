public'\\'' AND table_name IN ('\\''aic_files'\\'', '\\''aic_symbols'\\'', '\\''aic_symbol_relations'\\'', '\\''aic_chunks'\\'', '\\''aic_embeddings'\\'') ORDER BY table_name, ordinal_position;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT (SELECT count(*) FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT is_deleted) AS files, (SELECT count(*) FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status='\\''active'\\'') AS knowledge, (SELECT count(*) FROM aic_symbols WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS symbols, (SELECT count(*) FROM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS relations, (SELECT count(*) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS embeddings, (SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' AND e.source_content_hash=c.content_hash WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL) AS missing_embeddings; SELECT relation_type,count(*) FROM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' GROUP BY relation_type ORDER BY relation_type; SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%hnsw%9da19a96c510%7f16f2a76e0e%\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT (SELECT count(*) FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT is_deleted) AS files, (SELECT count(*) FROM aic_documents WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status='\\''active'\\'') AS knowledge, (SELECT count(*) FROM aic_symbols WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS symbols, (SELECT count(*) FROM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS relations, (SELECT count(*) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS chunks, (SELECT count(*) FROM aic_embeddings WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'') AS embeddings, (SELECT count(*) FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' AND e.source_content_hash=c.content_hash WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL) AS missing_embeddings; SELECT relation_type,count(*) FROM aic_symbol_relations WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' GROUP BY relation_type ORDER BY relation_type;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT f.path, f.content_hash, f.file_type, count(s.id) AS symbols FROM aic_files f LEFT JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path LIKE '\\''httpdocs/frontend/app/%'\\'' GROUP BY f.path,f.content_hash,f.file_type ORDER BY f.path;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT id,kind,title,source_reference,status,left(content,320) FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND status='\\''active'\\'' ORDER BY title;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT s.id,s.kind,s.name,s.qualified_name,s.start_line,s.end_line,s.is_exported,s.content_hash FROM aic_symbols s JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE s.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path='\\''httpdocs/frontend/app/utils/helpers.ts'\\'' ORDER BY start_line;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT n.nspname || '\\''.'\\'' || p.proname || '\\''('   || pg_get_function_identity_arguments(p.oid) || '\\'')'\\'' FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE p.proname ILIKE '\\''%search%\\'' ORDER BY 1;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -Atqc \"SELECT id, slug FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT * FROM search_chunks_text('\\''3c7f07bd-bcb6-4516-908e-bc0fc8eb52cf'\\'', '\\''date_modified easyfit_sitemap'\\'', 10);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT source_reference, title, left(content, 500) AS excerpt FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug = '\\''easyfit-pl'\\''), '\\''Universal Import Pro XML processor google feed export'\\'', 10);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -P pager=off -c \"SELECT source_reference, title, rank FROM aic_search_chunks_text('\\''3c7f07bd-bcb6-4516-908e-bc0fc8eb52cf'\\''::uuid, '\\''date_modified easyfit_sitemap'\\'', 10);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -A -F \"|\" -t -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH project AS (SELECT id FROM aic_projects WHERE slug = '\\''pet-complaints-platform'\\'' AND active = TRUE) SELECT chunk_id, source_reference, title, rank, content FROM aic_search_chunks_text((SELECT id FROM project), '\\''about mission community rules guidelines contact support categories menu authentication registration'\\'', 12);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.name,p.slug, (SELECT count(*) FROM aic_files f WHERE f.project_id=p.id) files, (SELECT count(*) FROM aic_symbols s WHERE s.project_id=p.id) symbols, (SELECT count(*) FROM aic_symbol_relations r WHERE r.project_id=p.id) relations, (SELECT count(*) FROM aic_documents d WHERE d.project_id=p.id) documents, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id=p.id) knowledge, (SELECT count(*) FROM aic_chunks c WHERE c.project_id=p.id) chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id=p.id) embeddings FROM aic_projects p WHERE p.id='\\''71e65548-93bf-4c21-af21-ff7a2797e07d'\\''::uuid; SELECT count(*) AS invalid_embeddings FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''71e65548-93bf-4c21-af21-ff7a2797e07d'\\''::uuid AND (e.dimensions<>1536 OR e.source_content_hash<>c.content_hash); SELECT run_type,status,git_commit,stats FROM aic_indexing_runs WHERE id='\\''1e6d7175-eff3-4755-a4af-327e7aadb2e3'\\''::uuid; SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_71e6554893bf_m_7f16f2a76e0e'\\''; SELECT relation_type, count(*) FROM aic_symbol_relations WHERE project_id='\\''71e65548-93bf-4c21-af21-ff7a2797e07d'\\''::uuid GROUP BY relation_type ORDER BY relation_type;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'', finished_at=NOW(), stats=stats || jsonb_build_object('\\''files'\\'',73,'\\''symbols'\\'',187,'\\''symbol_relations'\\'',1271,'\\''documents'\\'',13,'\\''knowledge_items'\\'',5,'\\''chunks'\\'',313,'\\''embeddings'\\'',313,'\\''embedding_batches'\\'',10,'\\''embedding_model'\\'', '\\''text-embedding-3-small'\\'', '\\''dimensions'\\'',1536,'\\''hnsw_index'\\'', '\\''aic_emb_hnsw_p_71e6554893bf_m_7f16f2a76e0e'\\'', '\\''redacted_files'\\'',2,'\\''embedding_strategy_note'\\'', '\\''two long chunks were segmented and mean-pooled'\\'', '\\''verification_invalid_embeddings'\\'',0) WHERE id='\\''1e6d7175-eff3-4755-a4af-327e7aadb2e3'\\''::uuid AND project_id='\\''71e65548-93bf-4c21-af21-ff7a2797e07d'\\''::uuid AND status='\\''running'\\''; SELECT status, finished_at, stats->>'\\''files'\\'' files,stats->>'\\''embeddings'\\'' embeddings FROM aic_indexing_runs WHERE id='\\''1e6d7175-eff3-4755-a4af-327e7aadb2e3'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"INSERT INTO aic_indexing_runs (id, project_id, run_type, status, git_commit, stats, metadata) VALUES ('\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\'', '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\'', '\\''full'\\'', '\\''running'\\'', '\\''db84b9007461b4753bd03474d38490cf4f13569e'\\'', jsonb_build_object('\\''planned_files'\\'',376,'\\''planned_code_files'\\'',355,'\\''planned_symbols'\\'',1918,'\\''planned_documents'\\'',21,'\\''planned_knowledge_items'\\'',6,'\\''planned_chunks'\\'',916), jsonb_build_object('\\''branch'\\'', '\\''dev/sync-prods'\\'', '\\''parser'\\'', '\\''ast-grep declarations; Tree-sitter batch traversal segfaulted'\\'', '\\''symbol_relations'\\'', '\\''not populated'\\'')) RETURNING id, status;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT COUNT(*) FROM aic_files WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND is_deleted = FALSE) AS files, (SELECT COUNT(*) FROM aic_symbols WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS symbols, (SELECT COUNT(*) FROM aic_documents WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS documents, (SELECT COUNT(*) FROM aic_knowledge_items WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status = '\\''active'\\'') AS active_knowledge, (SELECT COUNT(*) FROM aic_chunks WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS chunks, (SELECT COUNT(*) FROM aic_embeddings WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid) AS embeddings, (SELECT COUNT(*) FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid AND e.source_content_hash <> c.content_hash) AS stale_embeddings; SELECT COUNT(*) AS symbol_relations FROM aic_symbol_relations WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT id,status,stats FROM aic_indexing_runs WHERE id = '\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT COUNT(*) FROM aic_files WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND is_deleted=FALSE) AS files,(SELECT COUNT(*) FROM aic_symbols WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS symbols,(SELECT COUNT(*) FROM aic_documents WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS documents,(SELECT COUNT(*) FROM aic_knowledge_items WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status='\\''active'\\'') AS knowledge,(SELECT COUNT(*) FROM aic_chunks WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS chunks,(SELECT COUNT(*) FROM aic_embeddings WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid) AS embeddings,(SELECT COUNT(*) FROM aic_symbol_relations WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid) AS relations; SELECT COUNT(*) AS stale FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid AND e.source_content_hash<>c.content_hash; SELECT indexname FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_a05ac957939f_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COUNT(*) AS chunks FROM aic_chunks WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS embeddings FROM aic_embeddings WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COUNT(*) AS files FROM aic_files WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND is_deleted = FALSE; SELECT COUNT(*) AS symbols FROM aic_symbols WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS documents FROM aic_documents WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS knowledge FROM aic_knowledge_items WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status = '\\''active'\\''; SELECT COUNT(*) AS chunks FROM aic_chunks WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS embeddings FROM aic_embeddings WHERE project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COUNT(*) AS fts_search_results FROM aic_search_chunks_text('\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid,'\\''product export'\\'',5); SELECT COUNT(*) AS exact_vector_search_results FROM aic_search_chunks_vector_exact('\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid,'\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid,(SELECT embedding FROM aic_embeddings WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1),5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT COUNT(*) AS hnsw_search_results FROM aic_search_chunks_vector_hnsw('\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid,'\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid,(SELECT embedding FROM aic_embeddings WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid LIMIT 1),5); SELECT id,status,finished_at,stats FROM aic_indexing_runs WHERE id='\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) FILTER (WHERE kind='\\''method'\\'' AND qualified_name IS NOT NULL) AS misleading_method_fqns FROM aic_symbols WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT indexname, indexdef FROM pg_indexes WHERE schemaname = current_schema() AND indexname = '\\''aic_emb_hnsw_p_a05ac957939f_m_7f16f2a76e0e'\\''; SELECT COUNT(*) AS embeddings, COUNT(*) FILTER (WHERE dimensions <> 1536) AS wrong_dimensions, COUNT(*) FILTER (WHERE e.source_content_hash <> c.content_hash) AS stale FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid; SELECT COUNT(*) AS unmatched_chunks FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id = '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid WHERE c.project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND e.id IS NULL; SELECT COUNT(*) AS persisted_result_batches FROM aic_indexing_runs r, jsonb_array_elements(r.metadata->'embedding_batches') AS batch WHERE r.id = '\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT table_schema,table_name FROM information_schema.views WHERE table_name ILIKE '\\''%retrieval%'\\'' OR table_name ILIKE '\\''%chunk%'\\'' ORDER BY table_schema,table_name; SELECT to_regclass('\\''v_retrieval_chunks'\\'') AS resolved_view; SELECT id,status,finished_at,stats FROM aic_indexing_runs WHERE id='\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid; SELECT COUNT(*) AS method_symbols_with_fqn FROM aic_symbols WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND kind='\\''method'\\'' AND qualified_name IS NOT NULL;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET stats = jsonb_build_object('\\''planned_files'\\'',376,'\\''planned_code_files'\\'',355,'\\''planned_symbols'\\'',1918,'\\''planned_documents'\\'',21,'\\''planned_knowledge_items'\\'',6,'\\''planned_chunks'\\'',1028), metadata = metadata || jsonb_build_object('\\''embedding_script'\\'', '\\''/app/embedding.js'\\'', '\\''chunk_limit_chars'\\'',4000) WHERE id = '\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id = '\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status = '\\''running'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_symbols SET qualified_name = NULL WHERE project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND kind='\\''method'\\''; UPDATE aic_indexing_runs SET status='\\''completed'\\'', finished_at=NOW(), stats=jsonb_build_object('\\''files'\\'',355,'\\''symbols'\\'',1918,'\\''symbol_relations'\\'',0,'\\''documents'\\'',21,'\\''active_knowledge_items'\\'',6,'\\''chunks'\\'',1028,'\\''embeddings'\\'',1028,'\\''stale_embeddings'\\'',0,'\\''embedding_dimensions'\\'',1536,'\\''embedding_batches'\\'',65,'\\''hnsw_index'\\'', '\\''aic_emb_hnsw_p_a05ac957939f_m_7f16f2a76e0e'\\''), metadata=metadata || jsonb_build_object('\\''embedding_script'\\'', '\\''/app/embedding.js'\\'', '\\''embedding_model'\\'', '\\''text-embedding-3-small'\\'', '\\''embedding_results_path'\\'', '\\''/home/kamaz/www/hobby/ai-code-intelligence/app/embedding-results/strateg-export-products/2026/10/'\\'', '\\''manifest_path'\\'', '\\''manifest.json'\\'', '\\''parser_fallback'\\'', '\\''ast-grep declarations; Tree-sitter batch traversal segfaulted'\\'', '\\''symbol_relations_populated'\\'',false,'\\''unindexed_stale_ai_guide'\\'', '\\''docs/ai-code-intelligence.md excluded because its old project-index counts and root path were stale'\\'', '\\''limitations'\\'', jsonb_build_array('\\''No symbol relations were extracted'\\'', '\\''Method symbol qualified names intentionally left NULL because containing-class names were not reconstructed'\\'', '\\''PostgreSQL FTS ignores individual words longer than 2047 characters'\\'')) WHERE id='\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status='\\''running'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -c \"SELECT aic_create_project_embedding_hnsw_index('\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid, '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"COPY (SELECT f.path,s.id::text,s.kind,s.name,COALESCE(s.qualified_name,''''),COALESCE(s.signature,''''),COALESCE(s.parent_symbol_id::text,''''),COALESCE(s.start_line,0),COALESCE(s.end_line,0) FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND p.active=TRUE AND f.is_deleted=FALSE ORDER BY f.path,s.start_line,s.id) TO STDOUT WITH (FORMAT csv, HEADER true);\"' > /tmp/office-easyfit-symbols.csv"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT COUNT(*) FROM aic_files WHERE project_id=p.id AND is_deleted=FALSE) AS files,(SELECT COUNT(*) FROM aic_symbols WHERE project_id=p.id) AS symbols,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''code'\\'') AS code_chunks,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''document'\\'') AS document_chunks,(SELECT COUNT(*) FROM aic_chunks WHERE project_id=p.id AND source_type='\\''knowledge'\\'') AS knowledge_chunks,(SELECT COUNT(*) FROM aic_embeddings WHERE project_id=p.id) AS embeddings,(SELECT COUNT(*) FROM aic_knowledge_items WHERE project_id=p.id AND status='\\''active'\\'') AS active_knowledge FROM aic_projects p WHERE p.slug='\\''office-easyfit'\\'';\" -c \"SELECT s.kind,COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT COUNT(*) AS stale_vectors FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id JOIN aic_projects p ON p.id=e.project_id WHERE p.slug='\\''office-easyfit'\\'' AND e.source_content_hash<>c.content_hash;\" -c \"SELECT f.path,f.content_hash,f.size_bytes FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''.docker/dev/docker-compose.yml'\\'','\\''.docker/dev/nginx/nginx.conf'\\'') ORDER BY f.path;\" -c \"SELECT id,status,stats FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') AND id='\\''d91cdd1a-ac7b-4031-9b09-1af10edb466c'\\'';\" -c \"SELECT COUNT(*) AS hnsw_indexes FROM pg_indexes WHERE schemaname=current_schema() AND indexname='\\''aic_emb_hnsw_p_7f2841b6c020_m_7f16f2a76e0e'\\'';\" -c \"SELECT source_reference,title FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\''),'\\''supplier URL rendering output safety'\\'',5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT * FROM aic_search_chunks_text('\\''09dfc1e0-d429-4ce4-b2cf-e5feb6805a32'\\''::uuid, '\\''Yii2 SiteController login authentication captcha commands yii3 bootstrap'\\'', 8);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.id,f.path,f.content_hash FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''.docker/dev/docker-compose.yml'\\'','\\''.docker/dev/nginx/nginx.conf'\\'') ORDER BY f.path;\" -c \"SELECT id,model_name,dimensions FROM aic_embedding_models WHERE model_name='\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.language,f.file_type,COUNT(*) FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.is_deleted=FALSE GROUP BY f.language,f.file_type ORDER BY f.language,f.file_type;\" -c \"SELECT path,language,file_type FROM aic_projects p JOIN aic_files f ON f.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND f.is_deleted=FALSE AND language='\\''php'\\'' ORDER BY path LIMIT 8;\" -c \"SELECT s.kind,COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id JOIN aic_files f ON f.project_id=s.project_id AND f.id=s.file_id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.size_bytes, f.indexed_at, COUNT(c.id) AS chunks, COUNT(e.id) AS embeddings FROM aic_projects p JOIN aic_files f ON f.project_id=p.id LEFT JOIN aic_chunks c ON c.project_id=p.id AND c.file_id=f.id AND c.source_type='\\''code'\\'' LEFT JOIN aic_embeddings e ON e.project_id=p.id AND e.chunk_id=c.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path IN ('\\''\\.docker/dev/docker-compose.yml'\\'','\\''\\.docker/dev/nginx/nginx.conf'\\'') GROUP BY f.path,f.content_hash,f.size_bytes,f.indexed_at ORDER BY f.path;\" -c \"SELECT s.kind, COUNT(*) FROM aic_projects p JOIN aic_symbols s ON s.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' GROUP BY s.kind ORDER BY s.kind;\" -c \"SELECT d.path, d.title FROM aic_projects p JOIN aic_documents d ON d.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' ORDER BY d.path;\" -c \"SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname LIKE '\\''aic_emb_hnsw_p_7f2841b6c020_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path, f.content_hash, f.size_bytes, f.indexed_at, c.id AS chunk_id, c.sequence_number, c.start_line, c.end_line, c.content_hash AS chunk_hash, length(c.content) AS chars, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id=p.id AND e.chunk_id=c.id) AS vector_count FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_chunks c ON c.project_id=p.id AND c.file_id=f.id AND c.source_type='\\''code'\\'' WHERE p.slug='\\''office-easyfit'\\'' AND f.path LIKE '\\''\\.docker/dev/%'\\'' ORDER BY f.path,c.sequence_number;\" -c \"SELECT COUNT(*) AS potential_supplier_knowledge FROM aic_projects p JOIN aic_knowledge_items k ON k.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' AND k.status='\\''active'\\'' AND (k.title ILIKE '\\''%supplier%'\\'' OR k.content ILIKE '\\''%supplier url%'\\'');\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.id,s.kind,s.name,s.qualified_name,s.parent_symbol_id,s.start_line FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path='\\''httpdocs/models/Product.php'\\'' AND s.kind='\\''method'\\'' ORDER BY s.start_line LIMIT 25;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.id,s.kind,s.name,s.qualified_name,s.parent_symbol_id,s.start_line,s.end_line FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND s.kind IN ('\\''function'\\'','\\''class'\\'') AND f.path IN ('\\''httpdocs/controllers/ProductController.php'\\'','\\''httpdocs/globals/pl/controllers/ProductController.php'\\'','\\''httpdocs/models/Product.php'\\'') ORDER BY f.path,s.start_line LIMIT 50;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.id,s.kind,s.name,s.qualified_name,s.parent_symbol_id,s.start_line,s.end_line,s.signature FROM aic_projects p JOIN aic_files f ON f.project_id=p.id JOIN aic_symbols s ON s.project_id=f.project_id AND s.file_id=f.id WHERE p.slug='\\''office-easyfit'\\'' AND f.path='\\''httpdocs/controllers/ProductController.php'\\'' ORDER BY s.start_line,s.end_line LIMIT 35;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id, slug, root_path FROM aic_projects WHERE slug = '\\''yii3-office-easyfit'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT id,provider,model,dimensions FROM aic_embedding_models WHERE model='\\''text-embedding-3-small'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.id,k.title,k.status,k.updated_at FROM aic_projects p JOIN aic_knowledge_items k ON k.project_id=p.id WHERE p.slug='\\''office-easyfit'\\'' ORDER BY k.title;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.title,k.status,k.source_reference,c.id AS chunk_id,length(c.content) AS chars,c.content_hash,e.dimensions,e.source_content_hash=c.content_hash AS vector_matches FROM aic_projects p JOIN aic_knowledge_items k ON k.project_id=p.id JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE p.slug='\\''office-easyfit'\\'' AND k.id='\\''534b2162-a0c7-4f93-b051-af40d063649e'\\'';\" -c \"SELECT source_reference,title FROM aic_search_chunks_text((SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\''),'\\''supplier'\\'',5);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, p.name, p.active, (SELECT COUNT(*) FROM aic_files f WHERE f.project_id=p.id AND f.is_deleted=FALSE) AS files, (SELECT COUNT(*) FROM aic_symbols s WHERE s.project_id=p.id) AS symbols, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''code'\\'') AS code_chunks, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''document'\\'') AS document_chunks, (SELECT COUNT(*) FROM aic_chunks c WHERE c.project_id=p.id AND c.source_type='\\''knowledge'\\'') AS knowledge_chunks, (SELECT COUNT(*) FROM aic_embeddings e WHERE e.project_id=p.id) AS embeddings, (SELECT COUNT(*) FROM aic_knowledge_items k WHERE k.project_id=p.id AND k.status='\\''active'\\'') AS active_knowledge FROM aic_projects p WHERE p.slug='\\''office-easyfit'\\'';\" -c \"SELECT COUNT(*) AS stale FROM aic_projects p JOIN aic_embeddings e ON e.project_id=p.id JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE p.slug='\\''office-easyfit'\\'' AND e.source_content_hash <> c.content_hash;\" -c \"SELECT id, run_type, status, started_at, stats FROM aic_indexing_runs WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') ORDER BY started_at DESC LIMIT 8;\" -c \"SELECT kind, title, source_reference, status, confidence FROM aic_knowledge_items WHERE project_id=(SELECT id FROM aic_projects WHERE slug='\\''office-easyfit'\\'') AND status='\\''active'\\'' ORDER BY created_at DESC LIMIT 20;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id,p.slug,(SELECT COUNT(*) FROM aic_files f WHERE f.project_id=p.id AND f.is_deleted=FALSE) files,(SELECT COUNT(*) FROM aic_symbols s WHERE s.project_id=p.id) symbols,(SELECT COUNT(*) FROM aic_symbol_relations r WHERE r.project_id=p.id) relations,(SELECT COUNT(*) FROM aic_indexing_runs ir WHERE ir.project