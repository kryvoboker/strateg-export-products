cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''symbols'\\'', count(*) FROM aic_symbols WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''chunks'\\'', count(*) FROM aic_chunks WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''embeddings'\\'', count(*) FROM aic_embeddings WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''docs'\\'', count(*) FROM aic_documents WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '\\''knowledge'\\'', count(*) FROM aic_knowledge_items WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'';\" -c \"SELECT path, content_hash, is_deleted, indexed_at FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path IN ('\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'', '\\''httpdocs/frontend/i18n/locales/en.json'\\'', '\\''httpdocs/frontend/i18n/locales/uk.json'\\'') ORDER BY path;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT k.id,k.kind,k.title,k.status,k.confidence,k.source_reference,count(c.id) AS linked_chunks,count(e.id) AS linked_embeddings FROM aic_knowledge_items k LEFT JOIN aic_chunks c ON c.project_id=k.project_id AND c.knowledge_item_id=k.id LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id WHERE k.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND k.title='\\''Complaint list frontend flow and filter state'\\'' GROUP BY k.id; SELECT c.source_type,count(*) AS chunks,count(e.id) AS embeddings FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (f.path LIKE '\\''httpdocs/frontend/%Complaint%'\\'' OR c.knowledge_item_id IN (SELECT id FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\'')) GROUP BY c.source_type ORDER BY c.source_type;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT p.id, p.slug, m.id AS model_id, m.model, m.dimensions, (SELECT count(*) FROM aic_files f WHERE f.project_id = p.id AND f.is_deleted = FALSE) AS files, (SELECT count(*) FROM aic_chunks c WHERE c.project_id = p.id) AS chunks, (SELECT count(*) FROM aic_embeddings e WHERE e.project_id = p.id AND e.embedding_model_id = m.id) AS embeddings, (SELECT count(*) FROM aic_knowledge_items k WHERE k.project_id = p.id) AS knowledge FROM aic_projects p LEFT JOIN aic_embedding_models m ON m.provider = '\\''openai'\\'' AND m.model = '\\''text-embedding-3-small'\\'' WHERE p.slug = '\\''pet-complaints-platform'\\'' AND p.active = TRUE;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT path,id,content_hash FROM aic_files WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND path = ANY(ARRAY['\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'','\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'','\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'','\\''httpdocs/frontend/i18n/locales/en.json'\\'','\\''httpdocs/frontend/i18n/locales/uk.json'\\'']::text[]) ORDER BY path; SELECT r.status,r.finished_at,r.stats FROM aic_indexing_runs r WHERE r.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND r.id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\''; SELECT count(*) AS missing FROM aic_chunks c LEFT JOIN aic_embeddings e ON e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\'' WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND e.id IS NULL; SELECT count(*) AS stale FROM aic_embeddings e JOIN aic_chunks c ON c.project_id=e.project_id AND c.id=e.chunk_id WHERE e.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND (e.source_content_hash <> c.content_hash OR e.dimensions <> 1536); SELECT id,title,status FROM aic_knowledge_items WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND title='\\''Complaint list frontend flow and filter state'\\''; SELECT indexname FROM pg_indexes WHERE schemaname='\\''public'\\'' AND tablename='\\''aic_embeddings'\\'' AND indexname='\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT r.id, r.status, r.started_at, r.completed_at, r.stats FROM aic_indexing_runs r WHERE r.project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY r.started_at DESC LIMIT 8;\" -c \"SELECT '''files''' AS table_name, count(*) FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''symbols''', count(*) FROM aic_symbols WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''chunks''', count(*) FROM aic_chunks WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''embeddings''', count(*) FROM aic_embeddings WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' UNION ALL SELECT '''d