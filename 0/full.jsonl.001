ymbol_relations WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'') AS strateg_ua_relations,(SELECT count(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'') AS strateg_ua_symbols; SELECT p.slug,count(r.id) AS relations FROM aic_projects p LEFT JOIN aic_symbol_relations r ON r.project_id=p.id GROUP BY p.slug HAVING count(r.id)>0 ORDER BY relations DESC LIMIT 10;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.language,s.kind,count(*) FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY f.language,s.kind ORDER BY f.language,s.kind;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND (s.name IN ('\\''BaseService'\\'','\\''HttpException'\\'','\\''ToolInterface'\\'','\\''ProductSearchProviderInterface'\\'') OR s.qualified_name ILIKE '\\''%BaseService'\\'') ORDER BY s.name LIMIT 25;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT f.path,s.kind,s.name,s.qualified_name,s.start_line,s.start_column,s.end_line,s.end_column FROM aic_symbols s JOIN aic_files f ON f.id=s.file_id WHERE s.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND s.kind IN ('\\''class'\\'','\\''method'\\'','\\''function'\\'','\\''interface'\\'','\\''trait'\\'') ORDER BY f.path,s.start_line LIMIT 12;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT kind,count(*) AS symbols FROM aic_symbols GROUP BY kind ORDER BY symbols DESC; SELECT p.slug,s.kind,count(*) AS symbols FROM aic_symbols s JOIN aic_projects p ON p.id=s.project_id WHERE s.kind IN ('\\''module'\\'','\\''file'\\'','\\''namespace'\\'') GROUP BY p.slug,s.kind ORDER BY p.slug,s.kind;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT language,COUNT(*) FROM aic_files WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND is_deleted=FALSE GROUP BY language ORDER BY COUNT(*) DESC; SELECT kind,COUNT(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY kind ORDER BY COUNT(*) DESC; SELECT run_type,status,COUNT(*) FROM aic_indexing_runs WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY run_type,status ORDER BY run_type,status;\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE conname = '\\''indexing_runs_type_valid'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT relation_type, count(*) AS total, count(target_symbol_id) AS resolved, count(*) FILTER (WHERE target_symbol_id IS NULL) AS unresolved FROM aic_symbol_relations WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' GROUP BY relation_type ORDER BY relation_type; SELECT count(*) AS total_relations, count(*) FILTER (WHERE evidence IS NULL OR evidence = '\\''{}'\\''::jsonb) AS missing_evidence, count(*) FILTER (WHERE source_line < 1) AS invalid_lines, count(*) FILTER (WHERE target_symbol_id IS NOT NULL AND source.project_id <> target.project_id) AS cross_project_targets FROM aic_symbol_relations r JOIN aic_symbols source ON source.id=r.source_symbol_id LEFT JOIN aic_symbols target ON target.id=r.target_symbol_id WHERE r.project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\''; SELECT kind,count(*) FROM aic_symbols WHERE project_id='\\''9efb77e2-1469-4c40-b52b-9f4e4c680023'\\'' AND kind='\\''module'\\'' GROUP BY kind; SELECT id,run_type,status,stats FROM aic_indexing_runs WHERE id='\\''afe788a3-466d-4c16-b81e-4d1c34f4a109'\\'';\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,data_type FROM information_schema.columns WHERE table_name='\\''aic_indexing_runs'\\'' ORDER BY ordinal_position\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT column_name,data_type,udt_name,is_nullable FROM information_schema.columns WHERE table_name = '\\''aic_embeddings'\\'' ORDER BY ordinal_position\"'"],["/bin/bash","-lc","docker compose -f /home/kamaz/www/hobby/ai-code-intelligence/.docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -X -q -v ON_ERROR_STOP=1 -U \"$POSTGRES_SIMPLE_USER\" -d \"