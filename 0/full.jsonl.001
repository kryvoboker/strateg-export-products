pdated\":0,\"knowledge_items_added\":1,\"deleted_chunks\":10,\"code_chunks_added\":14,\"knowledge_chunks_added\":1,\"embeddings_to_generate\":15,\"embeddings_generated\":15,\"chunks_retained_with_existing_embeddings\":611,\"stale_embeddings\":0,\"missing_embeddings\":0,\"embedding_model\":\"text-embedding-3-small\",\"embedding_dimensions\":1536,\"symbol_relations\":0,\"hnsw_index\":\"aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e\",\"final_project_files\":391,\"final_project_symbols\":799,\"final_project_documents\":25,\"active_knowledge_items\":12,\"final_project_chunks\":626,\"final_project_embeddings\":626}'\\''::jsonb WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\'' AND status='\\''running'\\'' RETURNING id,status,finished_at,stats;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"UPDATE aic_indexing_runs SET status='\\''completed'\\'',finished_at=NOW(),stats=jsonb_build_object('\\''files_added'\\'',1,'\\''files_updated'\\'',4,'\\''documents_added'\\'',0,'\\''documents_updated'\\'',0,'\\''knowledge_items_added'\\'',1,'\\''deleted_chunks'\\'',10,'\\''code_chunks_added'\\'',14,'\\''knowledge_chunks_added'\\'',1,'\\''embeddings_to_generate'\\'',15,'\\''embeddings_generated'\\'',15,'\\''chunks_retained_with_existing_embeddings'\\'',611,'\\''stale_embeddings'\\'',0,'\\''missing_embeddings'\\'',0,'\\''embedding_model'\\'','\\''text-embedding-3-small'\\'','\\''embedding_dimensions'\\'',1536,'\\''symbol_relations'\\'',0,'\\''hnsw_index'\\'','\\''aic_emb_hnsw_p_9da19a96c510_m_7f16f2a76e0e'\\'','\\''final_project_files'\\'',391,'\\''final_project_symbols'\\'',799,'\\''final_project_documents'\\'',25,'\\''active_knowledge_items'\\'',12,'\\''final_project_chunks'\\'',626,'\\''final_project_embeddings'\\'',626) WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND id='\\''f1776bec-9c70-4d5f-80f7-65d3aa669bab'\\'' AND status='\\''running'\\'' RETURNING id,status,finished_at,stats;\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') SELECT '\\''file_rows'\\'' AS metric, count(*)::text AS value FROM aic_files WHERE project_id=(SELECT id FROM p) UNION ALL SELECT '\\''nondeleted_files'\\'', count(*)::text FROM aic_files WHERE project_id=(SELECT id FROM p) AND is_deleted=false UNION ALL SELECT '\\''deleted_files'\\'', count(*)::text FROM aic_files WHERE project_id=(SELECT id FROM p) AND is_deleted=true UNION ALL SELECT '\\''chunks_code'\\'', count(*)::text FROM aic_chunks WHERE project_id=(SELECT id FROM p) AND source_type='\\''code'\\'' UNION ALL SELECT '\\''chunks_document'\\'', count(*)::text FROM aic_chunks WHERE project_id=(SELECT id FROM p) AND source_type='\\''document'\\'' UNION ALL SELECT '\\''chunks_knowledge'\\'', count(*)::text FROM aic_chunks WHERE project_id=(SELECT id FROM p) AND source_type='\\''knowledge'\\'' UNION ALL SELECT '\\''knowledge_status'\\'', status||'\\'': '\\''||count(*) FROM aic_knowledge_items WHERE project_id=(SELECT id FROM p) GROUP BY status UNION ALL SELECT '\\''unembedded_chunks'\\'', count(*)::text FROM aic_chunks c WHERE c.project_id=(SELECT id FROM p) AND NOT EXISTS (SELECT 1 FROM aic_embeddings e WHERE e.project_id=c.project_id AND e.chunk_id=c.id AND e.embedding_model_id='\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid);\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"WITH p AS (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') SELECT '\\''files'\\'' AS entity, count(*) FROM aic_files WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''symbols'\\'', count(*) FROM aic_symbols WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''relations'\\'', count(*) FROM aic_symbol_relations WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''documents'\\'', count(*) FROM aic_documents WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''knowledge_items'\\'', count(*) FROM aic_knowledge_items WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''chunks'\\'', count(*) FROM aic_chunks WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''embeddings'\\'', count(*) FROM aic_embeddings WHERE project_id = (SELECT id FROM p) UNION ALL SELECT '\\''runs'\\'', count(*) FROM aic_indexing_runs WHERE project_id = (SELECT id FROM p); SELECT m.id, m.provider, m.model, m.dimensions, m.enabled, count(e.id) AS embedding_count FROM aic_embedding_models m LEFT JOIN aic_embeddings e ON e.embedding_model_id = m.id AND e.project_id = (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') GROUP BY m.id ORDER BY m.model; SELECT id, run_type, status, git_commit, started_at, finished_at, stats, error_message FROM aic_indexing_runs WHERE project_id = (SELECT id FROM aic_projects WHERE slug = '\\''office-easyfit'\\'') ORDER BY started_at DESC LIMIT 10; SELECT indexname, indexdef FROM pg_indexes WHERE schemaname = current_schema() AND tablename = '\\''aic_embeddings'\\'' AND indexdef ILIKE '\\''%7f2841b6-c020-46ef-9597-72ac54812b45%'\\'';\"'"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\"' < /tmp/easyfit-index/easyfit-pl-index.sql"],["/bin/bash","-lc","docker compose -f .docker/dev/docker-compose.yml exec -T ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES