tions'\\'',0,'\\''documents'\\'',21,'\\''active_knowledge_items'\\'',6,'\\''chunks'\\'',1028,'\\''embeddings'\\'',1028,'\\''stale_embeddings'\\'',0,'\\''embedding_dimensions'\\'',1536,'\\''embedding_batches'\\'',65,'\\''hnsw_index'\\'', '\\''aic_emb_hnsw_p_a05ac957939f_m_7f16f2a76e0e'\\''), metadata=metadata || jsonb_build_object('\\''embedding_script'\\'', '\\''/app/embedding.js'\\'', '\\''embedding_model'\\'', '\\''text-embedding-3-small'\\'', '\\''embedding_results_path'\\'', '\\''/home/kamaz/www/hobby/ai-code-intelligence/app/embedding-results/strateg-export-products/2026/10/'\\'', '\\''manifest_path'\\'', '\\''manifest.json'\\'', '\\''parser_fallback'\\'', '\\''ast-grep declarations; Tree-sitter batch traversal segfaulted'\\'', '\\''symbol_relations_populated'\\'',false,'\\''unindexed_stale_ai_guide'\\'', '\\''docs/ai-code-intelligence.md excluded because its old project-index counts and root path were stale'\\'', '\\''limitations'\\'', jsonb_build_array('\\''No symbol relations were extracted'\\'', '\\''Method symbol qualified names intentionally left NULL because containing-class names were not reconstructed'\\'', '\\''PostgreSQL FTS ignores individual words longer than 2047 characters'\\'')) WHERE id='\\''50c02ee0-c2d6-40a9-bfac-59e47bcd1c6e'\\''::uuid AND project_id='\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid AND status='\\''running'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -q -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -c \"SELECT aic_create_project_embedding_hnsw_index('\\''a05ac957-939f-4a36-bffb-d6bbf13db11c'\\''::uuid, '\\''7f16f2a7-6e0e-4fd8-9dd6-31f981768774'\\''::uuid);\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -v ON_ERROR_STOP=1 -P pager=off -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -c \"SELECT (SELECT COUNT(*) FROM aic_files WHERE project_id=p.id AND is_deleted=FALSE) AS files,(SELECT COUNT(*) FROM a