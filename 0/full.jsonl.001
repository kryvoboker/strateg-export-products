fb77e2-1469-4c40-b52b-9f4e4c680023') AS files, (SELECT count(*) FROM aic_symbols WHERE project_id='9efb77e2-1469-4c40-b52b-9f4e4c680023') AS symbols, (SELECT count(*) FROM aic_documents WHERE project_id='9efb77e2-1469-4c40-b52b-9f4e4c680023') AS documents, (SELECT count(*) FROM aic_knowledge_items WHERE project_id='9efb77e2-1469-4c40-b52b-9f4e4c680023') AS knowledge, (SELECT count(*) FROM aic_chunks WHERE project_id='9efb77e2-1469-4c40-b52b-9f4e4c680023') AS chunks, (SELECT count(*) FROM aic_embeddings e JOIN aic_chunks c ON c.id=e.chunk_id WHERE c.project_id='9efb77e2-1469-4c40-b52b-9f4e4c680023') AS embeddings; SELECT id,provider,model,dimensions,distance_metric,enabled FROM aic_embedding_models ORDER BY provider,model; SELECT id,run_type,status,started_at,finished_at,stats,error_message FROM aic_indexing_runs WHERE project_id='9efb77e2-1469-4c40-b52b-9f4e4c680023' ORDER BY started_at DESC; SELECT indexname,indexdef FROM pg_indexes WHERE schemaname='public' AND tablename='aic_embeddings' AND indexname LIKE 'aic_emb_hnsw_p_%';\" "],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc \"psql -X -A -t -v ON_ERROR_STOP=1 -U \\\"\\$POSTGRES_SIMPLE_USER\\\" -d \\\"\\$POSTGRES_DB\\\" -c \\\"SELECT id, slug FROM aic_projects WHERE slug = 'yii3-office-easyfit' AND active = TRUE\\\"\""],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -Atqc \"SELECT id, slug FROM aic_projects WHERE slug = '\\''easyfit-pl'\\'';\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -AtF \"|\" -c \"SELECT '\\''F'\\'', f.path, f.id, f.file_type, COALESCE(f.language,'\\'''\\''), COALESCE(f.content_hash,'\\'''\\'') FROM aic_files f WHERE f.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT f.is_deleted UNION ALL SELECT '\\''D'\\'', d.path, d.id, d.document_type, d.title, COALESCE(d.content_hash,'\\'''\\'') FROM aic_documents d WHERE d.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' ORDER BY 1,2;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -AtF \"|\" -c \"SELECT f.path,c.chunk_type,count(*) FROM aic_chunks c JOIN aic_files f ON f.project_id=c.project_id AND f.id=c.file_id WHERE c.project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND f.path IN ('\\''httpdocs/frontend/app/assets/css/main.css'\\'', '\\''httpdocs/frontend/app/components/CommentSection.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintCard.vue'\\'', '\\''httpdocs/frontend/app/components/ComplaintFiltersForm.vue'\\'', '\\''httpdocs/frontend/app/components/PetCard.vue'\\'', '\\''httpdocs/frontend/app/components/PetFollowButton.vue'\\'', '\\''httpdocs/frontend/app/components/ReactionBar.vue'\\'', '\\''httpdocs/frontend/app/components/ShareButton.vue'\\'', '\\''httpdocs/frontend/app/components/VerdictPanel.vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/[slug].vue'\\'', '\\''httpdocs/frontend/app/pages/complaints/index.vue'\\'', '\\''httpdocs/frontend/app/pages/index.vue'\\'', '\\''httpdocs/frontend/app/utils/helpers.ts'\\'') GROUP BY f.path,c.chunk_type ORDER BY f.path,c.chunk_type;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -AtF \"|\" -c \"SELECT source_type,chunk_type,count(*),count(DISTINCT file_id),count(DISTINCT document_id),count(DISTINCT knowledge_item_id) FROM aic_chunks WHERE project_id='\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' GROUP BY source_type,chunk_type ORDER BY 1,2;\"'"],["/bin/bash","-lc","docker exec ai-code-intelligence-postgres-postgresql sh -lc 'psql -U \"$POSTGRES_SIMPLE_USER\" -d \"$POSTGRES_DB\" -Atc \"SELECT (SELECT count(*) FROM aic_files WHERE project_id = '\\''9da19a96-c510-418b-8cbe-52572c2a89fd'\\'' AND NOT is_deleted), (SELECT count(*) FROM aic_symbols WHERE project_id = '\\''9da19a